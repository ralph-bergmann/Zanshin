  "textMenuPaste": "Paste",
  "@textMenuPaste": {"description": "Text-field context menu item that pastes the clipboard."},
  "textMenuSelectAll": "Select all",
  "@textMenuSelectAll": {"description": "Text-field context menu item that selects the whole text."},
  "searchPlaceholder": "Search",
