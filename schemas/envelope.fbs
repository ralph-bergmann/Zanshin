// SPDX-License-Identifier: MIT
//
// Core FFI envelope schema — the carrier for every fallible composite FFI call.
//
// Transport rule (ADR-0001):
//   fixed scalar              → plain C value
//   lone string               → *mut c_char (CString, freed by zanshin_string_free)
//   composite (table/list/…)  → FlatBuffers buffer (freed by zanshin_buffer_free)
//
// Every fallible extern "C" function that returns composite data returns an
// Envelope.  Infallible hot-path functions (zanshin_ffi_version,
// zanshin_string_free, zanshin_buffer_free) return plain types — no envelope.
//
// WIP: no in-wire schema_version field.  Breaking changes are in-place edits;
// callers update in the same PR.  Versioning discipline lands at 1.0.

namespace zanshin.ffi;

// ── Error ─────────────────────────────────────────────────────────────────────

/// Error detail carried when Envelope.ok == false.
/// error.code follows the AR-P-4 dotted-lowercase taxonomy:
///   <domain>.<reason>  (e.g. "jj.repo_not_found", "internal.panic")
/// Registry: docs/rust-error-codes.md.
/// Never put user data (paths, IDs) in code — those go in context.
table FfiError {
  code: string;
  context: string;
}

// ── Request-only tables ─────────────────────────────────────────────────────────
// NOT part of the Payload union below (that union is response-only). Dart builds
// and owns/frees these buffers itself; Rust only borrows them for the call
// (ADR-0001 composite-input pattern, Story 6-5).
//
// Field order IS the wire contract here too — a table's field ids are assigned by
// declaration order and are baked into BOTH committed codegen sides. `kind` is
// ALWAYS field 0 of a request table and a NEW field is APPENDED after the existing
// ones; any other change to a request table's field order is an in-place WIP edit
// (no `id:` attribute, no `_v2` table, no in-wire schema version) that MUST
// regenerate BOTH committed codegen sides in the SAME commit — a Dart writer and a
// Rust reader built from different field orders would silently mis-read every field
// after the first change.
//
// A UNION field costs TWO vtable slots, not one: flatc expands `x: SomeUnion` into a
// hidden `x_type` discriminant byte followed by the value offset, so it shifts every
// LATER field's id by two. Changing a scalar/string field into a union is therefore an
// in-place WIP edit under exactly the rule above, and the member tables plus the union
// itself must be declared BEFORE the table that uses them.

/// Which `extern "C"` wrapper a request buffer was built FOR.
///
/// Every request table carries this as field 0, and every wrapper refuses a buffer whose
/// `kind` is not its own — before the handle lookup and before any other field is read.
/// Without it a buffer built for one verb VERIFIES as another verb's table — nothing in the
/// `FlatBuffers` layer tells them apart — so a `BookmarkCreateRequest` fed to
/// `zanshin_bookmark_delete` would silently glob-delete names the caller meant literally.
///
/// The tag is per-WRAPPER, not per-table: `ChangeIdList` is read by TWO wrappers, as
/// `zanshin_new_change`'s `parents` and as `zanshin_abandon`'s `change_ids`, so it carries the
/// two kinds `NewChange` and `Abandon` — mis-routing there abandons the commits the caller
/// named as parents. For the other 16 tables the variant name plus `Request` IS the table name.
///
/// `Unspecified = 0` is `FlatBuffers`' default for an ABSENT field, so a buffer built by a
/// producer that never sets `kind` is byte-identical to a pre-tag buffer, decodes as
/// `Unspecified`, and is ALWAYS refused. Nothing untagged is ever silently accepted.
///
/// Member order IS the wire value (no explicit numbers) — APPEND only, never reorder or remove:
/// a reordered variant re-tags every buffer the other side already builds.
enum RequestKind : ubyte {
  Unspecified,
  Restore,
  Absorb,
  NewChange,
  Abandon,
  FileList,
  FileShow,
  FileAnnotate,
  FileSearch,
  GitRemoteAdd,
  GitRemoteSetUrl,
  Show,
  Evolog,
  Interdiff,
  WorkspaceRoot,
  BookmarkCreate,
  BookmarkDelete,
  FileTrack,
  FileUntrack
}

/// A list of jj change ids (reverse-hex), passed by value for `zanshin_new_change`'s
/// `parents` and `zanshin_abandon`'s `change_ids`. `kind` therefore distinguishes the two
/// wrappers: `NewChange` or `Abandon`.
table ChangeIdList {
  kind: RequestKind;
  change_ids: [string];
}

/// Arguments of `zanshin_restore` (Story 9.3, FR-JJ-10a).
///
/// ABSENT (null) is the wire form of "the user did not supply it", which is what
/// carries the CLI's own defaults through faithfully:
///   from / into absent  → that side is `@` (whichever ONE is supplied fixes the other)
///   all three absent    → `@` is restored from its PARENT tree (`jj restore`)
///   changes_in present  → that commit is restored from ITS parent tree; it may NOT be
///                         combined with from/into (the CLI's clap conflicts_with_all)
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths.
/// `restore_descendants` reparents children (preserving their content) instead of
/// rebasing them.
table RestoreRequest {
  kind: RequestKind;
  from: string;
  into: string;
  changes_in: string;
  paths: [string];
  restore_descendants: bool;
}

/// Arguments of `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `from` absent → the source is `@`. `into` absent → the CLI's own `--into` default,
/// the `mutable()` ALIAS, resolved through the repo's effective config. Unlike every
/// other mutation parameter `into` is a revset EXPRESSION, not a change id: the CLI's
/// `--into` denotes a SET whose default is dynamic, and materializing it into ids would
/// destroy that meaning (FR-JJ-17).
/// `paths` behaves exactly as in RestoreRequest.
table AbsorbRequest {
  kind: RequestKind;
  from: string;
  into: string;
  paths: [string];
}

/// Arguments of `zanshin_file_list` (Story 9.4, FR-JJ-17).
///
/// `revision` ABSENT is the wire form of "the user did not supply it", which applies the
/// CLI's own `-r` default: `@` — the working-copy commit the pre-verb snapshot has just brought
/// up to date (Story 9.26). It is a jj reverse-hex CHANGE ID, not a revset: `-r` is
/// `resolve_single_rev`, which refuses an ambiguous revision, so a divergent id is refused
/// rather than guessed.
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths. The
/// fileset DSL is terminal input language and is not parsed (ADR-0003).
table FileListRequest {
  kind: RequestKind;
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_show` (Story 9.4). `revision`/`paths` as in FileListRequest,
/// except `paths` may NOT be empty — the CLI marks its FILESETS argument `required`, and an
/// empty list is `jj.invalid_input`.
table FileShowRequest {
  kind: RequestKind;
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_annotate` (Story 9.4). `revision` as in FileListRequest.
/// `path` is a single PLAIN repo-relative path, not a prefix and not a fileset — it is
/// `parse_file_path` in the CLI too. It is REQUIRED — an absent field is refused with
/// `jj.invalid_input`, mirroring the CLI's required positional argument; an explicitly
/// present EMPTY string is a value, not an absence, and means the repository root.
table FileAnnotateRequest {
  kind: RequestKind;
  revision: string;
  path: string;
}

/// Arguments of `zanshin_file_search` (Story 9.4). `revision`/`paths` as in
/// FileListRequest.
///
/// `pattern` is jj's own `kind:pattern` string-pattern syntax, passed through verbatim
/// (FR-JJ-17); a bare pattern defaults to kind `regex`, and the FIRST `:` separates. It is
/// REQUIRED — an absent field is refused with `jj.invalid_input`, mirroring the CLI's
/// `required = true` on `-p/--pattern`; an explicitly present EMPTY string is a value, not
/// an absence, and is the empty regex, which matches every line (`jj file search -p ""`).
/// `name_only` stops a file's scan at its first match — it changes the WORK done, not the
/// result shape, which is why it survives the terminal-UX cut that dropped `--line-number`
/// (the result always carries `SearchMatch.line_number`).
table FileSearchRequest {
  kind: RequestKind;
  revision: string;
  pattern: string;
  paths: [string];
  name_only: bool;
}

/// Arguments of `zanshin_git_remote_add` (Story 9.5) — the CLI's `jj git remote add`.
///
/// `name` and `url` are REQUIRED; an absent field is refused with `jj.invalid_input`,
/// mirroring the CLI's two required positionals. `push_url` is null-for-absence: ABSENT
/// means the remote pushes to its fetch URL, which is git's own behaviour and the CLI's
/// `--push-url` default. Both URLs cross VERBATIM — unlike the CLI, a relative local path
/// is NOT resolved against a process CWD (a GUI backend has none worth consulting).
///
/// Adding a remote WITH a push url makes it non-removable by `zanshin_git_remote_remove`:
/// jj-lib's own `save_remote` writes a `pushurl` key, and its `remove_remote` refuses any
/// key outside `url`/`fetch`/`tagOpt` (`jj.remote_nonstandard_config`).
table GitRemoteAddRequest {
  kind: RequestKind;
  name: string;
  url: string;
  push_url: string;
}

/// Arguments of `zanshin_git_remote_set_url` (Story 9.5) — the CLI's
/// `jj git remote set-url`.
///
/// `name` is REQUIRED. `url` (fetch) and `push_url` are BOTH null-for-absence, and absence
/// means "leave that side unchanged" — jj-lib cannot REMOVE a URL from a remote. With both
/// absent the call succeeds and does nothing, EVEN for a remote that does not exist: jj-lib
/// returns `Ok(())` in `set_remote_urls`' first two lines, before its own existence check.
/// That is mirrored deliberately; inventing a refusal there would be a divergence.
///
/// This verb never writes an operation — jj-lib takes a `&Store`, not a transaction — so
/// the returned `MutationResult.new_op_id` is always the PRE-CALL op-log head.
table GitRemoteSetUrlRequest {
  kind: RequestKind;
  name: string;
  url: string;
  push_url: string;
}

/// Arguments of `zanshin_show` (Story 9.6, FR-JJ-17) — the CLI's `jj show`.
///
/// `revset` is a pass-through revset EXPRESSION, not a change id: the CLI takes
/// `Vec<RevisionArg>` and UNIONS them, and materializing that into ids would destroy
/// alias/config resolution (FR-JJ-17). A bare DIVERGENT change-id symbol is nonetheless
/// REFUSED — jj-lib's own `SymbolResolver` raises `RevsetResolutionError::DivergentChangeId`
/// (`revset.rs:2827` @ 0.44.0) before evaluation, so `jj show <divergent-id>` fails in the CLI
/// too; it surfaces here as `jj.revset_resolution_error`, a different refusal from
/// InterdiffRequest's `jj.change_not_found`. Both commits stay addressable because their commit
/// hexes are ordinary revset symbols: union them to get one entry per commit.
/// ABSENT is the wire form of "the user did not supply it", which applies the CLI's own default
/// `@` — the working-copy commit the pre-verb snapshot has just brought up to date (Story 9.26). An
/// explicitly present EMPTY string is a VALUE, not an absence, and is a revset parse error.
/// There is deliberately no `paths` field: `jj show` hardcodes `EverythingMatcher`.
/// `limit` is a ZANSHIN-SIDE addition the CLI has no counterpart for — `jj show` has no
/// `-n/--limit` and streams to a pager, where this builds ONE buffer whose every entry pays a
/// merged-parent tree diff plus a per-parent copy-record stream. It is meaningful ONLY when
/// has_limit == true (presence pair, same rule as EvologRequest.limit: flatc 25.12.19 rejects
/// optional scalars for Dart), it is applied in RAW REVSET order, and `limit = 0` is an empty
/// result, not an error. ABSENCE is therefore the CLI-parity default: unbounded, as `jj show` is.
table ShowRequest {
  kind: RequestKind;
  revset: string;
  limit: uint;            // 0 / ignored when has_limit == false
  has_limit: bool;
}

/// Arguments of `zanshin_evolog` (Story 9.6) — the CLI's `jj evolog`.
///
/// `revset` behaves exactly as in ShowRequest. `limit` is the CLI's `-n/--limit`, meaningful
/// ONLY when has_limit == true (presence pair, same rule as SearchMatch.conflict_side: flatc
/// 25.12.19 rejects optional scalars for Dart). It is applied in WALK order — the CLI limits
/// before reversing — and `limit = 0` is an empty result, not an error.
table EvologRequest {
  kind: RequestKind;
  revset: string;
  limit: uint;            // 0 / ignored when has_limit == false
  has_limit: bool;
}

/// A single revision addressed by its jj reverse-hex CHANGE-ID prefix — the house currency for
/// single-revision parameters (Story 9.3, FR-JJ-17).
///
/// Resolves to the one VISIBLE commit carrying that prefix; an unknown, malformed, only-hidden
/// or DIVERGENT prefix is refused rather than guessed, exactly as the CLI's `resolve_single_rev`
/// refuses an ambiguous revision. Use CommitIdRef to reach a hidden commit.
table ChangeIdRef {
  id: string;                       // reverse-hex change-id PREFIX
}

/// A single revision addressed by its commit-id HEX prefix — the CLI's `commit_id()` reading of
/// a bare hex symbol.
///
/// Resolved through jj-lib's INDEX prefix lookup, which is VISIBILITY-BLIND: a HIDDEN commit —
/// an EvologEntry.predecessor_commit_ids entry among them — resolves here, which is what lets
/// evolog and interdiff compose into a version-to-version diff. An ambiguous prefix is refused
/// (`jj.revset_resolution_error`), never guessed; an empty or non-hex value is
/// `jj.invalid_input`; valid hex matching nothing is `jj.change_not_found`. It is NOT a revset
/// symbol resolver: there is no bookmark, tag or change-id fallback.
table CommitIdRef {
  id: string;                       // commit-id hex PREFIX
}

/// Which currency one side of `zanshin_interdiff` is written in.
///
/// Member order IS the wire discriminant (no explicit numbers) — APPEND only. An ABSENT union
/// (both vtable slots unset, discriminant `NONE`) is the wire form of "the user did not supply
/// this side", which applies the CLI's `@` default. `zanshin_interdiff` is the ONLY consumer:
/// every other verb keeps its own currency untouched.
union RevisionRef {
  ChangeIdRef,
  CommitIdRef
}

/// Arguments of `zanshin_interdiff` (Story 9.6) — the CLI's `jj interdiff`.
///
/// Unlike ShowRequest/EvologRequest each side is a SINGLE revision rather than a revset, and it
/// crosses as a RevisionRef union: a ChangeIdRef is the house reverse-hex change-id currency
/// (visible commits only, divergence refused), a CommitIdRef is a commit-id hex prefix resolved
/// through the index and therefore reaches HIDDEN commits. Both inherit the CLI
/// `resolve_single_rev`'s REFUSAL — an ambiguous revision is rejected rather than guessed.
/// Feeding an EvologEntry.predecessor_commit_ids entry in as a CommitIdRef is what composes the
/// two verbs into a version-to-version diff — the stand-in for the unported `evolog --patch`.
/// That composition holds for as long as the predecessor is INDEXED: a garbage-collected one is
/// still listed by evolog but no longer resolvable, and answers `jj.change_not_found`.
/// A revset EXPRESSION (`main`, `@-`) is still not accepted on either side.
/// An ABSENT side is `@` — but omitting BOTH is refused with
/// `jj.invalid_input`, mirroring the CLI's `ArgGroup … required(true)`.
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths, and the
/// fileset DSL is not parsed (ADR-0003). A filter matching nothing yields an EMPTY list, where
/// the CLI only warns.
table InterdiffRequest {
  kind: RequestKind;
  from: RevisionRef;      // two vtable slots: from_type + from
  to: RevisionRef;        // two vtable slots: to_type + to
  paths: [string];
}

/// Arguments of `zanshin_workspace_root` (Story 9.7) — the CLI's `jj workspace root [--name]`.
///
/// ABSENT is the wire form of "the user did not supply --name", which applies the CLI's own
/// documented default: the CURRENT workspace. That path reads the workspace loader alone — no
/// repo load, no store read — and cannot fail. An explicitly present EMPTY string is a VALUE,
/// not an absence: no workspace is named "", so it refuses with `jj.workspace_not_found`.
///
/// `zanshin_workspace_list` has NO request table: the CLI's `jj workspace list` takes no
/// argument at all (its only flag, `-T/--template`, is rendering).
table WorkspaceRootRequest {
  kind: RequestKind;
  name: string;
}

/// Arguments of `zanshin_bookmark_create` (Story 9.8) — the CLI's `jj bookmark create`.
///
/// `names` are EXACT, DECODED bookmark names — not CLI argument text. The CLI validates each
/// with `revset::parse_symbol`, i.e. a name containing a space or an `@` must be QUOTED on a
/// terminal; that quoting is terminal input syntax the GUI replaces (ADR-0003), so the name
/// crosses verbatim. An EMPTY vector is refused with `jj.invalid_input` (clap's
/// `required = true`), and so is an empty-STRING name — the one refusal `parse_symbol` makes
/// that no spelling can get around.
/// `revision` ABSENT is the wire form of "the user did not supply `-r`", which applies the
/// CLI's own clap `default_value`, the literal `@` — the working-copy commit the pre-verb
/// snapshot has just brought up to date (Story 9.26). It is a jj reverse-hex CHANGE ID, not a
/// revset: `-r` is `resolve_single_rev`, so a divergent id is refused rather than guessed,
/// exactly as in FileListRequest. An explicitly present EMPTY string is a VALUE, not an
/// absence, and refuses with `jj.change_not_found`.
table BookmarkCreateRequest {
  kind: RequestKind;
  names: [string];
  revision: string;
}

/// Arguments of `zanshin_bookmark_delete` (Story 9.8) — the CLI's `jj bookmark delete`.
///
/// Unlike BookmarkCreateRequest's, these `names` are string PATTERNS, passed through verbatim
/// (FR-JJ-17) because the pattern KIND is the parameter's meaning, not its spelling:
/// `exact:`, `glob:`, `regex:`, `substring:` and the `~`/`&`/`|` operators all work, and the
/// patterns are unioned. **A BARE pattern is a GLOB, not an exact name** — a bookmark whose
/// name contains `*`, `?` or `[` needs `exact:"…"`. An EMPTY vector is refused with
/// `jj.invalid_input` (clap's `required = true`); a pattern that matches NOTHING is a
/// SUCCESS that writes no operation, so `MutationResult.new_op_id` is the PRE-CALL op-log
/// head.
table BookmarkDeleteRequest {
  kind: RequestKind;
  names: [string];
}

/// Arguments of `zanshin_file_track` (Story 9.22) — the CLI's `jj file track`.
///
/// `paths` are repo-relative paths interpreted as PREFIXES; the fileset DSL is terminal input
/// language and is not parsed (ADR-0003). An EMPTY or ABSENT vector is refused with
/// `jj.invalid_input` (clap's `required = true`). `include_ignored` is the CLI's
/// `--include-ignored`: track matching files even when ignored or over
/// `snapshot.max-new-file-size`.
table FileTrackRequest {
  kind: RequestKind;
  paths: [string];
  include_ignored: bool;
}

/// Arguments of `zanshin_file_untrack` (Story 9.22) — the CLI's `jj file untrack`. `paths`
/// exactly as in FileTrackRequest; every matched path must already be ignored.
table FileUntrackRequest {
  kind: RequestKind;
  paths: [string];
}

// ── Payload union ─────────────────────────────────────────────────────────────
// Closed registry of composite FFI return types.
// Extend this union — and regenerate both sides — as each noun lands:
//   Story 3-4a : RepoHandle  ✓
//   Story 3-8  : Diagnostics ✓
//   Story 3-4b : status ✓, change ✓, op_log ✓, bookmarks ✓, remotes ✓
//   Story 3-6  : WatcherEvent ✓, Progress ✓
//   Story 4-2  : GraphSlice ✓ (FFI wrapper 4-6)
//   Story 4-9  : LogDefaults ✓
//   Story 5-8  : Diff
//   Story 6-5  : mutation results ✓
//   Story 9-3  : AbsorbResult ✓ (restore reuses MutationResult)
//   Story 9-4  : FileList ✓, FileContents ✓, FileAnnotation ✓, FileSearch ✓
//   Story 9-5  : GitImportResult ✓, GitExportResult ✓ (the four remote verbs reuse
//                MutationResult)
//   Story 9-6  : ShowView ✓, EvologView ✓, InterdiffView ✓ (all three reuse the shipped
//                Change / FileChange tables — no second spelling of either shape)
//   Story 9-7  : WorkspaceList ✓, WorkspaceRoot ✓ (the list row is the shipped
//                View::wc_commit_ids half plus the WorkspaceStore path half)
//   Story 9-8  : — (bookmark create/delete BOTH reuse the shipped MutationResult, so the
//                union is unchanged: which bookmarks are gone is answered by re-reading
//                zanshin_bookmarks, and "did anything happen at all" is already in the
//                contract as the pre-call-head new_op_id)
//   Story 9-22 : TrackResult ✓, UntrackResult ✓ (both nest the shipped MutationResult and one
//                shared SnapshotStats; UntrackResult reuses GitExportFailure)

/// Opaque handle to an open repo session.
/// `handle` is the Rust `*mut RepoSession` reinterpreted as an unsigned integer;
/// Dart passes it back verbatim to zanshin_repo_close.
/// `session_id` is a process-unique, never-reused id allocated when the session
/// is armed; async events (WatcherEvent/Progress) carry it as their correlation
/// id. Unlike `handle` (an allocation address that a close→reopen can reuse —
/// the rawToId ABA race, resolved 2026-07-04), a session id can never be
/// misattributed to a later session.
table RepoHandle {
  handle: ulong;
  session_id: ulong;
}

/// Diagnostics payload returned by zanshin_diagnostics().
/// All three fields are compile-time or infallibly-resolved values.
table Diagnostics {
  app_version: string;
  git_sha: string;
  log_path: string;
}

/// How a working-copy file changed between @- and @.
enum ChangeKind : byte { Added, Modified, Removed, Renamed, Copied }

/// One changed file. `from_path` is set ONLY for Renamed/Copied (the source
/// path); it is absent for Added/Modified/Removed.
table FileChange {
  path: string;
  kind: ChangeKind;
  from_path: string;
}

/// Working-copy status: files changed between @ and @-, plus both change ids
/// in jj's reverse-hex display form.
table Status {
  files: [FileChange];
  working_copy_change_id: string;
  parent_change_id: string;
}

/// A commit signature: who authored/committed and when (raw jj timestamp).
table Signature {
  name: string;
  email: string;
  timestamp_millis: long;     // millis since the Unix epoch
  tz_offset_minutes: int;     // timezone offset, minutes east of UTC
}

/// Whether a change is conflict-free. `conflicted_paths` is populated only when Conflicted.
enum ConflictState : byte { Clean, Conflicted }

/// Full metadata for one change (FR-JJ-6). Authored/committed times live on the
/// author/committer signatures (authored_at == author.timestamp_millis, etc.).
table Change {
  id: string;                  // ChangeId reverse-hex (stable across rebases)
  commit_id: string;           // CommitId hex (Git SHA; changes on rebase)
  parents: [string];           // parent ChangeIds reverse-hex; empty for the root change
  description: string;         // always present, may be empty
  author: Signature;
  committer: Signature;
  is_signed: bool;             // cryptographic signature present (presence-only; 2.6 D3)
  conflict: ConflictState;
  conflicted_paths: [string];  // populated only when conflict == Conflicted
  is_anonymous: bool;
  divergent: bool;             // change id resolved to >1 visible commit (2.6 D4)
}

/// One entry in jj's operation log (FR-JJ-7).
table Operation {
  id: string;                  // op id, plain forward hex (NOT reverse-hex)
  parent_ids: [string];        // parent op ids; empty for the root op; >1 for a DAG fork
  timestamp_millis: long;      // op end-time, millis since the Unix epoch
  tz_offset_minutes: int;      // timezone offset, minutes east of UTC
  user: string;                // metadata.username; may be empty
  host: string;                // metadata.hostname; may be empty
  description: string;         // jj's user-friendly summary; always present, may be empty
  root_op: bool;               // true iff the op-store root operation
  is_snapshot: bool;           // pure working-copy-snapshot op (2.7 D6)
}

/// The operation log: reverse-chronological (head op first, root op last).
table OpLog {
  operations: [Operation];
}

/// Whether a bookmark is local-only or a tracked remote bookmark.
/// `remote_name` is populated ONLY when kind == Remote (empty for Local).
enum BookmarkKind : byte { Local, Remote }

/// One jj bookmark (FR-JJ-8). A bookmark that is both local and remote-tracked
/// appears as TWO entries: one Local, one Remote.
table Bookmark {
  name: string;          // bookmark name (UTF-8)
  target: string;        // target ChangeId, reverse-hex (stable across rebases)
  kind: BookmarkKind;
  remote_name: string;   // populated only when kind == Remote; empty for Local
}

/// The bookmark list: local + tracked-remote entries, sorted by name then kind.
table Bookmarks {
  bookmarks: [Bookmark];
}

/// One configured git remote (FR-JJ-9). BOTH URLs are verbatim — credentials are
/// NOT scrubbed and SSH is NOT rewritten to HTTPS.
///
/// `push_url` reports a DIFFERENCE, not a raw `remote.<name>.pushurl` read: it is
/// present only when the remote's push URL differs from `url`, exactly as
/// `jj git remote list` prints its `(push: …)` suffix only then. ABSENT therefore
/// means "this remote pushes to its fetch URL" — never an empty string.
table Remote {
  name: string;      // remote name, e.g. "origin" (UTF-8)
  url: string;       // fetch URL, verbatim
  push_url: string;  // null-for-absence: set only when it DIFFERS from `url`
}

/// The remote list: configured git remotes, sorted by name.
table Remotes {
  remotes: [Remote];
}

/// Classification of a path from detect_repo (FR-JJ-17).
/// Mirrors zanshin_jj::RepoKind — order must stay identical.
enum RepoKind : byte { Jj, Git, Neither, PathNotFound }

/// Result of zanshin_repo_detect.
///
/// `kind` is always set.
/// `suggested_root` and `suggested_kind` are ONLY meaningful when
/// `suggested_root` is non-null (presence == the suggestion flag, D4).
/// When kind == Neither or PathNotFound and a parent jj/git repo exists,
/// `suggested_root` is its path and `suggested_kind` its classification,
/// so the UI can offer "this folder is inside a {jj|Git} repo at <root>".
/// The backend never auto-opens; the user decides.
table RepoDetect {
  kind: RepoKind;
  suggested_root: string;
  suggested_kind: RepoKind;
}

/// Kind of async watcher event dispatched over the process-global event sink
/// (FR-FFI-4, FR-RX-1). `WatchError` is a degraded-watch signal, not a failed
/// call — the event Envelope's `ok` is always true (R5, single-emission-point:
/// the `watcher.io_error` code string is reserved for the arming-failure error
/// envelope at open/init/clone/convert).
enum WatcherEventKind : byte { OpHeadsChanged, WorkingCopyHeartbeat, WatchError }

/// One filesystem-watch event for the repo identified by `session_id`
/// (ADR-0002:57 correlation id, refined 2026-07-04: the process-unique
/// session id from `RepoHandle.session_id` — NOT the raw handle, whose
/// allocation address a close→reopen can reuse).
/// `paths` is absent for `WatchError`; `message` is set only for `WatchError`
/// (null-for-absence).
table WatcherEvent {
  session_id: uint64;
  kind: WatcherEventKind;
  paths: [string];
  message: string;
}

/// Progress notification for a long-running operation (FR-FFI-8), e.g. `git
/// fetch` (producer lands in Story 6-4a). Dispatched over the same
/// process-global event sink as `WatcherEvent`, correlated by `session_id`
/// (same never-reused id as WatcherEvent — see RepoHandle.session_id).
table Progress {
  session_id: uint64;
  operation: string;
  progress: float;
  message: string;
}

/// How a graph edge's target was classified by the revset-graph stream.
/// Mirrors zanshin_graph::EdgeKind — order must stay identical.
/// `Direct`/`Indirect` targets are in the revset (Indirect = the direct parent
/// was elided; renderers may draw it dashed); `Missing` leads outside the
/// revset and never reserves a lane.
enum GraphEdgeKind : byte { Direct, Indirect, Missing }

/// One routed parent edge of a GraphRow (Story 4.2).
/// `target_lane` is meaningful ONLY when kind != Missing (presence == the
/// kind flag, same pattern as RepoDetect.suggested_kind / Bookmark.remote_name):
/// a Missing edge never lands in a lane, so Rust writes 0 and Dart models it
/// as null. flatc 25.12.19 rejects optional scalars (`= null`) for Dart.
table GraphRowEdge {
  target: string;          // parent commit id, hex
  target_lane: uint;       // lane the edge is routed to; 0 / ignored when kind == Missing
  kind: GraphEdgeKind;
}

/// One bookmark or tag entry on a GraphRow (Story 4.8, zanshin_jj::CommitRef).
/// Mirrors the CLI's per-commit ref rendering: `name`, then `@remote` for a
/// remote entry, then `??` when conflicted or `*` when a local entry is not
/// synced. `remote` is ABSENT (Dart null) for the local entry — null-for-absence.
/// Tracked-and-synced remote entries are not emitted at all (the CLI's
/// `collect_distinct_refs` rule: `is_local() || !synced`).
table GraphCommitRef {
  name: string;            // bookmark/tag name, UTF-8
  remote: string;          // absent for the local entry
  synced: bool;
  conflicted: bool;
}

/// One lane passing vertically THROUGH a GraphRow (Story 4.8,
/// zanshin_graph::ActiveLane) — it neither starts nor ends at that row's node.
/// `kind` is the kind of the edge that opened the segment, so a renderer can
/// style it without reading any neighbouring row; the color is lane % PALETTE_SIZE.
table GraphActiveLane {
  lane: uint;
  kind: GraphEdgeKind;
}

/// `jj log`-parity display metadata for one commit row (Story 4.8,
/// zanshin_jj::CommitMeta), extracted from the SAME head-resolved snapshot as the
/// lane assignment. Ids are full; the `*_prefix_len` fields are the
/// shortest-unique-prefix lengths the UI highlights.
///
/// `change_offset` is meaningful ONLY when has_change_offset == true (presence
/// pair, same pattern as GraphRowEdge.target_lane: flatc 25.12.19 rejects
/// optional scalars for Dart). The CLI renders `/<offset>` only for
/// hidden/divergent commits — that is a UI decision, reproducible from the flags.
table GraphRowMeta {
  change_id: string;                 // ChangeId reverse-hex display form
  change_id_prefix_len: uint;
  commit_id_prefix_len: uint;
  change_offset: uint;               // 0 / ignored when has_change_offset == false
  has_change_offset: bool;
  author_name: string;               // may be empty (jj allows it)
  author_email: string;              // may be empty (jj allows it)
  committer_timestamp_millis: long;  // committer timestamp, millis since the Unix epoch
  committer_tz_offset_minutes: int;  // timezone offset, minutes east of UTC
  bookmarks: [GraphCommitRef];
  tags: [GraphCommitRef];
  working_copies: [string];          // EVERY workspace whose wc commit this is (incl. the current one); empty in a single-workspace repo (the CLI's guard)
  working_copy: bool;                // this workspace's @
  immutable: bool;                   // in ::(immutable_heads() | root())
  conflict: bool;
  empty: bool;
  hidden: bool;
  divergent: bool;
  root: bool;
  description_first_line: string;    // "" when the description is empty
}

/// One lane-assigned commit row (zanshin_graph::Row). Rows carry a COMMIT id,
/// never a change id (change ids are ambiguous for divergent changes).
///
/// `synthetic_elided` marks the synthetic "(elided revisions)" row the CLI
/// splices for an elided ancestor (`ui.log-synthetic-elided-nodes`): its
/// `commit_id` is the ELIDED TARGET's id, its lane fields are real, and `meta`
/// is ABSENT (Dart null — a nested table is the only shape flatc 25.12.19 lets
/// Dart see as null). On a commit row `meta` is always present.
///
/// Consequence: with synthetic elided rows ON (the default) `commit_id` is NOT
/// unique across rows — the synthetic row and the real commit it stands for
/// share it, and a child's GraphRowEdge.target names that id with no synthetic
/// marker. A synthetic row always sits IMMEDIATELY after the child that elided
/// to it, and `lane` / `target_lane` are the linkage. Do not use `commit_id`
/// alone as a row key.
table GraphRow {
  commit_id: string;               // commit id, hex
  lane: uint;                      // lane this commit was placed on
  color_idx: uint;                 // deterministic palette index, lane % PALETTE_SIZE
  edges: [GraphRowEdge];           // one per input parent edge, same order
  active_lanes: [GraphActiveLane]; // pass-through lanes, ascending; always present
  synthetic_elided: bool;
  meta: GraphRowMeta;              // absent iff synthetic_elided
}

/// A slice of the lane-assigned commit graph, in stream (`jj log`) order.
/// Return-all semantics (Story 4.4): total_rows == rows.length. Windowing is
/// deferred past WIP; if it lands later it may set total_rows > rows.length.
table GraphSlice {
  rows: [GraphRow];        // one per Row, stream order; always present (empty for an empty slice)
  total_rows: uint;        // == rows.length in WIP (see table doc)
}

/// The repo's EFFECTIVE `jj log` defaults (Story 4.9) — what the user's own jj
/// CLI would apply, after their `[revsets]` / `[ui]` config overrides.
///
/// Offered as pre-fills for zanshin_graph_slice's pass-through parameters
/// (FR-JJ-17); nothing is applied silently, the caller decides. `short_prefixes`
/// falls back to `log` when `revsets.short-prefixes` is ABSENT; an explicit
/// empty string means disambiguation is DISABLED and is returned verbatim.
table LogDefaults {
  log: string;                  // revsets.log
  log_graph_prioritize: string; // revsets.log-graph-prioritize
  short_prefixes: string;       // revsets.short-prefixes (falls back to log on absence)
  synthetic_elided: bool;       // ui.log-synthetic-elided-nodes
}

/// Outcome of a successful mutation (Story 6-1/6-2/6-4a, FR-JJ-10a/FR-JJ-13/FR-JJ-14a):
/// `zanshin_describe`/`_new_change`/`_edit`/`_abandon`/`_undo`/`_git_fetch`.
/// `new_change_ids` / `abandoned_change_ids` are empty when the mutation mints
/// or abandons nothing (see `zanshin_jj::MutationResult`'s field docs for the
/// per-verb rules).
table MutationResult {
  new_op_id: string;
  new_change_ids: [string];
  abandoned_change_ids: [string];
  working_copy_change_id: string;
  /// Which identity fields were empty when this call committed an operation — the jj CLI's
  /// "Name and email not configured" warning as a fact (Story 9.27). ABSENT when both are
  /// configured and on every call that committed nothing; the UI turns a present value into
  /// the "set your identity" prompt. Never a refusal.
  identity_missing: IdentityMissing;
  /// What the CLI's `finish_transaction` reported while committing this call's operation
  /// (Story 9.26). ABSENT when every fact is at its default — always on a call that committed
  /// nothing, and for `zanshin_file_track` / `zanshin_file_untrack`, which never reach it.
  finish: FinishFacts;
}

/// The colocated Git bookkeeping the CLI runs while it finishes a transaction
/// (`finish_transaction`, Story 9.26) — warnings there, facts here, never an error envelope.
/// `working_copy_became_immutable`: the transaction left `@` inside the immutable set, so a new,
/// empty `@` was created on top of it. `git_head_update_failed`: Git HEAD could not be moved to
/// `@`'s parent (a concurrent `git checkout`); the next snapshot imports the actual HEAD. The two
/// lists are the refs the colocated export could not write.
table FinishFacts {
  working_copy_became_immutable: bool;
  git_head_update_failed: bool;
  export_failed_bookmarks: [GitExportFailure];
  export_failed_tags: [GitExportFailure];
}

/// `MutationResult.identity_missing`: which of `user.name` / `user.email` is empty.
table IdentityMissing {
  name: bool;
  email: bool;
}

/// One path an operation could not process, with the verbatim reason.
///
/// Three payloads carry it: `AbsorbResult.skipped_paths` — a path jj-lib refused to split
/// ("Is a symlink", "Is a conflict", "Is a Git submodule", "Access is denied: …");
/// `FileContents.skipped` — a path that is not renderable as file content
/// ("Path '…' exists but is not a file.", "Path '…' exists but access is denied: …",
/// "Path '…' is absent.", "Path '…' is a directory." — the last two are the cases the CLI
/// `panic!`s on, which a library reports instead of aborting the process); and
/// `FileSearch.skipped` — a path whose blob could not be READ, with `jj file search`'s own
/// sentence ("Skipping '…' due to permission error: …"). Note the two file verbs skip
/// DIFFERENT sets with DIFFERENT wording: that is CLI parity, not an inconsistency. In every
/// case the call SUCCEEDS for the remaining paths; the CLI prints one warning per entry.
table SkippedPath {
  path: string;      // repo-relative, jj's internal `/`-separated form
  reason: string;    // the CLI's / jj-lib's own message, forwarded unchanged
}

/// Outcome of a successful `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has
/// one definition; its `new_change_ids` / `abandoned_change_ids` are always empty here.
/// An EMPTY `rewritten_change_ids` means nothing was absorbable — and then no operation
/// was written either, so `mutation.new_op_id` is the PRE-CALL op-log head.
/// `source_change_id` is ABSENT when jj-lib abandoned the source (it became discardable)
/// or when nothing moved — null-for-absence.
/// `num_rebased` excludes the destination commits and includes the rewritten source
/// (jj-lib's own `AbsorbStats::num_rebased` accounting). jj-lib counts in `usize`; a
/// count above `uint`'s range SATURATES at 4294967295 rather than wrapping — it is a
/// progress figure for the UI, never something a decision keys off.
table AbsorbResult {
  mutation: MutationResult;
  rewritten_change_ids: [string];   // destination ChangeIds, reverse-hex, forward topological order
  source_change_id: string;         // absent when the source was abandoned or nothing moved
  num_rebased: uint;
  skipped_paths: [SkippedPath];
}

/// What a tree entry IS (Story 9.4) — the CLI's `TreeEntry.file_type` keyword
/// (`cli/src/commit_templater.rs::describe_file_type` @ v0.44.0).
/// `Tree` is UNREACHABLE through `zanshin_file_list` (jj-lib's `entries_matching` recurses
/// into subtrees rather than yielding them) but is modelled so the mapping is total. jj's
/// sixth case — an ABSENT entry, rendered as `""` — is never emitted and has no member.
// Member order IS the wire value (File == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `union Payload` below.
enum FileType : byte { File, Symlink, Tree, GitSubmodule, Conflict }

/// One entry of a revision's tree (Story 9.4), modelled on the CLI's `TreeEntry` keywords.
///
/// The CLI's `conflict` keyword (`!value.is_resolved()`) has no field of its own: it is
/// exactly `file_type == Conflict`, so carrying it too would be a second, desyncable
/// spelling of one fact.
/// `executable` is false for a symlink, a submodule, and a conflict whose sides disagree
/// about the bit (the CLI's `unwrap_or_default()`). `conflict_side_count` is the SIMPLIFIED
/// merge's side count: 1 for a resolved entry, >= 2 for a conflict (`Merge::num_sides()` is
/// `values.len() / 2 + 1`, so the smallest conflict has two sides); it saturates at
/// 4294967295. A subtree that CONFLICTS with a non-tree is emitted as one entry with
/// file_type == Conflict and is not descended into — render it as an opaque conflict, not
/// an empty directory.
table FileEntry {
  path: string;                // repo-relative, jj's internal `/`-separated form
  file_type: FileType;
  executable: bool;
  conflict_side_count: uint;
}

/// The entries of a revision's tree, in jj-lib's own `entries_matching` (tree) order.
table FileList {
  entries: [FileEntry];
}

/// One file's content as `jj file show` would print it (Story 9.4).
///
/// `content` is `[ubyte]`, not `string`: a tracked file is not guaranteed UTF-8. For a
/// conflicted path it is the MATERIALIZED merge, with markers in the style the repo's
/// EFFECTIVE `ui.conflict-marker-style` selects (re-read per call, never cached).
table ShownFile {
  path: string;
  content: [ubyte];
  conflict: bool;
}

/// The result of `zanshin_file_show` (Story 9.4): the files that could be rendered, plus
/// the paths that could not — a symlink, a Git submodule, an unreadable blob, and the two
/// cases the CLI `panic!`s on rather than reports (an absent value, a bare directory). A
/// skipped path does NOT fail the call — the CLI prints a warning per entry and keeps
/// going. Every reason string is listed on SkippedPath.
table FileContents {
  files: [ShownFile];
  skipped: [SkippedPath];
}

/// One annotated line of a file (Story 9.4) — `jj file annotate`'s per-line row.
///
/// `original_line_number` is 1-BASED: jj-lib reports it 0-based and the CLI adds 1. There is
/// deliberately no `line_number` field — a line's own number is its 1-based index in
/// `FileAnnotation.lines`. `origin_found` is false when the search stopped at the domain
/// boundary and `commit_id` is only where it stopped; the CLI collapses that case to the
/// root commit for display, this payload keeps the distinction.
table AnnotationLine {
  commit_id: string;           // CommitId hex of the originating commit
  change_id: string;           // that commit's ChangeId, reverse-hex
  original_line_number: uint;  // 1-based, in the ORIGINATING commit's version; saturates at 4294967295
  content: [ubyte];            // the raw line, newline included when the source had one
  origin_found: bool;
}

/// A file's annotation: one entry per line, in file order.
table FileAnnotation {
  lines: [AnnotationLine];
}

/// One matching line of `zanshin_file_search` (Story 9.4).
///
/// `line_number` is 1-based within the searched content. `conflict_side` is meaningful ONLY
/// when has_conflict_side == true (presence pair, same rule as GraphRowMeta.change_offset:
/// flatc 25.12.19 rejects optional scalars for Dart); it is the 0-based side of a conflicted
/// path, whose line numbers restart at each side — there is no meaningful unified numbering
/// across sides (the CLI's own reasoning at `search.rs:146-147`).
table SearchMatch {
  path: string;
  line_number: uint;           // saturates at 4294967295, as conflict_side does
  content: [ubyte];            // the raw matching line, newline included
  conflict_side: uint;         // 0 / ignored when has_conflict_side == false
  has_conflict_side: bool;
}

/// The matches of `zanshin_file_search`, in `entries_matching` (tree) order then line order,
/// plus the paths that could not be searched.
///
/// `skipped` carries ONLY unreadable blobs (`AccessDenied`) — the single case
/// `jj file search` warns about. Symlinks, Git submodules and non-file conflicts are skipped
/// SILENTLY there and never appear here, which is the exact OPPOSITE of `jj file show`
/// (whose `FileContents.skipped` reports the symlink/submodule cases and uses different
/// wording). An empty `skipped` with an empty `matches` therefore means "nothing matched",
/// which is now distinguishable from "a blob was unreadable".
table FileSearch {
  matches: [SearchMatch];
  skipped: [SkippedPath];
}

/// How one remote ref changed during `zanshin_git_import` (Story 9.5) — the CLI's own
/// derivation from `(old_remote_ref.target.is_absent(), new_target.is_absent())`
/// (`cli/src/git_util.rs:418-425` @ v0.44.0).
// Member order IS the wire value (New == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `FileType` above and `union Payload` below.
enum GitRefUpdateKind : byte { New, Updated, Deleted }

/// One remote bookmark or tag `zanshin_git_import` changed (Story 9.5).
///
/// These are the four facts the CLI renders per line
/// (`"{label}: {symbol} [{import_status}] {tracking_status}"`); the column padding and the
/// colouring are the terminal UX Zanshin replaces. `tracked` is read from the POST-import
/// view, not from the old remote ref — a freshly-imported ref's tracking state is decided
/// during the import itself.
table GitRefUpdate {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to, e.g. "origin"
  kind: GitRefUpdateKind;
  tracked: bool;
}

/// Outcome of a successful `zanshin_git_import` (Story 9.5) — the CLI's `jj git import`.
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has one
/// definition (the `AbsorbResult` precedent); its `new_change_ids` /
/// `abandoned_change_ids` are always empty here — an import's own abandonments are
/// `abandoned_change_ids` on THIS table, a different fact from the caller-supplied id list
/// `MutationResult.abandoned_change_ids` echoes for `zanshin_abandon`.
///
/// If nothing needed importing NO operation was written, and `mutation.new_op_id` is the
/// PRE-CALL op-log head. `failed_ref_names` is still reported in that case: a run where
/// every pending ref failed changes nothing yet must say so, and nothing in the repository
/// state lets a caller re-derive the list afterwards. A failed ref is NEVER an error — the
/// CLI warns and exits 0. Names are lossy-UTF-8 (a git ref name is not guaranteed UTF-8);
/// one under `refs/remotes/git/` is the reserved-namespace case.
///
/// `num_rewritten` is a plain COUNT because a count is all the CLI reports
/// ("Updated {n} rewritten commits."); it saturates at 4294967295, as `AbsorbResult`'s own
/// count does.
table GitImportResult {
  mutation: MutationResult;
  changed_bookmarks: [GitRefUpdate];
  changed_tags: [GitRefUpdate];
  abandoned_change_ids: [string];   // ChangeIds, reverse-hex, of commits unreachable in git
  num_rewritten: uint;
  failed_ref_names: [string];
}

/// One remote ref `zanshin_git_export` could not write to git (Story 9.5).
///
/// `reason` is jj-lib's own reason rendered as the FLATTENED `source()` chain joined by
/// `": "`, exactly as the CLI prints it: the two interesting variants
/// (`FailedToDelete`/`FailedToSet`) hide the real cause behind `#[source]`, so the
/// top-level message alone would say only "Failed to set".
table GitExportFailure {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to; "git" for the local git repo's own refs
  reason: string;
}

/// Outcome of a successful `zanshin_git_export` (Story 9.5) — the CLI's `jj git export`.
///
/// `mutation` is NESTED for the same reason as in `GitImportResult`; export never moves `@`
/// and never mints or abandons a change, so its two id vectors are always empty. If git
/// already matched, NO operation was written and `mutation.new_op_id` is the PRE-CALL
/// op-log head.
///
/// Failed refs ride in the RESULT, never as an error envelope: the CLI warns and exits 0,
/// and an export whose only outcome is a failure list must still be readable. The classic
/// case is two bookmarks named `foo` and `foo/bar`, which git cannot both hold.
/// `failed_tags` only ever contains `@git` tags — git has no remote tags.
table GitExportResult {
  mutation: MutationResult;
  failed_bookmarks: [GitExportFailure];
  failed_tags: [GitExportFailure];
}

/// One revision as `zanshin_show` presents it (Story 9.6): its metadata plus what it changed.
///
/// `change` is the SHIPPED `Change` table — byte-identical to what `zanshin_change` returns for
/// the same commit, because both come from one construction site in `zanshin-jj`.
/// `file_changes` is the SHIPPED `FileChange` table: the diff of the commit's MERGED parent tree
/// against its own tree, classified into Added/Modified/Removed/Renamed/Copied exactly as the
/// CLI's `diff_status_inner` does. For a MERGE commit that is only what the merge itself
/// changed; for the ROOT commit it is empty. Copy records are accumulated over EVERY parent
/// (the CLI's `show_patch`), so `Renamed`/`Copied` CAN appear here — unlike in `InterdiffView`.
///
/// There is no textual patch: line/word-level diffing is Epic 5 (`zanshin-diff`), which will
/// EXTEND this payload rather than replace it.
table ShowEntry {
  change: Change;
  file_changes: [FileChange];
}

/// The result of `zanshin_show`: one entry per commit the revset denotes, in RAW revset order
/// (topological, children before parents). A revset matching nothing is an EMPTY list and a
/// SUCCESS. Entries are per COMMIT, not per change: a revset naming two commits of ONE
/// divergent change yields two entries carrying the same `Change.id`, both with
/// `Change.divergent` set. Reaching that state takes their commit hexes, though — a bare
/// divergent change-id symbol never gets this far, because jj-lib's `SymbolResolver` refuses it
/// first (see ShowRequest).
table ShowView {
  entries: [ShowEntry];
}

/// One step of a change's evolution as `zanshin_evolog` walks it (Story 9.6).
///
/// `change` is the shipped `Change` table for THIS version of the change — with two exceptions
/// that come from reusing the single `Change` construction site: `divergent` reports whether
/// the change has several VISIBLE commits RIGHT NOW (the same answer on every row of one
/// evolution, never a statement about this historical version) and `is_anonymous` reads today's
/// local bookmarks. Everything else (commit_id, parents, description, signatures, timestamps,
/// conflict) is this version's own.
/// Rows carry commit ids
/// in `predecessor_commit_ids` rather than change ids: every predecessor shares the change's own
/// id, and predecessors are HIDDEN by construction, so a change id could not be resolved back.
/// They ARE addressable by `zanshin_interdiff`, as a CommitIdRef (see InterdiffRequest): that is
/// how the two verbs compose into a version-to-version diff.
/// `operation_id` is the operation that created or rewrote this commit and is ABSENT
/// (null-for-absence) for an entry the walk emitted from its flush tail — it reached an
/// operation storing no predecessors and could go no further. That absence is the ONLY signal a
/// caller has that an evolution may be TRUNCATED; the CLI truncates silently. When it is absent
/// `predecessor_commit_ids` is always empty.
table EvologEntry {
  change: Change;
  predecessor_commit_ids: [string];  // CommitIds, hex; empty when operation_id is absent
  operation_id: string;              // op id, plain forward hex; absent for the walk's flush tail
}

/// The result of `zanshin_evolog`: the evolution entries in RAW walk order (newest first). The
/// CLI's `--reversed` and its graph mode's `TopoGroupedGraph` re-ordering are rendering the GUI
/// does itself, and are not applied. `limit = 0` is an EMPTY list and a success.
table EvologView {
  entries: [EvologEntry];
}

/// The result of `zanshin_interdiff` (Story 9.6): what `to` changes that `from` does not, with
/// the parent difference factored out by rebasing `from` onto `to`'s parents in memory.
///
/// Reuses the shipped `FileChange` table. `Renamed`/`Copied` NEVER appear here: the CLI's
/// `show_inter_diff` passes `CopyRecords::default()`, and that asymmetry with `ShowEntry` is
/// reproduced deliberately rather than corrected. Identical trees are an EMPTY list and a
/// success, as is a path filter that matches nothing.
///
/// `base_has_conflicts` reports whether the REBASED `from` tree — the LEFT side of the diff,
/// which exists only in memory — is conflicted. It is a ZANSHIN-SIDE addition: the CLI signals
/// this by rendering conflict markers in the patch TEXT, which is Epic 5's surface here, so a
/// caller would otherwise see a plausible change list derived from a conflicted rebase with no
/// way to tell. It is true whatever the cause — the 3-way merge left the conflict, OR
/// `rebase_to_dest_parent`'s fast path (same parents) returned `from`'s own already-conflicted
/// tree. `to`'s own conflict state is NOT reported here; that is `Change.conflict`'s job, via
/// `zanshin_show` / `zanshin_change`. The flag describes the TREE, not the filtered result:
/// a `paths` filter matching nothing still leaves it set.
table InterdiffView {
  file_changes: [FileChange];
  base_has_conflicts: bool;
}

/// One row of `zanshin_workspace_list` (Story 9.7) — the CLI's `jj workspace list`.
///
/// `name` and `wc_commit_id` are the VIEW half (`View::wc_commit_ids()`), the same pair
/// `zanshin_jj::WorkingCopy` carries; `root` is the half that lives in the WorkspaceStore.
/// `root` is ABSENT (null-for-absence) whenever the path cannot be reported — the workspace
/// predates jj 0.38.0 and has no recorded path, the store is unreadable, or the recorded
/// directory moved or was deleted. That absence NEVER fails the listing: the CLI's own
/// `WorkspaceRef::root` collapses every such failure to "no root" so list templates keep
/// rendering (`cli/src/commit_templater.rs:1787` @ v0.44.0), and points at
/// `jj workspace root --name` — here `zanshin_workspace_root` — for strict path diagnostics.
/// When present it is an ABSOLUTE, canonicalized path; CWD-relative shortening is the GUI's job.
table WorkspaceEntry {
  name: string;             // workspace name, UTF-8; "default" in a single-workspace repo
  wc_commit_id: string;     // CommitId hex of that workspace's working-copy commit
  root: string;             // absolute workspace root; ABSENT when it cannot be resolved
}

/// The result of `zanshin_workspace_list`: one row per workspace, in jj-lib's own BTreeMap
/// order (lexicographic by workspace name), which is preserved rather than re-sorted.
table WorkspaceList {
  entries: [WorkspaceEntry];
}

/// The result of `zanshin_workspace_root` (Story 9.7): one absolute workspace root directory.
///
/// Always present on a successful call — unlike `WorkspaceEntry.root`, which is optional. That
/// asymmetry is the CLI's own: `jj workspace list` degrades to no root while
/// `jj workspace root --name` raises one of three distinct refusals, and it is reproduced here
/// rather than unified.
table WorkspaceRoot {
  root: string;
}

/// `UntrackedReason` arm: the file is larger than the effective `snapshot.max-new-file-size`
/// (Story 9.22). Both sizes are in bytes.
table FileTooLarge {
  size: ulong;
  max_size: ulong;
}

/// `UntrackedReason` arm: the file does not match the snapshot's start-tracking fileset —
/// `snapshot.auto-track`, or the paths a `zanshin_file_track` named (Story 9.22). No fields:
/// the arm IS the fact.
table FileNotAutoTracked {}

/// Why a new file stayed untracked after a snapshot (Story 9.22) — jj-lib's `UntrackedReason`.
/// Member order IS the wire discriminant (no explicit numbers) — APPEND only.
union UntrackedReason {
  FileTooLarge,
  FileNotAutoTracked
}

/// One new file a snapshot left untracked, and why (Story 9.22).
table UntrackedPath {
  path: string;                 // repo-relative, jj's internal `/`-separated form
  reason: UntrackedReason;      // two vtable slots: reason_type + reason
}

/// What a working-copy snapshot could NOT record (Story 9.22) — the facts the CLI's snapshot
/// warnings print. ONE definition shared by TrackResult, UntrackResult and Precondition (Story 9.26).
/// `invalid_utf8_paths` are files skipped because their NAME is not valid UTF-8, rendered as
/// `"<dir>/<name>"` (the bare name at the root) with the name lossily decoded.
table SnapshotStats {
  untracked: [UntrackedPath];   // jj-lib's (path) order
  invalid_utf8_paths: [string];
}

/// Outcome of a successful `zanshin_file_track` (Story 9.22) — the CLI's `jj file track`.
///
/// An operation (`track paths`) is ALWAYS written, even when nothing matched: the CLI commits
/// unconditionally. `mutation.working_copy_change_id` is the PRE-call `@`: like the CLI, the
/// verb records the tracked paths only in the working-copy STATE, and the NEXT snapshot moves
/// them into `@` and rebases its children (jj's GH #8298) — which is also why `num_rebased` is
/// 0 today. It saturates at 4294967295, as `AbsorbResult`'s does.
table TrackResult {
  mutation: MutationResult;
  num_rebased: uint;
  snapshot_stats: SnapshotStats;
}

/// Outcome of a successful `zanshin_file_untrack` (Story 9.22) — the CLI's `jj file untrack`.
///
/// An operation (`untrack paths`) is ALWAYS written; `@` is rewritten without the matched
/// entries (same change id) and `num_rebased` counts its rebased descendants (saturating).
/// `unmatched_paths` are the requested paths with no entry in the pre-call `@` — the CLI's
/// "No matching entries for paths" warning — in request order. `snapshot_stats` is the
/// post-reset snapshot's. `failed_bookmarks` / `failed_tags` are the colocated git export's
/// per-ref failures (never an error envelope); both are empty outside a colocated workspace.
table UntrackResult {
  mutation: MutationResult;
  num_rebased: uint;
  unmatched_paths: [string];
  snapshot_stats: SnapshotStats;
  failed_bookmarks: [GitExportFailure];
  failed_tags: [GitExportFailure];
}

/// What the implicit pre-verb snapshot did (Story 9.26) — the snapshot + colocated Git import
/// every CLI command whose helper is `workspace_helper` runs first, as facts. It rides
/// `Envelope.precondition`, never the `Payload` union.
///
/// `was_snapshot_taken`: the head operation changed during the precondition (`jj util
/// snapshot`'s own flag). `snapshot_stats`: what the snapshot could not record.
/// `git_head_imported`: an `import git head` operation was written; `git_head_reset`: the CLI's
/// "Reset the working copy parent to the new Git HEAD." (a previous HEAD existed).
/// `working_copy_immutable_new_commit`: `@` was immutable, so the snapshot created a new commit
/// on top of it. `git_refs`: the `import git refs` step, in `zanshin_git_import`'s shape —
/// PRESENT exactly when the step ran (colocated workspaces), even when it changed nothing.
/// `jjconflict_files_present`: the colocated `.jjconflict` warning. `finish`: the Git HEAD
/// resets and ref exports inside the precondition, merged; ABSENT when all at their defaults.
/// The three rebased counts saturate at 4294967295.
///
/// On an error envelope it is PARTIAL: every fact up to the failing step.
table Precondition {
  was_snapshot_taken: bool;
  snapshot_stats: SnapshotStats;
  git_head_imported: bool;
  git_head_reset: bool;
  git_head_rebased: uint;
  snapshot_rebased: uint;
  working_copy_immutable_new_commit: bool;
  git_refs: GitImportResult;
  git_refs_rebased: uint;
  jjconflict_files_present: bool;
  finish: FinishFacts;
}

union Payload {
  RepoHandle,
  Diagnostics,
  Status,
  Change,
  OpLog,
  Bookmarks,
  Remotes,
  RepoDetect,
  WatcherEvent,
  Progress,
  GraphSlice,
  // Member order IS the wire discriminant — APPEND only, never reorder.
  LogDefaults,
  MutationResult,
  AbsorbResult,
  FileList,
  FileContents,
  FileAnnotation,
  FileSearch,
  GitImportResult,
  GitExportResult,
  ShowView,
  EvologView,
  InterdiffView,
  WorkspaceList,
  WorkspaceRoot,
  TrackResult,
  UntrackResult,
}

// ── Envelope ──────────────────────────────────────────────────────────────────

/// Root FlatBuffers type for every fallible FFI call that returns composite data.
///
/// ok == true  → data is set to the concrete Payload variant; error is absent.
/// ok == false → error is set (code + context); data is absent (Payload::NONE).
///
/// Dart reads the buffer via the generated typed accessors. It is released by
/// reclaiming the exact Rust allocation through one of two equivalent paths:
/// zanshin_buffer_free(ptr, len) for synchronous call sites, or the
/// NativeFinalizer-backed token path (zanshin_buffer_free_token) used by the
/// FfiBuffer wrapper as a belt-and-suspenders backstop
/// (see app/lib/src/ffi/ffi_buffer.dart).
///
/// `precondition` (Story 9.26) is PRESENT whenever the verb's pre-verb snapshot RAN — on the ok
/// envelope and on an error envelope alike (then PARTIAL). It is ABSENT when the call was refused
/// before the verb ran (a null pointer, an invalid handle, a request buffer that fails
/// validation) and on every symbol that runs no pre-verb snapshot (open/init/clone/convert/
/// detect/close, `zanshin_workspace_root`, `zanshin_log_defaults`, events).
/// `zanshin_snapshot`'s success is `ok` with NO `data` and the precondition set.
table Envelope {
  ok: bool;
  error: FfiError;
  data: Payload;
  precondition: Precondition;
}

root_type Envelope;
