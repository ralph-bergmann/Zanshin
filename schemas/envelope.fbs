// SPDX-License-Identifier: MIT
//
// Core FFI envelope schema — the carrier for every fallible composite FFI call.
//
// Transport rule (ADR-0001):
//   fixed scalar              → plain C value
//   lone string               → *mut c_char (CString, freed by zanshin_string_free)
//   composite (table/list/…)  → FlatBuffers buffer (freed by zanshin_buffer_free)
//
// Every fallible extern "C" function that returns composite data returns an
// Envelope.  Infallible hot-path functions (zanshin_ffi_version,
// zanshin_string_free, zanshin_buffer_free) return plain types — no envelope.
//
// WIP: no in-wire schema_version field.  Breaking changes are in-place edits;
// callers update in the same PR.  Versioning discipline lands at 1.0.

namespace zanshin.ffi;

// ── Error ─────────────────────────────────────────────────────────────────────

/// Error detail carried when Envelope.ok == false.
/// error.code follows the AR-P-4 dotted-lowercase taxonomy:
///   <domain>.<reason>  (e.g. "jj.repo_not_found", "internal.panic")
/// Registry: docs/rust-error-codes.md.
/// Never put user data (paths, IDs) in code — those go in context.
table FfiError {
  code: string;
  context: string;
}

// ── Payload union ─────────────────────────────────────────────────────────────
// Closed registry of composite FFI return types.
// Extend this union — and regenerate both sides — as each noun lands:
//   Story 3-4a : RepoHandle  ✓
//   Story 3-8  : Diagnostics ✓
//   Story 3-4b : status ✓, change ✓, op_log ✓, bookmarks ✓, remotes ✓
//   Story 4-6  : GraphSlice
//   Story 5-8  : Diff
//   Story 6-5  : mutation results

/// Opaque handle to an open Repo.
/// `handle` is the Rust `*mut Repo` reinterpreted as an unsigned integer;
/// Dart passes it back verbatim to zanshin_repo_close.
table RepoHandle {
  handle: ulong;
}

/// Diagnostics payload returned by zanshin_diagnostics().
/// All three fields are compile-time or infallibly-resolved values.
table Diagnostics {
  app_version: string;
  git_sha: string;
  log_path: string;
}

/// How a working-copy file changed between @- and @.
enum ChangeKind : byte { Added, Modified, Removed, Renamed, Copied }

/// One changed file. `from_path` is set ONLY for Renamed/Copied (the source
/// path); it is absent for Added/Modified/Removed.
table FileChange {
  path: string;
  kind: ChangeKind;
  from_path: string;
}

/// Working-copy status: files changed between @ and @-, plus both change ids
/// in jj's reverse-hex display form.
table Status {
  files: [FileChange];
  working_copy_change_id: string;
  parent_change_id: string;
}

/// A commit signature: who authored/committed and when (raw jj timestamp).
table Signature {
  name: string;
  email: string;
  timestamp_millis: long;     // millis since the Unix epoch
  tz_offset_minutes: int;     // timezone offset, minutes east of UTC
}

/// Whether a change is conflict-free. `conflicted_paths` is populated only when Conflicted.
enum ConflictState : byte { Clean, Conflicted }

/// Full metadata for one change (FR-JJ-6). Authored/committed times live on the
/// author/committer signatures (authored_at == author.timestamp_millis, etc.).
table Change {
  id: string;                  // ChangeId reverse-hex (stable across rebases)
  commit_id: string;           // CommitId hex (Git SHA; changes on rebase)
  parents: [string];           // parent ChangeIds reverse-hex; empty for the root change
  description: string;         // always present, may be empty
  author: Signature;
  committer: Signature;
  is_signed: bool;             // cryptographic signature present (presence-only; 2.6 D3)
  conflict: ConflictState;
  conflicted_paths: [string];  // populated only when conflict == Conflicted
  is_anonymous: bool;
  divergent: bool;             // change id resolved to >1 visible commit (2.6 D4)
}

/// One entry in jj's operation log (FR-JJ-7).
table Operation {
  id: string;                  // op id, plain forward hex (NOT reverse-hex)
  parent_ids: [string];        // parent op ids; empty for the root op; >1 for a DAG fork
  timestamp_millis: long;      // op end-time, millis since the Unix epoch
  tz_offset_minutes: int;      // timezone offset, minutes east of UTC
  user: string;                // metadata.username; may be empty
  host: string;                // metadata.hostname; may be empty
  description: string;         // jj's user-friendly summary; always present, may be empty
  root_op: bool;               // true iff the op-store root operation
  is_snapshot: bool;           // pure working-copy-snapshot op (2.7 D6)
}

/// The operation log: reverse-chronological (head op first, root op last).
table OpLog {
  operations: [Operation];
}

/// Whether a bookmark is local-only or a tracked remote bookmark.
/// `remote_name` is populated ONLY when kind == Remote (empty for Local).
enum BookmarkKind : byte { Local, Remote }

/// One jj bookmark (FR-JJ-8). A bookmark that is both local and remote-tracked
/// appears as TWO entries: one Local, one Remote.
table Bookmark {
  name: string;          // bookmark name (UTF-8)
  target: string;        // target ChangeId, reverse-hex (stable across rebases)
  kind: BookmarkKind;
  remote_name: string;   // populated only when kind == Remote; empty for Local
}

/// The bookmark list: local + tracked-remote entries, sorted by name then kind.
table Bookmarks {
  bookmarks: [Bookmark];
}

/// One configured git remote (FR-JJ-9). `url` is the fetch URL, verbatim —
/// credentials are NOT scrubbed and SSH is NOT rewritten to HTTPS.
table Remote {
  name: string;   // remote name, e.g. "origin" (UTF-8)
  url: string;    // fetch URL, verbatim
}

/// The remote list: configured git remotes, sorted by name.
table Remotes {
  remotes: [Remote];
}

/// Classification of a path from detect_repo (FR-JJ-17).
/// Mirrors zanshin_jj::RepoKind — order must stay identical.
enum RepoKind : byte { Jj, Git, Neither, PathNotFound }

/// Result of zanshin_repo_detect.
///
/// `kind` is always set.
/// `suggested_root` and `suggested_kind` are ONLY meaningful when
/// `suggested_root` is non-null (presence == the suggestion flag, D4).
/// When kind == Neither or PathNotFound and a parent jj/git repo exists,
/// `suggested_root` is its path and `suggested_kind` its classification,
/// so the UI can offer "this folder is inside a {jj|Git} repo at <root>".
/// The backend never auto-opens; the user decides.
table RepoDetect {
  kind: RepoKind;
  suggested_root: string;
  suggested_kind: RepoKind;
}

union Payload {
  RepoHandle,
  Diagnostics,
  Status,
  Change,
  OpLog,
  Bookmarks,
  Remotes,
  RepoDetect,
}

// ── Envelope ──────────────────────────────────────────────────────────────────

/// Root FlatBuffers type for every fallible FFI call that returns composite data.
///
/// ok == true  → data is set to the concrete Payload variant; error is absent.
/// ok == false → error is set (code + context); data is absent (Payload::NONE).
///
/// Dart reads the buffer via the generated typed accessors. It is released by
/// reclaiming the exact Rust allocation through one of two equivalent paths:
/// zanshin_buffer_free(ptr, len) for synchronous call sites, or the
/// NativeFinalizer-backed token path (zanshin_buffer_free_token) used by the
/// FfiBuffer wrapper as a belt-and-suspenders backstop
/// (see app/lib/src/ffi/ffi_buffer.dart).
table Envelope {
  ok: bool;
  error: FfiError;
  data: Payload;
}

root_type Envelope;
