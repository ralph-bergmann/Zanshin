// SPDX-License-Identifier: MIT
//
// Core FFI envelope schema — the carrier for every fallible composite FFI call.
//
// Transport rule (ADR-0001):
//   fixed scalar              → plain C value
//   lone string               → *mut c_char (CString, freed by zanshin_string_free)
//   composite (table/list/…)  → FlatBuffers buffer (freed by zanshin_buffer_free)
//
// Every fallible extern "C" function that returns composite data returns an
// Envelope.  Infallible hot-path functions (zanshin_ffi_version,
// zanshin_string_free, zanshin_buffer_free) return plain types — no envelope.
//
// WIP: no in-wire schema_version field.  Breaking changes are in-place edits;
// callers update in the same PR.  Versioning discipline lands at 1.0.

namespace zanshin.ffi;

// ── Error ─────────────────────────────────────────────────────────────────────

/// Error detail carried when Envelope.ok == false.
/// error.code follows the AR-P-4 dotted-lowercase taxonomy:
///   <domain>.<reason>  (e.g. "jj.repo_not_found", "internal.panic")
/// Registry: docs/rust-error-codes.md.
/// Never put user data (paths, IDs) in code — those go in context.
table FfiError {
  code: string;
  context: string;
}

// ── Request-only tables ─────────────────────────────────────────────────────────
// NOT part of the Payload union below (that union is response-only). Dart builds
// and owns/frees these buffers itself; Rust only borrows them for the call
// (ADR-0001 composite-input pattern, Story 6-5).
//
// Field order IS the wire contract here too — a table's field ids are assigned by
// declaration order and are baked into BOTH committed codegen sides. APPEND only,
// never reorder or remove: a Dart writer and a Rust reader built from different
// field orders would silently mis-read every field after the first change.

/// A list of jj change ids (reverse-hex), passed by value for `zanshin_new_change`'s
/// `parents` and `zanshin_abandon`'s `change_ids`.
table ChangeIdList {
  change_ids: [string];
}

/// Arguments of `zanshin_restore` (Story 9.3, FR-JJ-10a).
///
/// ABSENT (null) is the wire form of "the user did not supply it", which is what
/// carries the CLI's own defaults through faithfully:
///   from / into absent  → that side is `@` (whichever ONE is supplied fixes the other)
///   all three absent    → `@` is restored from its PARENT tree (`jj restore`)
///   changes_in present  → that commit is restored from ITS parent tree; it may NOT be
///                         combined with from/into (the CLI's clap conflicts_with_all)
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths.
/// `restore_descendants` reparents children (preserving their content) instead of
/// rebasing them.
table RestoreRequest {
  from: string;
  into: string;
  changes_in: string;
  paths: [string];
  restore_descendants: bool;
}

/// Arguments of `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `from` absent → the source is `@`. `into` absent → the CLI's own `--into` default,
/// the `mutable()` ALIAS, resolved through the repo's effective config. Unlike every
/// other mutation parameter `into` is a revset EXPRESSION, not a change id: the CLI's
/// `--into` denotes a SET whose default is dynamic, and materializing it into ids would
/// destroy that meaning (FR-JJ-17).
/// `paths` behaves exactly as in RestoreRequest.
table AbsorbRequest {
  from: string;
  into: string;
  paths: [string];
}

/// Arguments of `zanshin_file_list` (Story 9.4, FR-JJ-17).
///
/// `revision` ABSENT is the wire form of "the user did not supply it", which applies the
/// CLI's own `-r` default: `@` — here the LAST-SNAPSHOTTED working-copy commit, since
/// Zanshin never snapshots (D2). It is a jj reverse-hex CHANGE ID, not a revset: `-r` is
/// `resolve_single_rev`, which refuses an ambiguous revision, so a divergent id is refused
/// rather than guessed.
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths. The
/// fileset DSL is terminal input language and is not parsed (ADR-0003).
table FileListRequest {
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_show` (Story 9.4). `revision`/`paths` as in FileListRequest,
/// except `paths` may NOT be empty — the CLI marks its FILESETS argument `required`, and an
/// empty list is `jj.invalid_input`.
table FileShowRequest {
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_annotate` (Story 9.4). `revision` as in FileListRequest.
/// `path` is a single PLAIN repo-relative path, not a prefix and not a fileset — it is
/// `parse_file_path` in the CLI too. It is REQUIRED — an absent field is refused with
/// `jj.invalid_input`, mirroring the CLI's required positional argument; an explicitly
/// present EMPTY string is a value, not an absence, and means the repository root.
table FileAnnotateRequest {
  revision: string;
  path: string;
}

/// Arguments of `zanshin_file_search` (Story 9.4). `revision`/`paths` as in
/// FileListRequest.
///
/// `pattern` is jj's own `kind:pattern` string-pattern syntax, passed through verbatim
/// (FR-JJ-17); a bare pattern defaults to kind `regex`, and the FIRST `:` separates. It is
/// REQUIRED — an absent field is refused with `jj.invalid_input`, mirroring the CLI's
/// `required = true` on `-p/--pattern`; an explicitly present EMPTY string is a value, not
/// an absence, and is the empty regex, which matches every line (`jj file search -p ""`).
/// `name_only` stops a file's scan at its first match — it changes the WORK done, not the
/// result shape, which is why it survives the terminal-UX cut that dropped `--line-number`
/// (the result always carries `SearchMatch.line_number`).
table FileSearchRequest {
  revision: string;
  pattern: string;
  paths: [string];
  name_only: bool;
}

/// Arguments of `zanshin_git_remote_add` (Story 9.5) — the CLI's `jj git remote add`.
///
/// `name` and `url` are REQUIRED; an absent field is refused with `jj.invalid_input`,
/// mirroring the CLI's two required positionals. `push_url` is null-for-absence: ABSENT
/// means the remote pushes to its fetch URL, which is git's own behaviour and the CLI's
/// `--push-url` default. Both URLs cross VERBATIM — unlike the CLI, a relative local path
/// is NOT resolved against a process CWD (a GUI backend has none worth consulting).
///
/// Adding a remote WITH a push url makes it non-removable by `zanshin_git_remote_remove`:
/// jj-lib's own `save_remote` writes a `pushurl` key, and its `remove_remote` refuses any
/// key outside `url`/`fetch`/`tagOpt` (`jj.remote_nonstandard_config`).
table GitRemoteAddRequest {
  name: string;
  url: string;
  push_url: string;
}

/// Arguments of `zanshin_git_remote_set_url` (Story 9.5) — the CLI's
/// `jj git remote set-url`.
///
/// `name` is REQUIRED. `url` (fetch) and `push_url` are BOTH null-for-absence, and absence
/// means "leave that side unchanged" — jj-lib cannot REMOVE a URL from a remote. With both
/// absent the call succeeds and does nothing, EVEN for a remote that does not exist: jj-lib
/// returns `Ok(())` in `set_remote_urls`' first two lines, before its own existence check.
/// That is mirrored deliberately; inventing a refusal there would be a divergence.
///
/// This verb never writes an operation — jj-lib takes a `&Store`, not a transaction — so
/// the returned `MutationResult.new_op_id` is always the PRE-CALL op-log head.
table GitRemoteSetUrlRequest {
  name: string;
  url: string;
  push_url: string;
}

// ── Payload union ─────────────────────────────────────────────────────────────
// Closed registry of composite FFI return types.
// Extend this union — and regenerate both sides — as each noun lands:
//   Story 3-4a : RepoHandle  ✓
//   Story 3-8  : Diagnostics ✓
//   Story 3-4b : status ✓, change ✓, op_log ✓, bookmarks ✓, remotes ✓
//   Story 3-6  : WatcherEvent ✓, Progress ✓
//   Story 4-2  : GraphSlice ✓ (FFI wrapper 4-6)
//   Story 4-9  : LogDefaults ✓
//   Story 5-8  : Diff
//   Story 6-5  : mutation results ✓
//   Story 9-3  : AbsorbResult ✓ (restore reuses MutationResult)
//   Story 9-4  : FileList ✓, FileContents ✓, FileAnnotation ✓, FileSearch ✓
//   Story 9-5  : GitImportResult ✓, GitExportResult ✓ (the four remote verbs reuse
//                MutationResult)

/// Opaque handle to an open repo session.
/// `handle` is the Rust `*mut RepoSession` reinterpreted as an unsigned integer;
/// Dart passes it back verbatim to zanshin_repo_close.
/// `session_id` is a process-unique, never-reused id allocated when the session
/// is armed; async events (WatcherEvent/Progress) carry it as their correlation
/// id. Unlike `handle` (an allocation address that a close→reopen can reuse —
/// the rawToId ABA race, resolved 2026-07-04), a session id can never be
/// misattributed to a later session.
table RepoHandle {
  handle: ulong;
  session_id: ulong;
}

/// Diagnostics payload returned by zanshin_diagnostics().
/// All three fields are compile-time or infallibly-resolved values.
table Diagnostics {
  app_version: string;
  git_sha: string;
  log_path: string;
}

/// How a working-copy file changed between @- and @.
enum ChangeKind : byte { Added, Modified, Removed, Renamed, Copied }

/// One changed file. `from_path` is set ONLY for Renamed/Copied (the source
/// path); it is absent for Added/Modified/Removed.
table FileChange {
  path: string;
  kind: ChangeKind;
  from_path: string;
}

/// Working-copy status: files changed between @ and @-, plus both change ids
/// in jj's reverse-hex display form.
table Status {
  files: [FileChange];
  working_copy_change_id: string;
  parent_change_id: string;
}

/// A commit signature: who authored/committed and when (raw jj timestamp).
table Signature {
  name: string;
  email: string;
  timestamp_millis: long;     // millis since the Unix epoch
  tz_offset_minutes: int;     // timezone offset, minutes east of UTC
}

/// Whether a change is conflict-free. `conflicted_paths` is populated only when Conflicted.
enum ConflictState : byte { Clean, Conflicted }

/// Full metadata for one change (FR-JJ-6). Authored/committed times live on the
/// author/committer signatures (authored_at == author.timestamp_millis, etc.).
table Change {
  id: string;                  // ChangeId reverse-hex (stable across rebases)
  commit_id: string;           // CommitId hex (Git SHA; changes on rebase)
  parents: [string];           // parent ChangeIds reverse-hex; empty for the root change
  description: string;         // always present, may be empty
  author: Signature;
  committer: Signature;
  is_signed: bool;             // cryptographic signature present (presence-only; 2.6 D3)
  conflict: ConflictState;
  conflicted_paths: [string];  // populated only when conflict == Conflicted
  is_anonymous: bool;
  divergent: bool;             // change id resolved to >1 visible commit (2.6 D4)
}

/// One entry in jj's operation log (FR-JJ-7).
table Operation {
  id: string;                  // op id, plain forward hex (NOT reverse-hex)
  parent_ids: [string];        // parent op ids; empty for the root op; >1 for a DAG fork
  timestamp_millis: long;      // op end-time, millis since the Unix epoch
  tz_offset_minutes: int;      // timezone offset, minutes east of UTC
  user: string;                // metadata.username; may be empty
  host: string;                // metadata.hostname; may be empty
  description: string;         // jj's user-friendly summary; always present, may be empty
  root_op: bool;               // true iff the op-store root operation
  is_snapshot: bool;           // pure working-copy-snapshot op (2.7 D6)
}

/// The operation log: reverse-chronological (head op first, root op last).
table OpLog {
  operations: [Operation];
}

/// Whether a bookmark is local-only or a tracked remote bookmark.
/// `remote_name` is populated ONLY when kind == Remote (empty for Local).
enum BookmarkKind : byte { Local, Remote }

/// One jj bookmark (FR-JJ-8). A bookmark that is both local and remote-tracked
/// appears as TWO entries: one Local, one Remote.
table Bookmark {
  name: string;          // bookmark name (UTF-8)
  target: string;        // target ChangeId, reverse-hex (stable across rebases)
  kind: BookmarkKind;
  remote_name: string;   // populated only when kind == Remote; empty for Local
}

/// The bookmark list: local + tracked-remote entries, sorted by name then kind.
table Bookmarks {
  bookmarks: [Bookmark];
}

/// One configured git remote (FR-JJ-9). `url` is the fetch URL, verbatim —
/// credentials are NOT scrubbed and SSH is NOT rewritten to HTTPS.
table Remote {
  name: string;   // remote name, e.g. "origin" (UTF-8)
  url: string;    // fetch URL, verbatim
}

/// The remote list: configured git remotes, sorted by name.
table Remotes {
  remotes: [Remote];
}

/// Classification of a path from detect_repo (FR-JJ-17).
/// Mirrors zanshin_jj::RepoKind — order must stay identical.
enum RepoKind : byte { Jj, Git, Neither, PathNotFound }

/// Result of zanshin_repo_detect.
///
/// `kind` is always set.
/// `suggested_root` and `suggested_kind` are ONLY meaningful when
/// `suggested_root` is non-null (presence == the suggestion flag, D4).
/// When kind == Neither or PathNotFound and a parent jj/git repo exists,
/// `suggested_root` is its path and `suggested_kind` its classification,
/// so the UI can offer "this folder is inside a {jj|Git} repo at <root>".
/// The backend never auto-opens; the user decides.
table RepoDetect {
  kind: RepoKind;
  suggested_root: string;
  suggested_kind: RepoKind;
}

/// Kind of async watcher event dispatched over the process-global event sink
/// (FR-FFI-4, FR-RX-1). `WatchError` is a degraded-watch signal, not a failed
/// call — the event Envelope's `ok` is always true (R5, single-emission-point:
/// the `watcher.io_error` code string is reserved for the arming-failure error
/// envelope at open/init/clone/convert).
enum WatcherEventKind : byte { OpHeadsChanged, WorkingCopyHeartbeat, WatchError }

/// One filesystem-watch event for the repo identified by `session_id`
/// (ADR-0002:57 correlation id, refined 2026-07-04: the process-unique
/// session id from `RepoHandle.session_id` — NOT the raw handle, whose
/// allocation address a close→reopen can reuse).
/// `paths` is absent for `WatchError`; `message` is set only for `WatchError`
/// (null-for-absence).
table WatcherEvent {
  session_id: uint64;
  kind: WatcherEventKind;
  paths: [string];
  message: string;
}

/// Progress notification for a long-running operation (FR-FFI-8), e.g. `git
/// fetch` (producer lands in Story 6-4a). Dispatched over the same
/// process-global event sink as `WatcherEvent`, correlated by `session_id`
/// (same never-reused id as WatcherEvent — see RepoHandle.session_id).
table Progress {
  session_id: uint64;
  operation: string;
  progress: float;
  message: string;
}

/// How a graph edge's target was classified by the revset-graph stream.
/// Mirrors zanshin_graph::EdgeKind — order must stay identical.
/// `Direct`/`Indirect` targets are in the revset (Indirect = the direct parent
/// was elided; renderers may draw it dashed); `Missing` leads outside the
/// revset and never reserves a lane.
enum GraphEdgeKind : byte { Direct, Indirect, Missing }

/// One routed parent edge of a GraphRow (Story 4.2).
/// `target_lane` is meaningful ONLY when kind != Missing (presence == the
/// kind flag, same pattern as RepoDetect.suggested_kind / Bookmark.remote_name):
/// a Missing edge never lands in a lane, so Rust writes 0 and Dart models it
/// as null. flatc 25.12.19 rejects optional scalars (`= null`) for Dart.
table GraphRowEdge {
  target: string;          // parent commit id, hex
  target_lane: uint;       // lane the edge is routed to; 0 / ignored when kind == Missing
  kind: GraphEdgeKind;
}

/// One bookmark or tag entry on a GraphRow (Story 4.8, zanshin_jj::CommitRef).
/// Mirrors the CLI's per-commit ref rendering: `name`, then `@remote` for a
/// remote entry, then `??` when conflicted or `*` when a local entry is not
/// synced. `remote` is ABSENT (Dart null) for the local entry — null-for-absence.
/// Tracked-and-synced remote entries are not emitted at all (the CLI's
/// `collect_distinct_refs` rule: `is_local() || !synced`).
table GraphCommitRef {
  name: string;            // bookmark/tag name, UTF-8
  remote: string;          // absent for the local entry
  synced: bool;
  conflicted: bool;
}

/// One lane passing vertically THROUGH a GraphRow (Story 4.8,
/// zanshin_graph::ActiveLane) — it neither starts nor ends at that row's node.
/// `kind` is the kind of the edge that opened the segment, so a renderer can
/// style it without reading any neighbouring row; the color is lane % PALETTE_SIZE.
table GraphActiveLane {
  lane: uint;
  kind: GraphEdgeKind;
}

/// `jj log`-parity display metadata for one commit row (Story 4.8,
/// zanshin_jj::CommitMeta), extracted from the SAME head-resolved snapshot as the
/// lane assignment. Ids are full; the `*_prefix_len` fields are the
/// shortest-unique-prefix lengths the UI highlights.
///
/// `change_offset` is meaningful ONLY when has_change_offset == true (presence
/// pair, same pattern as GraphRowEdge.target_lane: flatc 25.12.19 rejects
/// optional scalars for Dart). The CLI renders `/<offset>` only for
/// hidden/divergent commits — that is a UI decision, reproducible from the flags.
table GraphRowMeta {
  change_id: string;                 // ChangeId reverse-hex display form
  change_id_prefix_len: uint;
  commit_id_prefix_len: uint;
  change_offset: uint;               // 0 / ignored when has_change_offset == false
  has_change_offset: bool;
  author_name: string;               // may be empty (jj allows it)
  author_email: string;              // may be empty (jj allows it)
  committer_timestamp_millis: long;  // committer timestamp, millis since the Unix epoch
  committer_tz_offset_minutes: int;  // timezone offset, minutes east of UTC
  bookmarks: [GraphCommitRef];
  tags: [GraphCommitRef];
  working_copies: [string];          // EVERY workspace whose wc commit this is (incl. the current one); empty in a single-workspace repo (the CLI's guard)
  working_copy: bool;                // this workspace's @
  immutable: bool;                   // in ::(immutable_heads() | root())
  conflict: bool;
  empty: bool;
  hidden: bool;
  divergent: bool;
  root: bool;
  description_first_line: string;    // "" when the description is empty
}

/// One lane-assigned commit row (zanshin_graph::Row). Rows carry a COMMIT id,
/// never a change id (change ids are ambiguous for divergent changes).
///
/// `synthetic_elided` marks the synthetic "(elided revisions)" row the CLI
/// splices for an elided ancestor (`ui.log-synthetic-elided-nodes`): its
/// `commit_id` is the ELIDED TARGET's id, its lane fields are real, and `meta`
/// is ABSENT (Dart null — a nested table is the only shape flatc 25.12.19 lets
/// Dart see as null). On a commit row `meta` is always present.
///
/// Consequence: with synthetic elided rows ON (the default) `commit_id` is NOT
/// unique across rows — the synthetic row and the real commit it stands for
/// share it, and a child's GraphRowEdge.target names that id with no synthetic
/// marker. A synthetic row always sits IMMEDIATELY after the child that elided
/// to it, and `lane` / `target_lane` are the linkage. Do not use `commit_id`
/// alone as a row key.
table GraphRow {
  commit_id: string;               // commit id, hex
  lane: uint;                      // lane this commit was placed on
  color_idx: uint;                 // deterministic palette index, lane % PALETTE_SIZE
  edges: [GraphRowEdge];           // one per input parent edge, same order
  active_lanes: [GraphActiveLane]; // pass-through lanes, ascending; always present
  synthetic_elided: bool;
  meta: GraphRowMeta;              // absent iff synthetic_elided
}

/// A slice of the lane-assigned commit graph, in stream (`jj log`) order.
/// Return-all semantics (Story 4.4): total_rows == rows.length. Windowing is
/// deferred past WIP; if it lands later it may set total_rows > rows.length.
table GraphSlice {
  rows: [GraphRow];        // one per Row, stream order; always present (empty for an empty slice)
  total_rows: uint;        // == rows.length in WIP (see table doc)
}

/// The repo's EFFECTIVE `jj log` defaults (Story 4.9) — what the user's own jj
/// CLI would apply, after their `[revsets]` / `[ui]` config overrides.
///
/// Offered as pre-fills for zanshin_graph_slice's pass-through parameters
/// (FR-JJ-17); nothing is applied silently, the caller decides. `short_prefixes`
/// falls back to `log` when `revsets.short-prefixes` is ABSENT; an explicit
/// empty string means disambiguation is DISABLED and is returned verbatim.
table LogDefaults {
  log: string;                  // revsets.log
  log_graph_prioritize: string; // revsets.log-graph-prioritize
  short_prefixes: string;       // revsets.short-prefixes (falls back to log on absence)
  synthetic_elided: bool;       // ui.log-synthetic-elided-nodes
}

/// Outcome of a successful mutation (Story 6-1/6-2/6-4a, FR-JJ-10a/FR-JJ-13/FR-JJ-14a):
/// `zanshin_describe`/`_new_change`/`_edit`/`_abandon`/`_undo`/`_git_fetch`.
/// `new_change_ids` / `abandoned_change_ids` are empty when the mutation mints
/// or abandons nothing (see `zanshin_jj::MutationResult`'s field docs for the
/// per-verb rules).
table MutationResult {
  new_op_id: string;
  new_change_ids: [string];
  abandoned_change_ids: [string];
  working_copy_change_id: string;
}

/// One path an operation could not process, with the verbatim reason.
///
/// Two payloads carry it: `AbsorbResult.skipped_paths` — a path jj-lib refused to split
/// ("Is a symlink", "Is a conflict", "Is a Git submodule", "Access is denied: …") — and
/// `FileContents.skipped` — a path that is not renderable as file content
/// ("Path '…' exists but is not a file.", "Path '…' exists but access is denied: …",
/// "Path '…' is absent.", "Path '…' is a directory." — the last two are the cases the CLI
/// `panic!`s on, which a library reports instead of aborting the process). In both cases
/// the call SUCCEEDS for the remaining paths; the CLI prints one warning per entry.
table SkippedPath {
  path: string;      // repo-relative, jj's internal `/`-separated form
  reason: string;    // the CLI's / jj-lib's own message, forwarded unchanged
}

/// Outcome of a successful `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has
/// one definition; its `new_change_ids` / `abandoned_change_ids` are always empty here.
/// An EMPTY `rewritten_change_ids` means nothing was absorbable — and then no operation
/// was written either, so `mutation.new_op_id` is the PRE-CALL op-log head.
/// `source_change_id` is ABSENT when jj-lib abandoned the source (it became discardable)
/// or when nothing moved — null-for-absence.
/// `num_rebased` excludes the destination commits and includes the rewritten source
/// (jj-lib's own `AbsorbStats::num_rebased` accounting). jj-lib counts in `usize`; a
/// count above `uint`'s range SATURATES at 4294967295 rather than wrapping — it is a
/// progress figure for the UI, never something a decision keys off.
table AbsorbResult {
  mutation: MutationResult;
  rewritten_change_ids: [string];   // destination ChangeIds, reverse-hex, forward topological order
  source_change_id: string;         // absent when the source was abandoned or nothing moved
  num_rebased: uint;
  skipped_paths: [SkippedPath];
}

/// What a tree entry IS (Story 9.4) — the CLI's `TreeEntry.file_type` keyword
/// (`cli/src/commit_templater.rs::describe_file_type` @ v0.44.0).
/// `Tree` is UNREACHABLE through `zanshin_file_list` (jj-lib's `entries_matching` recurses
/// into subtrees rather than yielding them) but is modelled so the mapping is total. jj's
/// sixth case — an ABSENT entry, rendered as `""` — is never emitted and has no member.
// Member order IS the wire value (File == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `union Payload` below.
enum FileType : byte { File, Symlink, Tree, GitSubmodule, Conflict }

/// One entry of a revision's tree (Story 9.4), modelled on the CLI's `TreeEntry` keywords.
///
/// The CLI's `conflict` keyword (`!value.is_resolved()`) has no field of its own: it is
/// exactly `file_type == Conflict`, so carrying it too would be a second, desyncable
/// spelling of one fact.
/// `executable` is false for a symlink, a submodule, and a conflict whose sides disagree
/// about the bit (the CLI's `unwrap_or_default()`). `conflict_side_count` is the SIMPLIFIED
/// merge's side count: 1 for a resolved entry, >= 2 for a conflict (`Merge::num_sides()` is
/// `values.len() / 2 + 1`, so the smallest conflict has two sides); it saturates at
/// 4294967295. A subtree that CONFLICTS with a non-tree is emitted as one entry with
/// file_type == Conflict and is not descended into — render it as an opaque conflict, not
/// an empty directory.
table FileEntry {
  path: string;                // repo-relative, jj's internal `/`-separated form
  file_type: FileType;
  executable: bool;
  conflict_side_count: uint;
}

/// The entries of a revision's tree, in jj-lib's own `entries_matching` (tree) order.
table FileList {
  entries: [FileEntry];
}

/// One file's content as `jj file show` would print it (Story 9.4).
///
/// `content` is `[ubyte]`, not `string`: a tracked file is not guaranteed UTF-8. For a
/// conflicted path it is the MATERIALIZED merge, with markers in the style the repo's
/// EFFECTIVE `ui.conflict-marker-style` selects (re-read per call, never cached).
table ShownFile {
  path: string;
  content: [ubyte];
  conflict: bool;
}

/// The result of `zanshin_file_show` (Story 9.4): the files that could be rendered, plus
/// the paths that could not — a symlink, a Git submodule, an unreadable blob, and the two
/// cases the CLI `panic!`s on rather than reports (an absent value, a bare directory). A
/// skipped path does NOT fail the call — the CLI prints a warning per entry and keeps
/// going. Every reason string is listed on SkippedPath.
table FileContents {
  files: [ShownFile];
  skipped: [SkippedPath];
}

/// One annotated line of a file (Story 9.4) — `jj file annotate`'s per-line row.
///
/// `original_line_number` is 1-BASED: jj-lib reports it 0-based and the CLI adds 1. There is
/// deliberately no `line_number` field — a line's own number is its 1-based index in
/// `FileAnnotation.lines`. `origin_found` is false when the search stopped at the domain
/// boundary and `commit_id` is only where it stopped; the CLI collapses that case to the
/// root commit for display, this payload keeps the distinction.
table AnnotationLine {
  commit_id: string;           // CommitId hex of the originating commit
  change_id: string;           // that commit's ChangeId, reverse-hex
  original_line_number: uint;  // 1-based, in the ORIGINATING commit's version; saturates at 4294967295
  content: [ubyte];            // the raw line, newline included when the source had one
  origin_found: bool;
}

/// A file's annotation: one entry per line, in file order.
table FileAnnotation {
  lines: [AnnotationLine];
}

/// One matching line of `zanshin_file_search` (Story 9.4).
///
/// `line_number` is 1-based within the searched content. `conflict_side` is meaningful ONLY
/// when has_conflict_side == true (presence pair, same rule as GraphRowMeta.change_offset:
/// flatc 25.12.19 rejects optional scalars for Dart); it is the 0-based side of a conflicted
/// path, whose line numbers restart at each side — there is no meaningful unified numbering
/// across sides (the CLI's own reasoning at `search.rs:146-147`).
table SearchMatch {
  path: string;
  line_number: uint;           // saturates at 4294967295, as conflict_side does
  content: [ubyte];            // the raw matching line, newline included
  conflict_side: uint;         // 0 / ignored when has_conflict_side == false
  has_conflict_side: bool;
}

/// The matches of `zanshin_file_search`, in `entries_matching` (tree) order then line order.
table FileSearch {
  matches: [SearchMatch];
}

/// How one remote ref changed during `zanshin_git_import` (Story 9.5) — the CLI's own
/// derivation from `(old_remote_ref.target.is_absent(), new_target.is_absent())`
/// (`cli/src/git_util.rs:418-425` @ v0.44.0).
// Member order IS the wire value (New == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `FileType` above and `union Payload` below.
enum GitRefUpdateKind : byte { New, Updated, Deleted }

/// One remote bookmark or tag `zanshin_git_import` changed (Story 9.5).
///
/// These are the four facts the CLI renders per line
/// (`"{label}: {symbol} [{import_status}] {tracking_status}"`); the column padding and the
/// colouring are the terminal UX Zanshin replaces. `tracked` is read from the POST-import
/// view, not from the old remote ref — a freshly-imported ref's tracking state is decided
/// during the import itself.
table GitRefUpdate {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to, e.g. "origin"
  kind: GitRefUpdateKind;
  tracked: bool;
}

/// Outcome of a successful `zanshin_git_import` (Story 9.5) — the CLI's `jj git import`.
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has one
/// definition (the `AbsorbResult` precedent); its `new_change_ids` /
/// `abandoned_change_ids` are always empty here — an import's own abandonments are
/// `abandoned_change_ids` on THIS table, a different fact from the caller-supplied id list
/// `MutationResult.abandoned_change_ids` echoes for `zanshin_abandon`.
///
/// If nothing needed importing NO operation was written, and `mutation.new_op_id` is the
/// PRE-CALL op-log head. `failed_ref_names` is still reported in that case: a run where
/// every pending ref failed changes nothing yet must say so, and nothing in the repository
/// state lets a caller re-derive the list afterwards. A failed ref is NEVER an error — the
/// CLI warns and exits 0. Names are lossy-UTF-8 (a git ref name is not guaranteed UTF-8);
/// one under `refs/remotes/git/` is the reserved-namespace case.
///
/// `num_rewritten` is a plain COUNT because a count is all the CLI reports
/// ("Updated {n} rewritten commits."); it saturates at 4294967295, as `AbsorbResult`'s own
/// count does.
table GitImportResult {
  mutation: MutationResult;
  changed_bookmarks: [GitRefUpdate];
  changed_tags: [GitRefUpdate];
  abandoned_change_ids: [string];   // ChangeIds, reverse-hex, of commits unreachable in git
  num_rewritten: uint;
  failed_ref_names: [string];
}

/// One remote ref `zanshin_git_export` could not write to git (Story 9.5).
///
/// `reason` is jj-lib's own reason rendered as the FLATTENED `source()` chain joined by
/// `": "`, exactly as the CLI prints it: the two interesting variants
/// (`FailedToDelete`/`FailedToSet`) hide the real cause behind `#[source]`, so the
/// top-level message alone would say only "Failed to set".
table GitExportFailure {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to; "git" for the local git repo's own refs
  reason: string;
}

/// Outcome of a successful `zanshin_git_export` (Story 9.5) — the CLI's `jj git export`.
///
/// `mutation` is NESTED for the same reason as in `GitImportResult`; export never moves `@`
/// and never mints or abandons a change, so its two id vectors are always empty. If git
/// already matched, NO operation was written and `mutation.new_op_id` is the PRE-CALL
/// op-log head.
///
/// Failed refs ride in the RESULT, never as an error envelope: the CLI warns and exits 0,
/// and an export whose only outcome is a failure list must still be readable. The classic
/// case is two bookmarks named `foo` and `foo/bar`, which git cannot both hold.
/// `failed_tags` only ever contains `@git` tags — git has no remote tags.
table GitExportResult {
  mutation: MutationResult;
  failed_bookmarks: [GitExportFailure];
  failed_tags: [GitExportFailure];
}

union Payload {
  RepoHandle,
  Diagnostics,
  Status,
  Change,
  OpLog,
  Bookmarks,
  Remotes,
  RepoDetect,
  WatcherEvent,
  Progress,
  GraphSlice,
  // Member order IS the wire discriminant — APPEND only, never reorder.
  LogDefaults,
  MutationResult,
  AbsorbResult,
  FileList,
  FileContents,
  FileAnnotation,
  FileSearch,
  GitImportResult,
  GitExportResult,
}

// ── Envelope ──────────────────────────────────────────────────────────────────

/// Root FlatBuffers type for every fallible FFI call that returns composite data.
///
/// ok == true  → data is set to the concrete Payload variant; error is absent.
/// ok == false → error is set (code + context); data is absent (Payload::NONE).
///
/// Dart reads the buffer via the generated typed accessors. It is released by
/// reclaiming the exact Rust allocation through one of two equivalent paths:
/// zanshin_buffer_free(ptr, len) for synchronous call sites, or the
/// NativeFinalizer-backed token path (zanshin_buffer_free_token) used by the
/// FfiBuffer wrapper as a belt-and-suspenders backstop
/// (see app/lib/src/ffi/ffi_buffer.dart).
table Envelope {
  ok: bool;
  error: FfiError;
  data: Payload;
}

root_type Envelope;
