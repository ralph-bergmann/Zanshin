// SPDX-License-Identifier: MIT
//
// Core FFI envelope schema — the carrier for every fallible composite FFI call.
//
// Transport rule (ADR-0001):
//   fixed scalar              → plain C value
//   lone string               → *mut c_char (CString, freed by zanshin_string_free)
//   composite (table/list/…)  → FlatBuffers buffer (freed by zanshin_buffer_free)
//
// Every fallible extern "C" function that returns composite data returns an
// Envelope.  Infallible hot-path functions (zanshin_ffi_version,
// zanshin_string_free, zanshin_buffer_free) return plain types — no envelope.
//
// WIP: no in-wire schema_version field.  Breaking changes are in-place edits;
// callers update in the same PR.  Versioning discipline lands at 1.0.

namespace zanshin.ffi;

// ── Error ─────────────────────────────────────────────────────────────────────

/// Error detail carried when Envelope.ok == false.
/// error.code follows the AR-P-4 dotted-lowercase taxonomy:
///   <domain>.<reason>  (e.g. "jj.repo_not_found", "internal.panic")
/// Registry: docs/rust-error-codes.md.
/// Never put user data (paths, IDs) in code — those go in context.
///
/// hints (Story 9.56): the jj CLI's hint lines for this refusal, verbatim (a line may itself
/// hold newlines, as the CLI's `add_hint` text does) and in the CLI's order. Absent = none —
/// an error without hints writes no field. context never holds in-band "Hint:" text.
///
/// left_behind (Stories 9.57/9.58): the paths a FAILED creation — `zanshin_repo_init` or
/// `zanshin_repo_convert` — created and left on disk, outermost first: the destination the
/// call created (an existing one is reused and never listed), then the workspace's `.jj/` (only
/// when the call's jj-lib creation succeeded), then — for a new colocated init — the `.git/`
/// jj-lib created, each only when it still exists. A later entry may lie inside an earlier one
/// (the created destination and its `.jj/` / `.git/`). The paths are canonical. Nothing is
/// deleted on a failure (the disk is as `jj git init` leaves it); the UI may offer the decision.
/// A failure after the `trunk()` alias step also leaves `<config_dir>/jj/repos/<config-id>/`;
/// it is not listed. A `watcher.io_error` comes after a successful creation and
/// carries none: the repository is complete. Absent = none — every other error, and the
/// `internal.panic` fallback, writes no field.
table FfiError {
  code: string;
  context: string;
  hints: [string];
  left_behind: [string];
}

// ── Request-only tables ─────────────────────────────────────────────────────────
// NOT part of the Payload union below (that union is response-only). Dart builds
// and owns/frees these buffers itself; Rust only borrows them for the call
// (ADR-0001 composite-input pattern, Story 6-5).
//
// Field order IS the wire contract here too — a table's field ids are assigned by
// declaration order and are baked into BOTH committed codegen sides. `kind` is
// ALWAYS field 0 of a request table and a NEW field is APPENDED after the existing
// ones; any other change to a request table's field order is an in-place WIP edit
// (no `id:` attribute, no `_v2` table, no in-wire schema version) that MUST
// regenerate BOTH committed codegen sides in the SAME commit — a Dart writer and a
// Rust reader built from different field orders would silently mis-read every field
// after the first change.
//
// A UNION field costs TWO vtable slots, not one: flatc expands `x: SomeUnion` into a
// hidden `x_type` discriminant byte followed by the value offset, so it shifts every
// LATER field's id by two. Changing a scalar/string field into a union is therefore an
// in-place WIP edit under exactly the rule above, and the member tables plus the union
// itself must be declared BEFORE the table that uses them.

/// Which `extern "C"` wrapper a request buffer was built FOR.
///
/// Every request table carries this as field 0, and every wrapper refuses a buffer whose
/// `kind` is not its own — before the handle lookup and before any other field is read.
/// Without it a buffer built for one verb VERIFIES as another verb's table — nothing in the
/// `FlatBuffers` layer tells them apart — so a `BookmarkCreateRequest` fed to
/// `zanshin_bookmark_delete` would silently glob-delete names the caller meant literally.
///
/// The tag is per-WRAPPER, not per-table: `ChangeIdList` is read by THREE wrappers, as
/// `zanshin_new_change`'s `parents` (plus its `insert_after` / `insert_before`, which only
/// `NewChange` reads — Story 9.48), as `zanshin_abandon`'s `change_ids` and as
/// `zanshin_parallelize`'s revisions (Story 9.16), so it carries the three kinds `NewChange`,
/// `Abandon` and `Parallelize` — mis-routing there abandons the commits the caller named as
/// parents. `SquashRequest` is read by two wrappers as well — `zanshin_squash` and
/// `zanshin_squash_plan` (Story 9.15) — but carries ONE kind, `Squash`: the plan previews the
/// very squash its caller is about to run, so a mis-routed buffer runs or previews the same
/// squash, never a different verb. For the other 46 tables the variant name plus `Request` IS
/// the table name.
///
/// `Unspecified = 0` is `FlatBuffers`' default for an ABSENT field, so a buffer built by a
/// producer that never sets `kind` is byte-identical to a pre-tag buffer, decodes as
/// `Unspecified`, and is ALWAYS refused. Nothing untagged is ever silently accepted.
///
/// Member order IS the wire value (no explicit numbers) — APPEND only, never reorder or remove:
/// a reordered variant re-tags every buffer the other side already builds.
enum RequestKind : ubyte {
  Unspecified,
  Restore,
  Absorb,
  NewChange,
  Abandon,
  FileList,
  FileShow,
  FileAnnotate,
  FileSearch,
  GitRemoteAdd,
  GitRemoteSetUrl,
  Show,
  Evolog,
  Interdiff,
  WorkspaceRoot,
  BookmarkCreate,
  BookmarkDelete,
  FileTrack,
  FileUntrack,
  ConfigList,
  ConfigGet,
  ConfigPath,
  ConfigSet,
  ConfigUnset,
  ConfigFileRead,
  ConfigFileWrite,
  ConfigGcList,
  ConfigGcDelete,
  EnvironmentAdopt,
  CommitContents,
  GraphTopology,
  WorkspaceAdd,
  Squash,
  Split,
  Commit,
  GitPush,
  RepoClone,
  RepoInit,
  GitFetch,
  DropActions,
  Rebase,
  Parallelize,
  Arrange,
  Metaedit,
  Duplicate,
  Fix,
  BookmarkList,
  BookmarkMove,
  BookmarkAdvance,
  BookmarkRename,
  SelectTree,
  OpShow,
  OpDiff,
  OpRestore,
  OpRevert
}

/// A list of jj change ids (reverse-hex), passed by value for `zanshin_new_change`'s
/// `parents`, `zanshin_abandon`'s `change_ids` and `zanshin_parallelize`'s revisions (Story
/// 9.16). `kind` therefore distinguishes the three wrappers: `NewChange`, `Abandon` or
/// `Parallelize`.
///
/// `insert_after` / `insert_before` (Story 9.48) are read ONLY by `zanshin_new_change`: the
/// CLI's `jj new -A` / `-B` targets. ABSENT or empty means the flag was not given;
/// `zanshin_abandon` and `zanshin_parallelize` ignore both.
table ChangeIdList {
  kind: RequestKind;
  change_ids: [string];
  insert_after: [string];
  insert_before: [string];
}

/// Arguments of `zanshin_restore` (Story 9.3, FR-JJ-10a).
///
/// ABSENT (null) is the wire form of "the user did not supply it", which is what
/// carries the CLI's own defaults through faithfully:
///   from / into absent  → that side is `@` (whichever ONE is supplied fixes the other)
///   all three absent    → `@` is restored from its PARENT tree (`jj restore`)
///   changes_in present  → that commit is restored from ITS parent tree; it may NOT be
///                         combined with from/into (the CLI's clap conflicts_with_all)
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths.
/// `restore_descendants` reparents children (preserving their content) instead of
/// rebasing them.
table RestoreRequest {
  kind: RequestKind;
  from: string;
  into: string;
  changes_in: string;
  paths: [string];
  restore_descendants: bool;
}

/// Arguments of `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `from` absent → the source is `@`. `into` absent → the CLI's own `--into` default,
/// the `mutable()` ALIAS, resolved through the repo's effective config. Unlike every
/// other mutation parameter `into` is a revset EXPRESSION, not a change id: the CLI's
/// `--into` denotes a SET whose default is dynamic, and materializing it into ids would
/// destroy that meaning (FR-JJ-17).
/// `paths` behaves exactly as in RestoreRequest.
table AbsorbRequest {
  kind: RequestKind;
  from: string;
  into: string;
  paths: [string];
}

/// One changed section of a file, by where it sits on each side in lines (Story 9.50) — the
/// builtin diff editor's sections (`ContentDiff::by_line`). `old_start` / `new_start`: 0-based
/// index of the section's first line on the left (parent) / right (revision) side; `old_count` /
/// `new_count`: its lines there (an insertion has `old_count` 0, a deletion `new_count` 0). Lines
/// are cut like `split_inclusive('\n')`: a last line without `\n` counts.
table HunkKey {
  old_start: uint;
  old_count: uint;
  new_start: uint;
  new_count: uint;
}

/// One file of a `SelectTreeRequest` (Story 9.50). `path` is repo-relative in jj's internal
/// `/`-separated form (what `ShowEntry.file_changes` reports). `whole` selects the revision's
/// value at that path, whatever the change; otherwise `hunks` lists the selected sections (absent
/// or empty: nothing of the file). `whole` together with `hunks` is refused (`jj.invalid_input`).
table FileSelection {
  path: string;
  whole: bool;
  hunks: [HunkKey];
}

/// Arguments of `zanshin_select_tree` (Story 9.50) — a hunk selection, applied as the CLI's
/// builtin diff editor applies a choice.
///
///   revision           jj reverse-hex change id; absent → `@`
///   left               the revision's parent tree the selection was made against, hex tree ids
///                      in order — `ShowEntry.parent_tree_ids`; stale (`jj.stale_selection`)
///                      when the revision's parent tree is no longer this
///   files              the selected files; a changed file not listed keeps its left side; each
///                      path at most once
table SelectTreeRequest {
  kind: RequestKind;
  revision: string;
  left: [string];
  files: [FileSelection];
}

/// A tree arm's selection (Story 9.50): the tree `zanshin_select_tree` returned (`tree_ids`,
/// `labels` exactly as its `SelectedTree` payload carries them) and the `left` it was selected
/// against. The verb refuses `jj.stale_selection` when the source's parent tree is no longer
/// `left`.
table TreeSelection {
  tree_ids: [string];
  labels: [string];
  left: [string];
}

/// One squash source's selected tree (Story 9.50): `source` a jj reverse-hex change id.
table SourceTree {
  source: string;
  tree: TreeSelection;
}

/// Arguments of `zanshin_squash` AND `zanshin_squash_plan` (Story 9.15) — the CLI's `jj squash`
/// flags, one field each; change ids are jj reverse-hex.
///
///   revision           absent → with from/into absent too, `@` into its one parent; may NOT be
///                      combined with from/into (clap's conflicts_with)
///   from               absent/empty → with `into` present, `@`
///   into               absent → with `from` non-empty, `@`
///   paths              repo-relative PREFIXES; empty/absent = every path
///   message            the CLI's repeatable `-m`; ABSENT = no `-m` (the editor case writes the
///                      buffer saved unchanged), present-empty = `-m` given with no paragraph
///   use_destination_message, keep_emptied   the CLI's `-u` / `-k`
///   edited_description the text the user edited the squashed description to (Story 9.54) — the
///                      CLI's `--editor` whose editor saves exactly this text: the description
///                      step runs as with the editor (trailers, the draft template, their refusals
///                      and warnings), then this text is written cleaned up like a saved buffer,
///                      with NO trailers added. ABSENT = no editor. With `message` refused
///                      (`jj.invalid_input`, "--message cannot be used with an edited
///                      description"; `zanshin_squash_plan` too); `zanshin_squash_plan` otherwise
///                      ignores it.
///   trees              the tree arm (Story 9.50): per source, the tree selected against that
///                      source's parent tree; a source without one moves everything. Absent or
///                      empty = the paths arm; non-empty with `paths` refused (`jj.invalid_input`,
///                      before the snapshot), as is an entry naming no source or two naming one.
table SquashRequest {
  kind: RequestKind;
  revision: string;
  from: [string];
  into: string;
  paths: [string];
  message: [string];
  use_destination_message: bool;
  keep_emptied: bool;
  edited_description: string;
  trees: [SourceTree];
}

/// Arguments of `zanshin_split` (Story 9.15) — the CLI's `jj split` flags, one field each;
/// change ids are jj reverse-hex.
///
///   revision           absent → `@` (the CLI's default)
///   paths              repo-relative PREFIXES; neither paths nor `tree` (the CLI's interactive
///                      diff editor) is refused as `jj.invalid_input`
///   message            the CLI's `-m` for the SELECTED commit; ABSENT = no `-m` (both commits
///                      get what the CLI's editor holds saved unchanged: their description with
///                      `templates.commit_trailers` added, rendered through
///                      `templates.draft_commit_description` — `default_commit_description` for an
///                      undescribed target; Story 9.51)
///   parallel           `--parallel`; may NOT be combined with a location
///   onto / insert_after / insert_before   the CLI's `-o` / `-A` / `-B`: ABSENT = the flag not
///                      given, present-EMPTY = given with no revision (refused: no parent)
///   edited_selected_description, edited_remaining_description   the texts the user edited the
///                      two descriptions to (Story 9.54) — the CLI's bulk editor saving exactly
///                      these two sections: the no-`message` editor path runs unchanged, then each
///                      commit gets its text cleaned up like a saved section, with NO trailers
///                      added. Both or neither (one alone: `jj.invalid_input`, "an edited split
///                      needs both descriptions: the selected and the remaining"); with `message`
///                      refused (`jj.invalid_input`, "--message cannot be used with an edited
///                      description").
///   tree               the tree arm (Story 9.50): the SELECTED commit's tree, selected against
///                      the target's parent tree; absent = the paths arm; with `paths` refused
///                      (`jj.invalid_input`, before the snapshot)
table SplitRequest {
  kind: RequestKind;
  revision: string;
  paths: [string];
  message: [string];
  parallel: bool;
  onto: [string];
  insert_after: [string];
  insert_before: [string];
  edited_selected_description: string;
  edited_remaining_description: string;
  tree: TreeSelection;
}

/// Arguments of `zanshin_rebase` (Story 9.16) — the CLI's `jj rebase` flags, one field each;
/// change ids are jj reverse-hex. ABSENT or EMPTY is the flag not given.
///
///   branch / source / revisions   the CLI's `-b` / `-s` / `-r`: at most one given (else
///                      `jj.invalid_input`); none of the three is the CLI's default `-b @`
///   onto / insert_after / insert_before   the CLI's `-o` / `-A` / `-B`: at least one given, and
///                      `onto` excludes the other two (else `jj.invalid_input`)
///   skip_emptied, keep_divergent, simplify_parents   the CLI's `--skip-emptied` /
///                      `--keep-divergent` / `--simplify-parents`
table RebaseRequest {
  kind: RequestKind;
  branch: [string];
  source: [string];
  revisions: [string];
  onto: [string];
  insert_after: [string];
  insert_before: [string];
  skip_emptied: bool;
  keep_divergent: bool;
  simplify_parents: bool;
}

/// One of the `jj arrange` TUI's key actions (Story 9.16): swap with the one parent (`J`) / the
/// one child (`K`), abandon (`a`), keep (`p`). `Unspecified = 0` is the default of an ABSENT
/// `kind` and is always refused (`ffi.invalid_argument`), so a forgotten kind never decodes as a
/// swap. Member order IS the wire value — APPEND only.
enum ArrangeActionKind : byte { Unspecified, SwapDown, SwapUp, Abandon, Keep }

/// One entry of `ArrangeRequest`'s `actions`: `kind` on the commit of `change_id` (jj
/// reverse-hex, required — absent is `jj.invalid_input` "change_id is required"). A nested
/// value, never a buffer root: it carries no `RequestKind`.
table ArrangeAction {
  kind: ArrangeActionKind;
  change_id: string;
}

/// Arguments of `zanshin_arrange` (Story 9.16) — the CLI's `jj arrange [REVSETS]` with its TUI
/// session as data.
///
///   revisions          change ids (jj reverse-hex); ABSENT or EMPTY = the `revsets.arrange`
///                      setting (jj's default `reachable(@, mutable())`)
///   actions            the TUI's key actions, replayed in order; ABSENT or EMPTY changes nothing
table ArrangeRequest {
  kind: RequestKind;
  revisions: [string];
  actions: [ArrangeAction];
}

/// Arguments of `zanshin_metaedit` (Story 9.9) — the CLI's `jj metaedit` flags, one field each.
///
///   revisions          change ids (jj reverse-hex); ABSENT or EMPTY = the CLI's default `@`
///   update_change_id   `--update-change-id`
///   message            the CLI's repeatable `-m`: ABSENT = no `-m` (the description stays),
///                      present = the paragraphs, joined as the CLI joins them; present but
///                      EMPTY joins to "" = `-m ""` (clears every target's description)
///   update_author_timestamp / update_author / force_rewrite   the CLI's
///                      `--update-author-timestamp` / `--update-author` / `--force-rewrite`
///   author             `--author`, the CLI's `Name <email>` string; ABSENT = not given
///   author_timestamp   `--author-timestamp`, RFC 2822 or RFC 3339; ABSENT = not given
///
/// A malformed `author` / `author_timestamp`, `author` with `update_author`, or
/// `author_timestamp` with `update_author_timestamp` is clap's refusal (`jj.invalid_input`),
/// before the snapshot.
table MetaeditRequest {
  kind: RequestKind;
  revisions: [string];
  update_change_id: bool;
  message: [string];
  update_author_timestamp: bool;
  update_author: bool;
  author: string;
  author_timestamp: string;
  force_rewrite: bool;
}

/// Arguments of `zanshin_duplicate` (Story 9.9) — the CLI's `jj duplicate` flags; change ids are
/// jj reverse-hex. ABSENT or EMPTY is the flag not given.
///
///   revisions          ABSENT or EMPTY = the CLI's default `@`
///   onto / insert_after / insert_before   the CLI's `-o` / `-A` / `-B`; none = each duplicate
///                      onto its original's parents; `onto` excludes the other two (else
///                      `jj.invalid_input`, before the snapshot)
table DuplicateRequest {
  kind: RequestKind;
  revisions: [string];
  onto: [string];
  insert_after: [string];
  insert_before: [string];
}

/// Arguments of `zanshin_fix` (Story 9.9) — the CLI's `jj fix` flags.
///
///   source             `-s`, change ids (jj reverse-hex); ABSENT or EMPTY = the `revsets.fix`
///                      setting (jj's default `reachable(@, mutable())`)
///   paths              repo-relative PREFIXES to fix; ABSENT or EMPTY = every path
///   include_unchanged_files / all_lines   the CLI's `--include-unchanged-files` / `--all-lines`
table FixRequest {
  kind: RequestKind;
  source: [string];
  paths: [string];
  include_unchanged_files: bool;
  all_lines: bool;
}

/// Arguments of `zanshin_commit` (Story 9.49) — the CLI's `jj commit -m <message> [paths]`.
///
///   paths              repo-relative PREFIXES of the changes the committed `@` keeps;
///                      empty/absent = every change (the CLI's "describe + new")
///   message            the CLI's repeatable `-m`, optional on the wire: empty/absent = `-m ""`
///   tree               the tree arm (Story 9.50): the committed `@`'s tree, selected against
///                      `@`'s parent tree; absent = the paths arm; with `paths` refused
///                      (`jj.invalid_input`, before the snapshot)
table CommitRequest {
  kind: RequestKind;
  paths: [string];
  message: [string];
  tree: TreeSelection;
}

/// Arguments of `zanshin_git_push` (Story 9.20) — the CLI's `jj git push` flags, one field each,
/// passed through (FR-JJ-17). Bookmark, tag and remote names are PATTERNS as in the CLI (a bare
/// word is a glob, `exact:<name>` matches only itself); revisions are revsets.
///
///   remotes            `--remote`; ABSENT = the flag not given (`git.push`, else the only remote,
///                      else `origin`), present-empty = given with no pattern
///   bookmarks / tags / revisions / changes / named   `-b` / `-t` / `-r` / `-c` / `--named
///                      NAME=REVISION`; absent or empty = not given
///   all / tracked / deleted   `--all` / `--tracked` / `--deleted` (the CLI's conflicts refused as
///                      `jj.invalid_input`)
///   allow_empty_description / allow_private / allow_conflicts   the three `--allow-*`
///   dry_run            `--dry-run`: the plan, nothing pushed or written
///   options            `-o/--option`: git push options
///   cancel_token       Story 9.52: a token from `zanshin_network_token` that
///                      `zanshin_network_cancel` cancels (the push stops before the next remote,
///                      `GitPushResult.failure.kind = Cancelled`); 0 = not cancellable
table GitPushRequest {
  kind: RequestKind;
  remotes: [string];
  bookmarks: [string];
  tags: [string];
  all: bool;
  tracked: bool;
  deleted: bool;
  allow_empty_description: bool;
  allow_private: bool;
  allow_conflicts: bool;
  revisions: [string];
  changes: [string];
  named: [string];
  dry_run: bool;
  options: [string];
  cancel_token: uint64;
}

/// The remotes of `zanshin_git_fetch` (Story 9.30) — the CLI's either/or of `--remote` and
/// `--all-remotes`. `Default = 0` (the absent-field default) = neither flag: `git.fetch`, else the
/// only remote, else `origin`. Member order IS the wire value — APPEND only.
enum FetchRemotesMode : ubyte { Default, Named, All }

/// The refs of `zanshin_git_fetch` (Story 9.30) — the CLI's either/or of `--branch`/`--tag` and
/// `--tracked`. `Default = 0` (the absent-field default) = none of the three:
/// `remotes.<name>.fetch-bookmarks`/`fetch-tags`, else the Git config's refspecs and every tag.
/// Member order IS the wire value — APPEND only.
enum FetchRefsMode : ubyte { Default, Patterns, Tracked }

/// Arguments of `zanshin_git_fetch` (Story 9.30) — the CLI's `jj git fetch`, passed through
/// (FR-JJ-17). Names are PATTERNS as in the CLI (a bare word is a glob).
///
///   remotes_mode       which remotes; `Named` reads `remotes` (the `--remote` patterns, their
///                      union), the other two ignore it
///   refs_mode          which refs per remote; `Patterns` reads `branches` / `tags` (`-b` / `-t`;
///                      an absent or empty list fetches none of that kind), the other two ignore
///                      them
///   cancel_token       Story 9.52: a token from `zanshin_network_token` that
///                      `zanshin_network_cancel` cancels (`jj.cancelled`); 0 = not cancellable
table GitFetchRequest {
  kind: RequestKind;
  remotes_mode: FetchRemotesMode;
  remotes: [string];
  refs_mode: FetchRefsMode;
  branches: [string];
  tags: [string];
  cancel_token: uint64;
}

/// The object hash of a new Git repository — the CLI's `--object-hash` (Story 9.20).
/// `Unspecified = 0` (the absent-field default) = the flag not given: the `git.object-hash`
/// config decides. Member order IS the wire value — APPEND only.
enum ObjectHash : ubyte { Unspecified, Sha1, Sha256 }

/// The backend of `zanshin_repo_init` (Story 9.20). `Native = 0` (the absent-field default) is
/// jj's native backend (Zanshin-only), `Git` is `jj git init`. Member order IS the wire value.
enum InitBackend : ubyte { Native, Git }

/// Arguments of `zanshin_repo_clone` (Story 9.20) — the CLI's `jj git clone`, passed through.
///
///   source             REQUIRED (absent → `jj.invalid_input`): the URL or path, as given
///   destination        REQUIRED: missing or an empty directory (created with its parents)
///   remote_name        `--remote`; ABSENT = `origin`
///   colocate / no_colocate   the CLI's two flags (both set → `jj.invalid_input`); neither =
///                      `git.colocate` decides
///   depth              `--depth`; 0 = absent (the whole history)
///   branches / tags    `-b` / `-t` patterns; ABSENT = the flag not given, present-empty = given
///                      with nothing (fetches none of that kind)
///   object_hash        `--object-hash`
///   cancel_token       Story 9.52: a token from `zanshin_network_token` that
///                      `zanshin_network_cancel` cancels (`jj.cancelled`); a live token is
///                      also the new session's id, so its progress is routable before the clone
///                      returns; 0 = not cancellable
table RepoCloneRequest {
  kind: RequestKind;
  source: string;
  destination: string;
  remote_name: string;
  colocate: bool;
  no_colocate: bool;
  depth: uint;
  branches: [string];
  tags: [string];
  object_hash: ObjectHash;
  cancel_token: uint64;
}

/// Arguments of `zanshin_repo_init` (Story 9.20) — the CLI's `jj git init`, passed through.
///
///   path               REQUIRED (absent → `jj.invalid_input`); created when missing (one level)
///                      for the Git backend
///   backend            Native (Zanshin-only, the path must exist, no Git flag) or Git
///   colocate / no_colocate   the CLI's two flags (both set → `jj.invalid_input`); neither =
///                      `git.colocate` decides
///   object_hash        `--object-hash`
table RepoInitRequest {
  kind: RequestKind;
  path: string;
  backend: InitBackend;
  colocate: bool;
  no_colocate: bool;
  object_hash: ObjectHash;
}

/// Arguments of `zanshin_file_list` (Story 9.4, FR-JJ-17).
///
/// `revision` ABSENT is the wire form of "the user did not supply it", which applies the
/// CLI's own `-r` default: `@` — the working-copy commit the pre-verb snapshot has just brought
/// up to date (Story 9.26). It is a jj reverse-hex CHANGE ID, not a revset: `-r` is
/// `resolve_single_rev`, which refuses an ambiguous revision, so a divergent id is refused
/// rather than guessed.
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths. The
/// fileset DSL is terminal input language and is not parsed (ADR-0003).
table FileListRequest {
  kind: RequestKind;
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_show` (Story 9.4). `revision`/`paths` as in FileListRequest,
/// except `paths` may NOT be empty — the CLI marks its FILESETS argument `required`, and an
/// empty list is `jj.invalid_input`.
table FileShowRequest {
  kind: RequestKind;
  revision: string;
  paths: [string];
}

/// Arguments of `zanshin_file_annotate` (Story 9.4). `revision` as in FileListRequest.
/// `path` is a single PLAIN repo-relative path, not a prefix and not a fileset — it is
/// `parse_file_path` in the CLI too. It is REQUIRED — an absent field is refused with
/// `jj.invalid_input`, mirroring the CLI's required positional argument; an explicitly
/// present EMPTY string is a value, not an absence, and means the repository root.
table FileAnnotateRequest {
  kind: RequestKind;
  revision: string;
  path: string;
}

/// Arguments of `zanshin_file_search` (Story 9.4). `revision`/`paths` as in
/// FileListRequest.
///
/// `pattern` is jj's own `kind:pattern` string-pattern syntax, passed through verbatim
/// (FR-JJ-17); a bare pattern defaults to kind `regex`, and the FIRST `:` separates. It is
/// REQUIRED — an absent field is refused with `jj.invalid_input`, mirroring the CLI's
/// `required = true` on `-p/--pattern`; an explicitly present EMPTY string is a value, not
/// an absence, and is the empty regex, which matches every line (`jj file search -p ""`).
/// `name_only` stops a file's scan at its first match — it changes the WORK done, not the
/// result shape, which is why it survives the terminal-UX cut that dropped `--line-number`
/// (the result always carries `SearchMatch.line_number`).
table FileSearchRequest {
  kind: RequestKind;
  revision: string;
  pattern: string;
  paths: [string];
  name_only: bool;
}

/// Arguments of `zanshin_git_remote_add` (Story 9.5) — the CLI's `jj git remote add`.
///
/// `name` and `url` are REQUIRED; an absent field is refused with `jj.invalid_input`,
/// mirroring the CLI's two required positionals. `push_url` is null-for-absence: ABSENT
/// means the remote pushes to its fetch URL, which is git's own behaviour and the CLI's
/// `--push-url` default. Both URLs cross VERBATIM — unlike the CLI, a relative local path
/// is NOT resolved against a process CWD (a GUI backend has none worth consulting).
///
/// Adding a remote WITH a push url makes it non-removable by `zanshin_git_remote_remove`:
/// jj-lib's own `save_remote` writes a `pushurl` key, and its `remove_remote` refuses any
/// key outside `url`/`fetch`/`tagOpt` (`jj.remote_nonstandard_config`).
table GitRemoteAddRequest {
  kind: RequestKind;
  name: string;
  url: string;
  push_url: string;
}

/// Arguments of `zanshin_git_remote_set_url` (Story 9.5) — the CLI's
/// `jj git remote set-url`.
///
/// `name` is REQUIRED. `url` (fetch) and `push_url` are BOTH null-for-absence, and absence
/// means "leave that side unchanged" — jj-lib cannot REMOVE a URL from a remote. With both
/// absent the call succeeds and does nothing, EVEN for a remote that does not exist: jj-lib
/// returns `Ok(())` in `set_remote_urls`' first two lines, before its own existence check.
/// That is mirrored deliberately; inventing a refusal there would be a divergence.
///
/// This verb never writes an operation — jj-lib takes a `&Store`, not a transaction — so
/// the returned `MutationResult.new_op_id` is always the PRE-CALL op-log head.
table GitRemoteSetUrlRequest {
  kind: RequestKind;
  name: string;
  url: string;
  push_url: string;
}

/// Arguments of `zanshin_show` (Story 9.6, FR-JJ-17) — the CLI's `jj show`.
///
/// `revset` is a pass-through revset EXPRESSION, not a change id: the CLI takes
/// `Vec<RevisionArg>` and UNIONS them, and materializing that into ids would destroy
/// alias/config resolution (FR-JJ-17). A bare DIVERGENT change-id symbol is nonetheless
/// REFUSED — jj-lib's own `SymbolResolver` raises `RevsetResolutionError::DivergentChangeId`
/// (`revset.rs:2827` @ 0.44.0) before evaluation, so `jj show <divergent-id>` fails in the CLI
/// too; it surfaces here as `jj.revset_resolution_error`, a different refusal from
/// InterdiffRequest's `jj.change_not_found`. Both commits stay addressable because their commit
/// hexes are ordinary revset symbols: union them to get one entry per commit.
/// ABSENT is the wire form of "the user did not supply it", which applies the CLI's own default
/// `@` — the working-copy commit the pre-verb snapshot has just brought up to date (Story 9.26). An
/// explicitly present EMPTY string is a VALUE, not an absence, and is a revset parse error.
/// There is deliberately no `paths` field: `jj show` hardcodes `EverythingMatcher`.
/// `limit` is a ZANSHIN-SIDE addition the CLI has no counterpart for — `jj show` has no
/// `-n/--limit` and streams to a pager, where this builds ONE buffer whose every entry pays a
/// merged-parent tree diff plus a per-parent copy-record stream. It is meaningful ONLY when
/// has_limit == true (presence pair, same rule as EvologRequest.limit: flatc 25.12.19 rejects
/// optional scalars for Dart), it is applied in RAW REVSET order, and `limit = 0` is an empty
/// result, not an error. ABSENCE is therefore the CLI-parity default: unbounded, as `jj show` is.
table ShowRequest {
  kind: RequestKind;
  revset: string;
  limit: uint;            // 0 / ignored when has_limit == false
  has_limit: bool;
}

/// Arguments of `zanshin_evolog` (Story 9.6) — the CLI's `jj evolog`.
///
/// `revset` behaves exactly as in ShowRequest. `limit` is the CLI's `-n/--limit`, meaningful
/// ONLY when has_limit == true (presence pair, same rule as SearchMatch.conflict_side: flatc
/// 25.12.19 rejects optional scalars for Dart). It is applied in WALK order — the CLI limits
/// before reversing — and `limit = 0` is an empty result, not an error.
table EvologRequest {
  kind: RequestKind;
  revset: string;
  limit: uint;            // 0 / ignored when has_limit == false
  has_limit: bool;
}

/// A single revision addressed by its jj reverse-hex CHANGE-ID prefix — the house currency for
/// single-revision parameters (Story 9.3, FR-JJ-17).
///
/// Resolves to the one VISIBLE commit carrying that prefix; an unknown, malformed, only-hidden
/// or DIVERGENT prefix is refused rather than guessed, exactly as the CLI's `resolve_single_rev`
/// refuses an ambiguous revision. Use CommitIdRef to reach a hidden commit.
table ChangeIdRef {
  id: string;                       // reverse-hex change-id PREFIX
}

/// A single revision addressed by its commit-id HEX prefix — the CLI's `commit_id()` reading of
/// a bare hex symbol.
///
/// Resolved through jj-lib's INDEX prefix lookup, which is VISIBILITY-BLIND: a HIDDEN commit —
/// an EvologEntry.predecessor_commit_ids entry among them — resolves here, which is what lets
/// evolog and interdiff compose into a version-to-version diff. An ambiguous prefix is refused
/// (`jj.revset_resolution_error`), never guessed; an empty or non-hex value is
/// `jj.invalid_input`; valid hex matching nothing is `jj.change_not_found`. It is NOT a revset
/// symbol resolver: there is no bookmark, tag or change-id fallback.
table CommitIdRef {
  id: string;                       // commit-id hex PREFIX
}

/// Which currency one side of `zanshin_interdiff` is written in.
///
/// Member order IS the wire discriminant (no explicit numbers) — APPEND only. An ABSENT union
/// (both vtable slots unset, discriminant `NONE`) is the wire form of "the user did not supply
/// this side", which applies the CLI's `@` default. `zanshin_interdiff` is the ONLY consumer:
/// every other verb keeps its own currency untouched.
union RevisionRef {
  ChangeIdRef,
  CommitIdRef
}

/// Arguments of `zanshin_interdiff` (Story 9.6) — the CLI's `jj interdiff`.
///
/// Unlike ShowRequest/EvologRequest each side is a SINGLE revision rather than a revset, and it
/// crosses as a RevisionRef union: a ChangeIdRef is the house reverse-hex change-id currency
/// (visible commits only, divergence refused), a CommitIdRef is a commit-id hex prefix resolved
/// through the index and therefore reaches HIDDEN commits. Both inherit the CLI
/// `resolve_single_rev`'s REFUSAL — an ambiguous revision is rejected rather than guessed.
/// Feeding an EvologEntry.predecessor_commit_ids entry in as a CommitIdRef is what composes the
/// two verbs into a version-to-version diff — the stand-in for the unported `evolog --patch`.
/// That composition holds for as long as the predecessor is INDEXED: a garbage-collected one is
/// still listed by evolog but no longer resolvable, and answers `jj.change_not_found`.
/// A revset EXPRESSION (`main`, `@-`) is still not accepted on either side.
/// An ABSENT side is `@` — but omitting BOTH is refused with
/// `jj.invalid_input`, mirroring the CLI's `ArgGroup … required(true)`.
/// `paths` are repo-relative paths interpreted as PREFIXES; empty/absent = all paths, and the
/// fileset DSL is not parsed (ADR-0003). A filter matching nothing yields an EMPTY list, where
/// the CLI only warns.
table InterdiffRequest {
  kind: RequestKind;
  from: RevisionRef;      // two vtable slots: from_type + from
  to: RevisionRef;        // two vtable slots: to_type + to
  paths: [string];
}

/// Arguments of `zanshin_workspace_root` (Story 9.7) — the CLI's `jj workspace root [--name]`.
///
/// ABSENT is the wire form of "the user did not supply --name", which applies the CLI's own
/// documented default: the CURRENT workspace. That path reads the workspace loader alone — no
/// repo load, no store read — and cannot fail. An explicitly present EMPTY string is a VALUE,
/// not an absence: no workspace is named "", so it refuses with `jj.workspace_not_found`.
///
/// `zanshin_workspace_list` has NO request table: the CLI's `jj workspace list` takes no
/// argument at all (its only flag, `-T/--template`, is rendering).
table WorkspaceRootRequest {
  kind: RequestKind;
  name: string;
}

/// How `zanshin_workspace_add` sets the new workspace's sparse patterns — the CLI's
/// `--sparse-patterns` (Story 9.23). `Copy` (the wire default, as the CLI's) copies the current
/// workspace's patterns, `Full` includes every file, `Empty` none. Member order IS the wire
/// value — APPEND only.
enum SparseInheritance : ubyte {
  Copy,
  Full,
  Empty
}

/// Arguments of `zanshin_workspace_add` (Story 9.23) — the CLI's `jj workspace add`, every
/// argument passed through (FR-JJ-17).
///
/// `destination` is REQUIRED (absent → `jj.invalid_input`), resolved against the current
/// workspace root; an absolute path stays absolute. `name` ABSENT is the CLI's default — the
/// destination's final component; an explicitly present EMPTY name is a value and refused.
/// `revisions` are the CLI's repeatable `-r` REVSETS (their union, in argument order); empty →
/// the parents of the current `@`. `message_paragraphs` are the CLI's repeatable `-m`.
/// `colocate` / `no_colocate` are the CLI's two mutually exclusive flags (both set →
/// `jj.invalid_input`); neither → a Git worktree exactly when the current workspace is colocated
/// and `git.colocate` is true.
table WorkspaceAddRequest {
  kind: RequestKind;
  destination: string;
  name: string;
  revisions: [string];
  message_paragraphs: [string];
  colocate: bool;
  no_colocate: bool;
  sparse_patterns: SparseInheritance;
}

/// Arguments of `zanshin_bookmark_create` (Story 9.8) — the CLI's `jj bookmark create`.
///
/// `names` are EXACT, DECODED bookmark names — not CLI argument text. The CLI validates each
/// with `revset::parse_symbol`, i.e. a name containing a space or an `@` must be QUOTED on a
/// terminal; that quoting is terminal input syntax the GUI replaces (ADR-0003), so the name
/// crosses verbatim. An EMPTY vector is refused with `jj.invalid_input` (clap's
/// `required = true`), and so is an empty-STRING name — the one refusal `parse_symbol` makes
/// that no spelling can get around.
/// `revision` ABSENT is the wire form of "the user did not supply `-r`", which applies the
/// CLI's own clap `default_value`, the literal `@` — the working-copy commit the pre-verb
/// snapshot has just brought up to date (Story 9.26). It is a jj reverse-hex CHANGE ID, not a
/// revset: `-r` is `resolve_single_rev`, so a divergent id is refused rather than guessed,
/// exactly as in FileListRequest. An explicitly present EMPTY string is a VALUE, not an
/// absence, and refuses with `jj.change_not_found`.
table BookmarkCreateRequest {
  kind: RequestKind;
  names: [string];
  revision: string;
}

/// Arguments of `zanshin_bookmark_delete` (Story 9.8) — the CLI's `jj bookmark delete`.
///
/// Unlike BookmarkCreateRequest's, these `names` are string PATTERNS, passed through verbatim
/// (FR-JJ-17) because the pattern KIND is the parameter's meaning, not its spelling:
/// `exact:`, `glob:`, `regex:`, `substring:` and the `~`/`&`/`|` operators all work, and the
/// patterns are unioned. **A BARE pattern is a GLOB, not an exact name** — a bookmark whose
/// name contains `*`, `?` or `[` needs `exact:"…"`. An EMPTY vector is refused with
/// `jj.invalid_input` (clap's `required = true`); a pattern that matches NOTHING is a
/// SUCCESS that writes no operation, so `MutationResult.new_op_id` is the PRE-CALL op-log
/// head.
table BookmarkDeleteRequest {
  kind: RequestKind;
  names: [string];
}

/// One `--sort` key of `jj bookmark list` (Story 9.19) — the CLI's `SortKey`; a `…Desc` key is
/// the CLI's spelling with a trailing `-` (`name-`, `author-date-`, …). `Unspecified = 0` is the
/// default of an unset element and is REFUSED (`ffi.invalid_argument`).
enum BookmarkSortKey : ubyte {
  Unspecified,
  Name,
  NameDesc,
  AuthorName,
  AuthorNameDesc,
  AuthorEmail,
  AuthorEmailDesc,
  AuthorDate,
  AuthorDateDesc,
  CommitterName,
  CommitterNameDesc,
  CommitterEmail,
  CommitterEmailDesc,
  CommitterDate,
  CommitterDateDesc
}

/// Arguments of `zanshin_bookmarks` (Stories 9.29 and 9.19) — the CLI's `jj bookmark list`
/// without `-T`. ABSENT or EMPTY vectors and `false` flags are the CLI without that argument, so
/// an all-default buffer lists the CLI's default rows.
///
///   names        string PATTERNS (a bare one is a GLOB), unioned; OR-ed with `revisions`
///   revisions    revset TEXTS, unioned; a bookmark whose LOCAL target is in them is listed
///   remotes      remote-name PATTERNS (`--remote`)
///   all_remotes  `--all-remotes`; refused with `jj.invalid_input` together with `remotes`,
///                `tracked` or `conflicted` (clap's conflicts_with), before the snapshot
///   tracked      `--tracked`; conflicted `--conflicted`
///   sort         `--sort`, most significant first; empty applies `ui.bookmark-list-sort-keys`
table BookmarkListRequest {
  kind: RequestKind;
  names: [string];
  revisions: [string];
  remotes: [string];
  all_remotes: bool;
  tracked: bool;
  conflicted: bool;
  sort: [BookmarkSortKey];
}

/// Arguments of `zanshin_bookmark_move` (Story 9.19) — the CLI's `jj bookmark move`.
///
/// `names` are EXACT, DECODED bookmark names (the CLI's `exact:"…"`, never its default glob);
/// `from` are revset TEXTS (`--from`, unioned). At least one of the two must be non-empty, else
/// `jj.invalid_input`. `to` ABSENT is the CLI's `--to` default `@`; present it is a jj reverse-hex
/// CHANGE ID. `allow_backwards` is `--allow-backwards`. Nothing to move is a SUCCESS that writes
/// no operation (`MutationResult.new_op_id` is the pre-call head).
table BookmarkMoveRequest {
  kind: RequestKind;
  names: [string];
  from: [string];
  to: string;
  allow_backwards: bool;
}

/// Arguments of `zanshin_bookmark_advance` (Story 9.19) — the CLI's `jj bookmark advance`.
///
/// `names` are EXACT bookmark names; ABSENT/EMPTY means the CLI's default candidates
/// (`revsets.bookmark-advance-from`). `to` ABSENT applies `revsets.bookmark-advance-to`; present
/// it is a jj reverse-hex CHANGE ID.
table BookmarkAdvanceRequest {
  kind: RequestKind;
  names: [string];
  to: string;
}

/// Arguments of `zanshin_bookmark_rename` (Story 9.19) — the CLI's `jj bookmark rename`.
/// `old_name` / `new_name` are DECODED names (ABSENT = empty = refused with `jj.invalid_input`);
/// `overwrite_existing` is `--overwrite-existing`.
table BookmarkRenameRequest {
  kind: RequestKind;
  old_name: string;
  new_name: string;
  overwrite_existing: bool;
}

/// Arguments of `zanshin_file_track` (Story 9.22) — the CLI's `jj file track`.
///
/// `paths` are repo-relative paths interpreted as PREFIXES; the fileset DSL is terminal input
/// language and is not parsed (ADR-0003). An EMPTY or ABSENT vector is refused with
/// `jj.invalid_input` (clap's `required = true`). `include_ignored` is the CLI's
/// `--include-ignored`: track matching files even when ignored or over
/// `snapshot.max-new-file-size`.
table FileTrackRequest {
  kind: RequestKind;
  paths: [string];
  include_ignored: bool;
}

/// Arguments of `zanshin_file_untrack` (Story 9.22) — the CLI's `jj file untrack`. `paths`
/// exactly as in FileTrackRequest; every matched path must already be ignored.
table FileUntrackRequest {
  kind: RequestKind;
  paths: [string];
}

// ── The config surface (Story 9.28) — the CLI's `jj config` group ───────────────
//
// Nine HANDLE-LESS wrappers: every input, the workspace root included, lives in the request
// table. `workspace_root` ABSENT is the wire form of "no workspace" (the CLI run outside a repo,
// no `-R`); present, it is the CLI's `-R <path>` — the workspace ROOT, never walked up. A
// `Repo` handle is deliberately not used: a stack only the workspace LOAD refuses (a
// wrong-typed `git.*` key) must not block the config verbs, which are how it gets repaired.

/// The CLI's `--user` / `--repo` / `--workspace`. `Unspecified = 0` is the absent-field default
/// and is refused (`jj.invalid_input`) wherever a scope is required.
/// Member order IS the wire value — APPEND only.
enum ConfigScope : byte { Unspecified, User, Repo, Workspace }

/// Arguments of `zanshin_config_list` — `jj config list [NAME] [--user|--repo|--workspace]
/// [--include-defaults] [--include-overridden]`. `name` ABSENT lists everything; `scope`
/// `Unspecified` means no scope flag. A scope together with `include_defaults` is refused with
/// `jj.invalid_input` (clap's conflict).
table ConfigListRequest {
  kind: RequestKind;
  workspace_root: string;
  name: string;
  scope: ConfigScope;
  include_defaults: bool;
  include_overridden: bool;
}

/// Arguments of `zanshin_config_get` — `jj config get NAME`; `name` is required.
table ConfigGetRequest {
  kind: RequestKind;
  workspace_root: string;
  name: string;
}

/// Arguments of `zanshin_config_path` — `jj config path --user|--repo|--workspace`.
table ConfigPathRequest {
  kind: RequestKind;
  workspace_root: string;
  scope: ConfigScope;
}

/// Arguments of `zanshin_config_set` — `jj config set --user|--repo|--workspace|--file PATH NAME
/// VALUE`. `value` is TOML text (a bare string when it does not look like TOML); `name` and
/// `value` are required. EXACTLY ONE of `scope` (the scope's first file) and `path` (the CLI's
/// `--file`, jj 0.45: a location jj recognizes as a config file; relative = against
/// `workspace_root`) — `scope` stays `Unspecified` when `path` is sent.
table ConfigSetRequest {
  kind: RequestKind;
  workspace_root: string;
  scope: ConfigScope;
  name: string;
  value: string;
  path: string;
}

/// Arguments of `zanshin_config_unset` — `jj config unset --user|--repo|--workspace|--file PATH
/// NAME`; `scope` / `path` as in ConfigSetRequest.
table ConfigUnsetRequest {
  kind: RequestKind;
  workspace_root: string;
  scope: ConfigScope;
  name: string;
  path: string;
}

/// Arguments of `zanshin_config_file_read` — `jj config edit`, editor half 1; `scope` / `path`
/// as in ConfigSetRequest.
table ConfigFileReadRequest {
  kind: RequestKind;
  workspace_root: string;
  scope: ConfigScope;
  path: string;
}

/// Arguments of `zanshin_config_file_write` — `jj config edit`, editor half 2. `path` (a location
/// `zanshin_config_file_read` accepts) and `text` are required.
table ConfigFileWriteRequest {
  kind: RequestKind;
  workspace_root: string;
  path: string;
  text: string;
}

/// Arguments of `zanshin_config_gc_list` — `jj config gc`, half 1 (no arguments; the tag only).
table ConfigGcListRequest {
  kind: RequestKind;
}

/// Arguments of `zanshin_config_gc_delete` — `jj config gc`, half 2: the config directories to
/// delete (normally a subset of `zanshin_config_gc_list`'s answer).
table ConfigGcDeleteRequest {
  kind: RequestKind;
  config_dirs: [string];
}

/// One variable of the environment `zanshin_environment_adopt` installs (Story 9.36) — a nested
/// helper table like ChangeIdRef, not a request table. Both sides are `[ubyte]`, not `string`: an
/// environment is not guaranteed UTF-8, and a non-UTF-8 value must reach the `git` subprocess
/// byte for byte. `name` is required and non-empty; an absent `value` is the empty value.
table EnvironmentVariable {
  name: [ubyte];
  value: [ubyte];
}

/// Arguments of `zanshin_environment_adopt` — the app's start-up adoption of the login shell's
/// environment (Story 9.36): the environment the app read from the login shell, every variable of
/// it. `variables` is required and non-empty — an empty environment is never a login shell's.
table EnvironmentAdoptRequest {
  kind: RequestKind;
  variables: [EnvironmentVariable];
}

/// Arguments of `zanshin_commit_contents` (Story 4.10) — the op-pinned batch content lookup.
/// `operation_id` is required: the FULL hex id of the operation the topology call loaded (an
/// absent field is `jj.invalid_input` "operation_id is required"). `commit_ids` are FULL hex
/// commit ids; the answer comes back in this order. An absent or empty list is a valid, empty
/// request.
table CommitContentsRequest {
  kind: RequestKind;
  operation_id: string;
  commit_ids: [string];
}

/// What `zanshin_drop_actions` previews as dragged (Story 9.31). Member order IS the wire
/// value — APPEND only.
enum DropSourceKind : ubyte { Change, Selection, Bookmark }

/// One location of `zanshin_drop_actions` (Story 9.31) — the CLI's `-o` / `-A` / `-B`, change ids
/// in jj reverse-hex. ABSENT or EMPTY is the flag not given; `onto` excludes the other two, and at
/// least one must be given (else `jj.invalid_input` for the whole call).
table DropLocation {
  onto: [string];
  insert_after: [string];
  insert_before: [string];
}

/// Arguments of `zanshin_drop_actions` (Story 9.31).
///
///   source_kind        `Change` (the change `change_id`), `Selection` (the changes to `paths` —
///                      repo-relative PREFIXES; empty = every path for the squash row, which the
///                      split row refuses with split's no-paths text — inside `change_id`) or
///                      `Bookmark` (the local bookmark named exactly `bookmark`)
///   change_id          the dragged change (jj reverse-hex); `Change` / `Selection` only
///   paths              the selected paths; `Selection` only
///   bookmark           the dragged bookmark's name; `Bookmark` only
///   locations          the drop locations; each row's `location` is an index into this list
///
/// A field the `source_kind` needs that is ABSENT is `jj.invalid_input` "<field> is required".
table DropActionsRequest {
  kind: RequestKind;
  source_kind: DropSourceKind;
  change_id: string;
  paths: [string];
  bookmark: string;
  locations: [DropLocation];
}

/// Arguments of `zanshin_graph_topology` (Story 4.12) — the whole revset's index-only topology,
/// every argument a caller pass-through (FR-JJ-17); Rust bakes in no default.
/// `revset`, `prioritize` and `short_prefixes` are required: an absent field is `jj.invalid_input`
/// "<field> is required". A present EMPTY string is a value: an empty `short_prefixes` disables
/// disambiguation (the CLI's toggle semantic), a blank `revset`/`prioritize` is a parse error.
/// An absent `anchors` vector is the empty list; `with_timestamps` absent is `false`.
table GraphTopologyRequest {
  kind: RequestKind;
  revset: string;
  prioritize: string;
  short_prefixes: string;
  anchors: [string];
  with_timestamps: bool;
}

// ── Payload union ─────────────────────────────────────────────────────────────
// Closed registry of composite FFI return types.
// Extend this union — and regenerate both sides — as each noun lands:
//   Story 3-4a : RepoHandle  ✓
//   Story 3-8  : Diagnostics ✓
//   Story 3-4b : status ✓, change ✓, op_log ✓, bookmarks ✓, remotes ✓
//   Story 3-6  : WatcherEvent ✓, Progress ✓
//   Story 4-2  : GraphSlice ✓ (FFI wrapper 4-6) (removed 4-12; slot 11 reused by GraphTopology)
//   Story 4-9  : LogDefaults ✓
//   Story 5-8  : Diff
//   Story 6-5  : mutation results ✓
//   Story 9-3  : AbsorbResult ✓ (restore reuses MutationResult)
//   Story 9-4  : FileList ✓, FileContents ✓, FileAnnotation ✓, FileSearch ✓
//   Story 9-5  : GitImportResult ✓, GitExportResult ✓ (the four remote verbs reuse
//                MutationResult)
//   Story 9-6  : ShowView ✓, EvologView ✓, InterdiffView ✓ (all three reuse the shipped
//                Change / FileChange tables — no second spelling of either shape)
//   Story 9-7  : WorkspaceList ✓, WorkspaceRoot ✓ (the list row is the shipped
//                View::wc_commit_ids half plus the WorkspaceStore path half)
//   Story 9-8  : — (bookmark create/delete BOTH reuse the shipped MutationResult, so the
//                union is unchanged: which bookmarks are gone is answered by re-reading
//                zanshin_bookmarks, and "did anything happen at all" is already in the
//                contract as the pre-call-head new_op_id)
//   Story 9-22 : TrackResult ✓, UntrackResult ✓ (both nest the shipped MutationResult and one
//                shared SnapshotStats; UntrackResult reuses GitExportFailure)
//   Story 9-28 : ConfigListResult ✓, ConfigGetResult ✓, ConfigPathResult ✓, ConfigSetResult ✓,
//                ConfigUnsetResult ✓, ConfigFileText ✓, ConfigGcList ✓, ConfigGcResult ✓
//                (`zanshin_config_file_write` answers ok with no payload)
//   Story 9-36 : — (`zanshin_environment_adopt` answers ok with no payload and no warnings)
//   Story 4-10 : CommitContents ✓
//   Story 4-12 : GraphTopology ✓ (GraphSlice's Payload slot 11)
//   Story 9-15 : SquashPlan ✓, SplitResult ✓ (zanshin_squash reuses MutationResult;
//                SplitResult nests it)
//   Story 9-31 : DropActions ✓, ChangeActions ✓ (a row's refusal is the shipped FfiError)

/// Opaque handle to an open repo session.
/// `handle` is the Rust `*mut RepoSession` reinterpreted as an unsigned integer;
/// Dart passes it back verbatim to zanshin_repo_close.
/// `session_id` is a process-unique, never-reused id allocated when the session
/// is armed; async events (WatcherEvent/Progress) carry it as their correlation
/// id. Unlike `handle` (an allocation address that a close→reopen can reuse —
/// the rawToId ABA race, resolved 2026-07-04), a session id can never be
/// misattributed to a later session.
/// The envelope carrying it from init/clone/convert also carries the creating call's report
/// (`Envelope.warnings`, and — convert only — `Envelope.precondition`; Story 9.33); from open,
/// neither.
table RepoHandle {
  handle: ulong;
  session_id: ulong;
}

/// Diagnostics payload returned by zanshin_diagnostics().
/// All four fields are compile-time or infallibly-resolved values.
table Diagnostics {
  app_version: string;
  git_sha: string;
  log_path: string;
  /// The version of jj-lib Zanshin is built on (`zanshin_jj::JJ_LIB_VERSION`).
  jj_lib_version: string;
}

/// How a working-copy file changed between @- and @.
enum ChangeKind : byte { Added, Modified, Removed, Renamed, Copied }

/// One changed file. `from_path` is set ONLY for Renamed/Copied (the source
/// path); it is absent for Added/Modified/Removed.
table FileChange {
  path: string;
  kind: ChangeKind;
  from_path: string;
}

/// Working-copy status: files changed between @ and @-, plus both change ids
/// in jj's reverse-hex display form.
table Status {
  files: [FileChange];
  working_copy_change_id: string;
  parent_change_id: string;
}

/// A commit signature: who authored/committed and when (raw jj timestamp).
table Signature {
  name: string;
  email: string;
  timestamp_millis: long;     // millis since the Unix epoch
  tz_offset_minutes: int;     // timezone offset, minutes east of UTC
}

/// Whether a change is conflict-free. `conflicted_paths` is populated only when Conflicted.
enum ConflictState : byte { Clean, Conflicted }

/// Full metadata for one change (FR-JJ-6). Authored/committed times live on the
/// author/committer signatures (authored_at == author.timestamp_millis, etc.).
table Change {
  id: string;                  // ChangeId reverse-hex (stable across rebases)
  commit_id: string;           // CommitId hex (Git SHA; changes on rebase)
  parents: [string];           // parent ChangeIds reverse-hex; empty for the root change
  description: string;         // always present, may be empty
  author: Signature;
  committer: Signature;
  is_signed: bool;             // cryptographic signature present (presence-only; 2.6 D3)
  conflict: ConflictState;
  conflicted_paths: [string];  // populated only when conflict == Conflicted
  is_anonymous: bool;
  divergent: bool;             // change id resolved to >1 visible commit (2.6 D4)
}

/// One tag of an operation (Story 9.21): jj's `OperationMetadata.attributes` entry.
table OperationTag {
  key: string;
  value: string;
}

/// One entry in jj's operation log (FR-JJ-7).
table Operation {
  id: string;                  // op id, plain forward hex (NOT reverse-hex)
  parent_ids: [string];        // parent op ids; empty for the root op; >1 for a DAG fork
  timestamp_millis: long;      // op end-time, millis since the Unix epoch
  tz_offset_minutes: int;      // timezone offset, minutes east of UTC
  user: string;                // metadata.username; may be empty
  host: string;                // metadata.hostname; may be empty
  description: string;         // jj's user-friendly summary; always present, may be empty
  root_op: bool;               // true iff the op-store root operation
  is_snapshot: bool;           // pure working-copy-snapshot op (2.7 D6)
  workspace_name: string;      // the workspace it was performed in; ABSENT when it records none (Story 9.21)
  tags: [OperationTag];        // its tags, sorted by key; absent/empty when none (Story 9.21)
}

/// The operation log: reverse-chronological (head op first, root op last).
table OpLog {
  operations: [Operation];
}

/// Arguments of `zanshin_op_show` (Story 9.21) — the CLI's `jj op show`.
///
///   operation          the operation expression (`@`, `@-`, an id prefix); ABSENT = `@`
///   show_changes_in    `--show-changes-in`; ABSENT = `revsets.op-diff-changes-in`
table OpShowRequest {
  kind: RequestKind;
  operation: string;
  show_changes_in: string;
}

/// Arguments of `zanshin_op_diff` (Story 9.21) — the CLI's `jj op diff`; every string ABSENT =
/// the flag was not given.
///
///   operation          `--operation`: this operation against its parents (default `@`); may NOT
///                      be combined with from/to (clap's conflict, `jj.invalid_input` before the
///                      snapshot)
///   from, to           `--from` / `--to`; with only one given, the other is `@`
///   show_changes_in    `--show-changes-in`; ABSENT = `revsets.op-diff-changes-in`
table OpDiffRequest {
  kind: RequestKind;
  operation: string;
  from: string;
  to: string;
  show_changes_in: string;
}

/// One `--what` value of `jj op restore` / `jj op revert` (Story 9.12) — the CLI's
/// `RevertWhatToRestore`. `Unspecified = 0` is the default of an unset element and is REFUSED
/// (`ffi.invalid_argument`).
///
///   Repo             the jj repo state and local bookmarks (heads, local bookmarks/tags, the
///                    working-copy commits)
///   RemoteTracking   the remote-tracking bookmarks
enum RestoreWhat : ubyte {
  Unspecified,
  Repo,
  RemoteTracking
}

/// Arguments of `zanshin_op_restore` (Story 9.12) — the CLI's `jj op restore`.
///
///   operation   the operation expression (`@-`, an id prefix); REQUIRED — ABSENT is refused
///               (`jj.invalid_input` "operation is required"), as the CLI's positional is required
///   what        `--what`, repeatable; ABSENT or EMPTY = the flag absent (both portions)
table OpRestoreRequest {
  kind: RequestKind;
  operation: string;
  what: [RestoreWhat];
}

/// Arguments of `zanshin_op_revert` (Story 9.12) — the CLI's `jj op revert`.
///
///   operation   the operation expression; ABSENT = `@` (the CLI's default)
///   what        `--what`, repeatable; ABSENT or EMPTY = the flag absent (both portions)
table OpRevertRequest {
  kind: RequestKind;
  operation: string;
  what: [RestoreWhat];
}

/// A ref target as `jj op diff` summarises it (Story 9.21): ABSENT = `adds` empty and not
/// `conflicted`; a normal target = one add; a conflict = its present adds and removes. Hex
/// commit ids.
table OpRefTarget {
  adds: [string];
  removes: [string];
  conflicted: bool;
}

/// One changed commit of an operation diff (Story 9.21): `commit_id` is the row's key — the new
/// commit, or the old one when `abandoned`; `added_commit_ids` the CLI's `+` line (empty when
/// abandoned), `removed_commit_ids` its `-` lines (the predecessors, or the abandoned commit).
table OpChangedCommit {
  commit_id: string;
  abandoned: bool;
  added_commit_ids: [string];
  removed_commit_ids: [string];
}

/// The commit section of an operation diff (Story 9.21): the rows in revset order, and how many
/// newly visible / hidden commits outside `show_changes_in` were elided (`count_estimate`).
table OpCommitsDiff {
  changes: [OpChangedCommit];
  elided_newly_visible: RefDistance;
  elided_newly_hidden: RefDistance;
}

/// A workspace whose working-copy commit changed (Story 9.21); `from` / `to` ABSENT when the
/// workspace did not exist before / after.
table OpWorkingCopyChange {
  workspace: string;
  from: string;
  to: string;
}

/// A local bookmark or tag whose target changed (Story 9.21).
table OpRefChange {
  name: string;
  from: OpRefTarget;
  to: OpRefTarget;
}

/// A remote bookmark or tag whose target or tracking state changed (Story 9.21).
table OpRemoteRefChange {
  name: string;
  remote: string;
  from: OpRefTarget;
  from_tracked: bool;
  to: OpRefTarget;
  to_tracked: bool;
}

/// The repository changes between two operations (Story 9.21), in the CLI's section order.
/// `commits` is ABSENT when `show_changes_in` did not resolve (warned
/// `jj.op_diff_changes_unresolved`); the remote sections leave out a Git repo's `git` remote.
table OpDiff {
  commits: OpCommitsDiff;
  working_copies: [OpWorkingCopyChange];
  local_bookmarks: [OpRefChange];
  local_tags: [OpRefChange];
  remote_bookmarks: [OpRemoteRefChange];
  remote_tags: [OpRemoteRefChange];
}

/// `zanshin_op_show`'s answer (Story 9.21): the operation and its diff against its parent;
/// `diff` ABSENT for an operation with more than one parent (the CLI prints none).
table OpShow {
  operation: Operation;
  diff: OpDiff;
}

/// `zanshin_op_diff`'s answer (Story 9.21): the operations diffed from (one for `from`, else the
/// operation's parents — none for the root), the one diffed to, and the diff.
table OpDiffResult {
  from: [Operation];
  to: Operation;
  diff: OpDiff;
}

/// `zanshin_op_abandon`'s answer (Story 9.21): the CLI's status lines as facts —
/// `nothing_changed` is its "Nothing changed." (both counts 0), else "Abandoned
/// `abandoned_count` operations and reparented `reparented_count` descendant operations." —
/// and the op heads afterwards.
table OpAbandonResult {
  abandoned_count: ulong;
  reparented_count: ulong;
  nothing_changed: bool;
  head_op_ids: [string];
}

/// `zanshin_op_integrate`'s answer (Story 9.12): the head operation afterwards (the integrated
/// operation, the merge that reconciled it, or the unchanged head for an operation already in the
/// log) and `reconciled` — the integrate itself merged the heads (the CLI's status line "The
/// specified operation has been integrated with other existing operations."); a reconcile the
/// head load wrote first does not count.
table OpIntegrateResult {
  head_op_id: string;
  reconciled: bool;
}

/// Whether a bookmark row is the local bookmark or a remote one (tracked or not).
/// `remote_name` is populated ONLY when kind == Remote (empty for Local).
enum BookmarkKind : byte { Local, Remote }

/// A commit count between a remote bookmark and its local counterpart — jj-lib's
/// `Revset::count_estimate` (Story 9.29). `upper` is meaningful ONLY when has_upper == true
/// (presence pair: flatc 25.12.19 rejects optional scalars for Dart); has_upper == false is
/// the CLI's "at least `lower` commits". Exact counts carry upper == lower.
table RefDistance {
  lower: ulong;
  upper: ulong;          // 0 / ignored when has_upper == false
  has_upper: bool;
}

/// One row of `jj bookmark list` (FR-JJ-8, Stories 9.29 and 9.19). With `all_remotes` a bookmark
/// that is both local and on a remote appears as one Local row plus one Remote row per remote.
///
/// Every row: `target` (ABSENT = null when the row's target is absent — the CLI's `(deleted)`
/// local row or a tracked remote `(not created yet)`; a conflicted target carries its first
/// added commit's change id), `conflicted` (the target is an unresolved conflict,
/// `!RefTarget::is_resolved`) and `synced` (local: every TRACKED remote points where the local
/// does, true with none; remote: tracked and pointing where the local does).
///
/// Remote rows only (default/absent on Local rows): `tracked`, and `ahead` / `behind` —
/// present only on a tracked row whose own target and the local target are both present.
/// Direction is the REMOTE row's, as the CLI's: `ahead` = commits the remote has that the
/// local lacks, `behind` = commits the local has that the remote lacks.
table Bookmark {
  name: string;          // bookmark name (UTF-8)
  target: string;        // target ChangeId, reverse-hex; ABSENT when the target is absent
  kind: BookmarkKind;
  remote_name: string;   // populated only when kind == Remote; empty for Local
  conflicted: bool;
  synced: bool;
  tracked: bool;         // Remote rows only
  ahead: RefDistance;    // Remote rows only; ABSENT when not computed
  behind: RefDistance;   // Remote rows only; ABSENT when not computed
}

/// The bookmark list: the rows the CLI prints for the request's arguments, in its order — each
/// Local row followed by its tracked Remote rows, then the name's untracked Remote rows, in name
/// order; then re-sorted by the request's `sort` (or `ui.bookmark-list-sort-keys`), which moves
/// a Local row together with its tracked rows (Story 9.19).
table Bookmarks {
  bookmarks: [Bookmark];
}

/// One configured git remote (FR-JJ-9). BOTH URLs are verbatim — credentials are
/// NOT scrubbed and SSH is NOT rewritten to HTTPS.
///
/// `push_url` reports a DIFFERENCE, not a raw `remote.<name>.pushurl` read: it is
/// present only when the remote's push URL differs from `url`, exactly as
/// `jj git remote list` prints its `(push: …)` suffix only then. ABSENT therefore
/// means "this remote pushes to its fetch URL" — never an empty string.
table Remote {
  name: string;      // remote name, e.g. "origin" (UTF-8)
  url: string;       // fetch URL, verbatim
  push_url: string;  // null-for-absence: set only when it DIFFERS from `url`
}

/// The remote list: configured git remotes, sorted by name.
table Remotes {
  remotes: [Remote];
}

/// `zanshin_git_push_remotes`' answer (Story 9.54): the remotes `jj git push` without `--remote`
/// would push to, in remote-name order — `git.push` (a name, a list or a pattern), else the
/// single remote, else `origin`, each only when it exists. Empty when none matches and on a
/// non-Git backend.
table GitPushRemotes {
  names: [string];
}

/// `zanshin_git_fetch`'s answer (Story 9.30): the shared mutation contract and the fetch's own
/// facts.
///
///   mutation           the operation the fetch wrote; a fetch that changed nothing writes none
///                      (Story 9.40) and `new_op_id` is the head before the verb
///   remotes            the remotes fetched from, in remote-name order
///   hints              the CLI's hints, verbatim: "Fetching from the only existing remote: <name>"
///   failed_ref_names   the Git refs the import could not read (lossy UTF-8, sorted by name) —
///                      what `jj.git_import_failed` lists
///   changed_bookmarks  the remote bookmarks the import changed, in jj-lib's symbol order — as
///                      `GitImportResult.changed_bookmarks` (the CLI's `print_imported_changes`)
///   changed_tags       the remote tags the import changed, in jj-lib's symbol order — as
///                      `GitImportResult.changed_tags`
///   num_rewritten      how many commits the import rewrote ("Updated {n} rewritten commits."),
///                      saturating at 4294967295 — as `GitImportResult.num_rewritten`
table GitFetchResult {
  mutation: MutationResult;
  remotes: [string];
  hints: [string];
  failed_ref_names: [string];
  changed_bookmarks: [GitRefUpdate];
  changed_tags: [GitRefUpdate];
  num_rewritten: uint;
}

/// `zanshin_git_fetch_remotes`' answer (Story 9.30): the remotes `jj git fetch` without
/// `--remote` would fetch from, in remote-name order — `git.fetch` (a name, a list or a
/// pattern), else the single remote, else `origin`, each only when it exists. Empty when none
/// matches (the Fetch button's enable rule) and on a non-Git backend.
table GitFetchRemotes {
  names: [string];
}

/// The kind of a `RemoteRefChange`'s ref (Story 9.24). Mirrors zanshin_jj::RemoteRefKind.
enum RemoteRefKind : ubyte { Bookmark, Tag }

/// How a `RemoteRefChange`'s ref differs from the view (Story 9.24). Mirrors
/// zanshin_jj::RemoteRefChangeKind.
enum RemoteRefChangeKind : ubyte { Moved, New, Deleted }

/// One ref whose `<name>@<remote>` target in the head view differs from what the remote
/// advertises now (Story 9.24, `zanshin_git_remote_changes`).
table RemoteRefChange {
  kind: RemoteRefKind;
  name: string;              // the ref's name without its namespace, e.g. "main"
  change: RemoteRefChangeKind;
  old_commit_ids: [string];  // the view's target, full hex; several for a conflicted one; empty for New
  new_commit_id: string;     // the advertised commit (an annotated tag peeled); ABSENT = Deleted
}

/// `zanshin_git_remote_changes`' answer (Story 9.24): the refs that moved, are new or were
/// deleted upstream — bookmarks before tags, each by name. Empty = nothing new.
table RemoteChanges {
  changes: [RemoteRefChange];
}

/// Classification of a path from detect_repo (FR-JJ-17).
/// Mirrors zanshin_jj::RepoKind — order must stay identical.
enum RepoKind : byte { Jj, Git, Neither, PathNotFound }

/// Result of zanshin_repo_detect.
///
/// `kind` is always set.
/// `suggested_root` and `suggested_kind` are ONLY meaningful when
/// `suggested_root` is non-null (presence == the suggestion flag, D4).
/// When kind == Neither or PathNotFound and a parent jj/git repo exists,
/// `suggested_root` is its path and `suggested_kind` its classification,
/// so the UI can offer "this folder is inside a {jj|Git} repo at <root>".
/// The backend never auto-opens; the user decides.
table RepoDetect {
  kind: RepoKind;
  suggested_root: string;
  suggested_kind: RepoKind;
}

/// Kind of async watcher event dispatched over the process-global event sink
/// (FR-FFI-4, FR-RX-1). `WatchError` is a degraded-watch signal, not a failed
/// call — the event Envelope's `ok` is always true (R5, single-emission-point:
/// the `watcher.io_error` code string is reserved for the arming-failure error
/// envelope at open/init/clone/convert).
enum WatcherEventKind : byte { OpHeadsChanged, WorkingCopyHeartbeat, WatchError }

/// One filesystem-watch event for the repo identified by `session_id`
/// (ADR-0002:57 correlation id, refined 2026-07-04: the process-unique
/// session id from `RepoHandle.session_id` — NOT the raw handle, whose
/// allocation address a close→reopen can reuse).
/// `paths` is absent for `WatchError`; `message` is set only for `WatchError`
/// (null-for-absence).
table WatcherEvent {
  session_id: uint64;
  kind: WatcherEventKind;
  paths: [string];
  message: string;
}

/// Progress notification for a long-running operation (FR-FFI-8): `git fetch` (Story 6-4a),
/// `git clone` and `git push` (Story 9.20) — `operation` is `"fetch"`, `"clone"` or `"push"`.
/// The remote-change poll (Story 9.24, `"remote_changes"` in Dart) never emits one.
/// Dispatched over the same process-global event sink as `WatcherEvent`, correlated by
/// `session_id` (same never-reused id as WatcherEvent — see RepoHandle.session_id). A clone's
/// events carry the session id its new handle will get (allocated before the clone runs).
table Progress {
  session_id: uint64;
  operation: string;
  progress: float;
  message: string;
}

/// How a graph edge's target was classified by jj's revset-graph stream.
/// Mirrors zanshin_jj::GraphEdgeKind — order must stay identical.
/// `Direct`/`Indirect` targets are in the revset (Indirect = the direct parent
/// was elided; renderers may draw it dashed); `Missing` leads outside the
/// revset and has no target node.
enum GraphEdgeKind : byte { Direct, Indirect, Missing }

/// Whether a TopologyRef is a bookmark or a tag.
enum TopologyRefKind : ubyte { Bookmark, Tag }

/// One bookmark or tag entry of a GraphTopology node (Story 4.12, zanshin_jj::CommitRef).
/// Mirrors the CLI's per-commit ref rendering: `name`, then `@remote` for a remote entry,
/// then `??` when conflicted or `*` when a local entry is not synced. `remote` is ABSENT
/// (Dart null) for the local entry — null-for-absence. Tracked-and-synced remote entries are
/// not emitted at all (the CLI's `collect_distinct_refs` rule: `is_local() || !synced`).
table TopologyRef {
  node: uint;              // the node index this entry belongs to
  kind: TopologyRefKind;
  name: string;            // bookmark/tag name, UTF-8
  remote: string;          // absent for the local entry
  synced: bool;
  conflicted: bool;
}

/// One workspace whose working-copy commit is a GraphTopology node (Story 4.12).
table TopologyWorkingCopy {
  node: uint;              // the node index
  workspace: string;       // the workspace name
}

/// The whole revset's index-only topology at one operation (Story 4.12, zanshin_jj::GraphTopology)
/// — the answer of `zanshin_graph_topology`, as scalar vectors indexed by node (n nodes, in
/// `jj log` order: children before parents, `prioritize` first) and CSR offset vectors for the
/// edges (E) and the anchors (A).
///
/// Every vector except `timestamps` is ALWAYS written, empty when n = 0. A reader treats an
/// absent one, or one of the wrong length, as a malformed buffer.
///
/// - `operation_id`: the full hex id of the operation this call loaded (after its own pre-verb
///   snapshot, if that wrote one); `zanshin_commit_contents` reads the object half pinned to it.
/// - `all_count`: `|all()|`, counted by iterating — the VISIBLE commits only, so a revset that
///   names hidden commits can yield more nodes than this.
/// - `commit_ids` / `change_ids`: the raw id bytes, n × stride, node i at [i × stride,
///   (i + 1) × stride). `commit_id_stride` / `change_id_stride` are the byte lengths of one id
///   (one length per column; both 0 iff n = 0). A reader formats a commit id as lowercase hex and
///   a change id as jj reverse-hex (nibble v → 'z' − v, high nibble first: 0 → 'z', 15 → 'k').
/// - `flags`: one byte per node — bit 0 working_copy (this workspace's @), 1 immutable
///   (in ::(immutable_heads() | root())), 2 hidden, 3 divergent, 4 root, 5 has_change_offset;
///   bits 6-7 are zero.
/// - `change_offset`: the node's index among the commits sharing its change id; meaningful ONLY
///   when flags bit 5 is set (presence bit — flatc 25.12.19 has no optional scalar for Dart),
///   0 otherwise.
/// - `change_id_prefix_len` / `commit_id_prefix_len`: the shortest unique prefix lengths in hex
///   digits, within the `short_prefixes` disambiguation set (or the full index when disabled).
/// - `parent_count`: the commit's real parent count, Missing parents included (0 for the root);
///   read from the index, never from the edges.
/// - Edges, CSR: node i's edges are [edge_start[i], edge_start[i + 1]); `edge_start` has n + 1
///   entries, edge_start[0] == 0, edge_start[n] == E. Within a node they are in jj's stream
///   order, repeated targets kept (a merge can carry a Direct AND an Indirect edge to one node).
///   `edge_target` is the target's node index, defined iff `edge_kind != Missing`; a Missing
///   edge's slot holds -1 (a reader that skips the kind check fails loudly instead of linking
///   node 0) and Dart reads it as null.
/// - `timestamps`: the committer timestamps, millis since the Unix epoch — ABSENT iff the call
///   did not request them; when present, n entries, and the root's slot is 0 (Dart null: the
///   root carries none).
/// - `refs`: sorted by node; per node its bookmarks, then its tags, each in zanshin-jj's order.
/// - `working_copies`: sorted by node; per node in zanshin-jj's order. Empty in a
///   single-workspace repo (the CLI's guard).
/// - Anchors, CSR: anchor a's nodes are anchor_node[anchor_start[a] .. anchor_start[a + 1]],
///   ascending (= `jj log` order); `anchor_start` has A + 1 entries.
table GraphTopology {
  operation_id: string;
  all_count: ulong;
  commit_ids: [ubyte];             // n × commit_id_stride
  change_ids: [ubyte];             // n × change_id_stride
  commit_id_stride: ubyte;         // 0 iff n = 0
  change_id_stride: ubyte;         // 0 iff n = 0
  flags: [ubyte];                  // n
  change_offset: [uint];           // n; 0 when flags bit 5 is clear
  change_id_prefix_len: [ubyte];   // n
  commit_id_prefix_len: [ubyte];   // n
  parent_count: [uint];            // n
  edge_start: [uint];              // n + 1
  edge_target: [int];              // E; -1 iff Missing
  edge_kind: [GraphEdgeKind];      // E
  timestamps: [long];              // n iff requested, absent otherwise; root slot 0
  refs: [TopologyRef];             // sorted by node
  working_copies: [TopologyWorkingCopy]; // sorted by node
  anchor_start: [uint];            // A + 1
  anchor_node: [uint];             // anchor_start[A] entries
}

/// The repo's EFFECTIVE `jj log` defaults (Story 4.9) — what the user's own jj
/// CLI would apply, after their `[revsets]` / `[ui]` config overrides.
///
/// Offered as pre-fills for zanshin_graph_topology's `revset` / `prioritize` /
/// `short_prefixes` pass-throughs (FR-JJ-17); nothing is applied silently, the
/// caller decides. `short_prefixes` falls back to `log` when
/// `revsets.short-prefixes` is ABSENT; an explicit empty string means
/// disambiguation is DISABLED and is returned verbatim. `synthetic_elided` is the
/// effective config value only — the topology call takes no such parameter
/// (Story 4.12: it emits no synthetic nodes).
table LogDefaults {
  log: string;                  // revsets.log
  log_graph_prioritize: string; // revsets.log-graph-prioritize
  short_prefixes: string;       // revsets.short-prefixes (falls back to log on absence)
  synthetic_elided: bool;       // ui.log-synthetic-elided-nodes
}

/// Outcome of a successful mutation (Story 6-1/6-2/6-4a, FR-JJ-10a/FR-JJ-13/FR-JJ-14a):
/// `zanshin_describe`/`_new_change`/`_edit`/`_abandon`/`_undo`/`_git_fetch` and the later
/// mutation verbs (e.g. `_rebase`, `_metaedit`, `_duplicate`; `_fix` nests it in `FixResult`).
/// `new_change_ids` / `abandoned_change_ids` are empty when the mutation mints
/// or abandons nothing (see `zanshin_jj::MutationResult`'s field docs for the
/// per-verb rules).
table MutationResult {
  new_op_id: string;
  new_change_ids: [string];
  abandoned_change_ids: [string];
  /// `@`'s change id after the mutation; ABSENT when the workspace has no working-copy commit
  /// afterwards (e.g. `zanshin_op_restore` of the root operation, Story 9.12).
  working_copy_change_id: string;
  /// The refs the colocated export could not write while the CLI's `finish_transaction`
  /// committed this call's operation (Story 9.26) — the data behind its `jj.git_export_failed`
  /// warnings. ABSENT when both lists are empty — always on a call that committed nothing, and
  /// for `zanshin_file_track` / `zanshin_file_untrack`, which never reach it. The finish's other
  /// facts (an empty identity, a `@` that became immutable, a Git HEAD that could not be reset,
  /// skipped checkout files) ride `Envelope.warnings` only (Story 9.32).
  finish: FinishFacts;
}

/// The refs the colocated Git export could not write while the CLI finished a transaction
/// (`finish_transaction`, Story 9.26) — a warning there (`jj.git_export_failed` in
/// `Envelope.warnings`), the data here, never an error envelope.
table FinishFacts {
  export_failed_bookmarks: [GitExportFailure];
  export_failed_tags: [GitExportFailure];
}

/// One path an operation could not process, with the verbatim reason.
///
/// Three payloads carry it: `AbsorbResult.skipped_paths` — a path jj-lib refused to split
/// ("Is a symlink", "Is a conflict", "Is a Git submodule", "Access is denied: …");
/// `FileContents.skipped` — a path that is not renderable as file content
/// ("Path '…' exists but is not a file.", "Path '…' exists but access is denied: …",
/// "Path '…' is absent.", "Path '…' is a directory." — the last two are the cases the CLI
/// `panic!`s on, which a library reports instead of aborting the process); and
/// `FileSearch.skipped` — a path whose blob could not be READ, with `jj file search`'s own
/// sentence ("Skipping '…' due to permission error: …"). Note the two file verbs skip
/// DIFFERENT sets with DIFFERENT wording: that is CLI parity, not an inconsistency. In every
/// case the call SUCCEEDS for the remaining paths; the CLI prints one warning per entry.
table SkippedPath {
  path: string;      // repo-relative, jj's internal `/`-separated form
  reason: string;    // the CLI's / jj-lib's own message, forwarded unchanged
}

/// Outcome of a successful `zanshin_absorb` (Story 9.3, FR-JJ-10a).
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has
/// one definition; its `new_change_ids` / `abandoned_change_ids` are always empty here.
/// An EMPTY `rewritten_change_ids` means nothing was absorbable — and then no operation
/// was written either, so `mutation.new_op_id` is the PRE-CALL op-log head.
/// `source_change_id` is ABSENT when jj-lib abandoned the source (it became discardable)
/// or when nothing moved — null-for-absence.
/// `num_rebased` excludes the destination commits and includes the rewritten source
/// (jj-lib's own `AbsorbStats::num_rebased` accounting). jj-lib counts in `usize`; a
/// count above `uint`'s range SATURATES at 4294967295 rather than wrapping — it is a
/// progress figure for the UI, never something a decision keys off.
table AbsorbResult {
  mutation: MutationResult;
  rewritten_change_ids: [string];   // destination ChangeIds, reverse-hex, forward topological order
  source_change_id: string;         // absent when the source was abandoned or nothing moved
  num_rebased: uint;
  skipped_paths: [SkippedPath];
}

/// Outcome of a successful `zanshin_squash_plan` (Story 9.15): the description `zanshin_squash`
/// would have to ask for. `combined_description` is the text the CLI's editor holds, saved
/// unchanged — exactly what `zanshin_squash` writes without `message` — when the abandoned
/// sources and the destination carry two or more non-empty descriptions and neither `message`
/// nor `use_destination_message` is set; ABSENT otherwise (nothing to ask) — null-for-absence.
table SquashPlan {
  combined_description: string;
}

/// Outcome of a successful `zanshin_split` (Story 9.15).
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has one
/// definition; its `new_change_ids` holds the one commit that got a NEW change id (the remaining
/// commit for a plain or parallel split, the selected one for `-o`/`-A`/`-B`).
/// `selected_change_id` holds the selected changes, `remaining_change_id` the rest; `@` ends on
/// the remaining commit when the target was `@`.
table SplitResult {
  mutation: MutationResult;
  selected_change_id: string;
  remaining_change_id: string;
}

/// What one `jj fix` tool run wrote to stderr (Story 9.9) — the CLI copies it to the terminal
/// under `<path>:`.
table FixToolStderr {
  path: string;      // the file, as the CLI renders it from the workspace root
  stderr: string;    // the tool's stderr, lossy UTF-8
}

/// Outcome of a successful `zanshin_fix` (Story 9.9).
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has one
/// definition; its `new_change_ids` / `abandoned_change_ids` are always empty. With
/// `num_fixed_commits == 0` no operation was written, so `mutation.new_op_id` is the PRE-CALL
/// op-log head. The two counts are jj-lib's (`fixed <n> commits`, and every source and
/// descendant visited, whether or not a file of it matched), saturating at 4294967295. `tool_stderr` holds one entry per tool run that wrote to
/// stderr, sorted by path (then text); ABSENT or EMPTY when none did.
table FixResult {
  mutation: MutationResult;
  num_fixed_commits: uint;
  num_checked_commits: uint;
  tool_stderr: [FixToolStderr];
}

// ── Drop actions (Story 9.31) ───────────────────────────────────────────────────
// Member order of the two enums below IS the wire value — APPEND only.

/// The verb a `DropAction` row previews (`S` the source, `T…` the location's ids):
/// `rebase -s S -o T…`, `rebase -r S -o T…` (or `-A`/`-B`), `squash --from S --into T [paths]`,
/// `new T… S`, `duplicate S -o T…`, `split -r S <paths> -A/-B …`, `bookmark move N --to T`,
/// `rebase -b S -o T…`, `revert -r S -o T…` (or `-A`/`-B`), `restore --from S --into T` (no
/// paths: T's WHOLE tree becomes S's), `absorb --from S --into T`, `interdiff --from S --to T` (a
/// read: never `NoOp`).
enum DropVerb : ubyte {
  RebaseSource, RebaseRevisions, Squash, NewMerge, Duplicate, Split, BookmarkMove,
  RebaseBranch, Revert, Restore, Absorb, Interdiff
}

/// Whether a previewed verb would run (`Available` — writing an operation, except `Interdiff`,
/// which only reads), run and write none (`NoOp` — only rebase, squash, bookmark move, revert,
/// restore and absorb; revert's "No revisions to revert." is unreachable through
/// `zanshin_drop_actions`, whose rows always name one change), or refuse (`Refused`).
enum ActionStatus : ubyte { Available, NoOp, Refused }

/// One previewed verb's answer. `refusal` is present exactly when `status` is `Refused`: the
/// `FfiError` the verb's own wrapper returns for it (same code, same `context`).
/// `combined_description_needed` (a squash row) — the squash would combine two or more non-empty
/// descriptions, the case the CLI opens its editor for (`zanshin_squash_plan` returns the text);
/// `allow_backwards_needed` (a bookmark row) — the move is not a fast-forward.
table ActionOutcome {
  status: ActionStatus;
  refusal: FfiError;
  combined_description_needed: bool;
  allow_backwards_needed: bool;
}

/// One row of `zanshin_drop_actions`' answer; `location` indexes the request's `locations`.
table DropAction {
  verb: DropVerb;
  location: uint;
  outcome: ActionOutcome;
}

/// `zanshin_drop_actions`' answer: every location's rows, in location order.
table DropActions {
  actions: [DropAction];
}

/// `zanshin_change_actions`' answer: the card menu's verbs for one change `X` — `new X`,
/// `new -A X`, `new -B X`, `edit X`, `describe X`, `squash -r X` (with the combined-description
/// flag) and `abandon X`. Every field is always present.
table ChangeActions {
  new_onto: ActionOutcome;
  new_insert_after: ActionOutcome;
  new_insert_before: ActionOutcome;
  edit: ActionOutcome;
  describe: ActionOutcome;
  squash_into_parent: ActionOutcome;
  abandon: ActionOutcome;
}

// ── git push (Story 9.20) ───────────────────────────────────────────────────────
// Member order of the four enums below IS the wire value — APPEND only.

/// Whether a pushed ref is a bookmark or a tag.
enum PushRefKind : ubyte { Bookmark, Tag }

/// What the push does with a ref of its plan: `Push` it, `Skip` it (the mode refused it or a
/// commit it would push; warned, the rest is pushed), or `Abort` (an explicitly named ref is
/// refused — only a dry run gets this far).
enum PushPath : ubyte { Push, Skip, Abort }

/// What happened to a ref after a real push. `NotReached = 0` (the absent-field default) = a
/// plan, a skipped ref, or a remote the push did not reach.
enum PushRefStatus : ubyte { NotReached, Pushed, LeaseRejected, RemoteRejected, Unexported }

/// Why a push failed after its planning phase: a dry run's explicit `RefRefused` /
/// `CommitRejected` (the real run's error codes), `SomeRefsFailed` (the CLI's "Failed to push
/// some bookmarks", possibly recorded), `PushError` (the push stopped at a remote, nothing
/// recorded; or a step after the push loop failed, and `recorded` says whether the operation
/// was written), `Cancelled` (Story 9.52: the push's cancel token was cancelled — it stopped
/// before the next remote; nothing recorded, `PushRemote.finished` says which remotes got their
/// refs). Member order IS the wire value — APPEND only.
enum PushFailureKind : ubyte { RefRefused, CommitRejected, SomeRefsFailed, PushError, Cancelled }

/// The CLI's message and hint for a refused ref, verbatim. `hint` ABSENT where the CLI gives
/// none.
table PushRefusal {
  message: string;
  hint: string;
}

/// A commit the push refuses to send: its full hex id, the reasons in the CLI's order, the CLI's
/// text for the ref's path and its hints ("Rejected commit: …" on the abort path, the
/// `git.private-commits` hint for a private commit).
table PushCommitRejection {
  commit_id: string;
  reasons: [string];
  message: string;
  hints: [string];
}

/// One ref of a remote's plan. `before` / `after` are full commit hex ids — ABSENT when the ref
/// is absent on that side, or the ref is refused as conflicted or untracked; `action` is the move
/// in jj's words ("move forward from <old> to <new>", "add to <new>", "delete from <old>"), ABSENT
/// for such a refused ref.
/// `refusal` is the mode's refusal (Skip / Abort), `explicit_refusal` the one the ref would get if
/// named explicitly (ABSENT = it could be), `rejection` the commit the push refuses to send.
/// `status` / `status_reason` after a real push.
table PushRef {
  kind: PushRefKind;
  name: string;
  before: string;
  after: string;
  action: string;
  path: PushPath;
  refusal: PushRefusal;
  explicit_refusal: PushRefusal;
  rejection: PushCommitRejection;
  status: PushRefStatus;
  status_reason: string;
}

/// A ref and its kind — an explicitly named ref that already matches (the CLI's "Bookmark
/// <name>@<remote> already matches <name>").
table PushRefName {
  kind: PushRefKind;
  name: string;
}

/// One remote's plan and result. `finished` = the push to it ran; `error` = the CLI's
/// `GitPushError` text that stopped the push there (ABSENT otherwise).
table PushRemote {
  name: string;
  refs: [PushRef];
  already_matches: [PushRefName];
  finished: bool;
  error: string;
}

/// A bookmark `--change` created ("Creating bookmark <name> for revision <change>").
table PushCreatedBookmark {
  name: string;
  change_id: string;
}

/// What sign-on-push did: "Updated signatures of N commits." / "Rebased N descendant commits."
/// Counts saturate at 4294967295.
table PushSigning {
  updated_signatures: uint;
  rebased_descendants: uint;
}

/// A push failure as data — the CLI's non-zero exit — with the CLI's text and hint.
table PushFailure {
  kind: PushFailureKind;
  message: string;
  hint: string;
}

/// Outcome of `zanshin_git_push` (Story 9.20): the plan per remote and ref, and after a real push
/// what happened. `hints` are the hints a UI shows verbatim ("Pushing to the only existing remote:
/// …", the push-stats hints). `signing` ABSENT when sign-on-push did not run. `nothing_changed` =
/// the CLI's "Nothing changed.". `recorded` = the push's operation was written; `description` is
/// that operation's description (a dry run's: the one the real push would write; ABSENT when
/// nothing changed); `new_op_id` the head after the call. `failure` ABSENT on full success.
table GitPushResult {
  remotes: [PushRemote];
  created_bookmarks: [PushCreatedBookmark];
  hints: [string];
  signing: PushSigning;
  nothing_changed: bool;
  dry_run: bool;
  recorded: bool;
  description: string;
  new_op_id: string;
  failure: PushFailure;
}

/// What a tree entry IS (Story 9.4) — the CLI's `TreeEntry.file_type` keyword
/// (`cli/src/commit_templater.rs::describe_file_type` @ v0.44.0).
/// `Tree` is UNREACHABLE through `zanshin_file_list` (jj-lib's `entries_matching` recurses
/// into subtrees rather than yielding them) but is modelled so the mapping is total. jj's
/// sixth case — an ABSENT entry, rendered as `""` — is never emitted and has no member.
// Member order IS the wire value (File == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `union Payload` below.
enum FileType : byte { File, Symlink, Tree, GitSubmodule, Conflict }

/// One entry of a revision's tree (Story 9.4), modelled on the CLI's `TreeEntry` keywords.
///
/// The CLI's `conflict` keyword (`!value.is_resolved()`) has no field of its own: it is
/// exactly `file_type == Conflict`, so carrying it too would be a second, desyncable
/// spelling of one fact.
/// `executable` is false for a symlink, a submodule, and a conflict whose sides disagree
/// about the bit (the CLI's `unwrap_or_default()`). `conflict_side_count` is the SIMPLIFIED
/// merge's side count: 1 for a resolved entry, >= 2 for a conflict (`Merge::num_sides()` is
/// `values.len() / 2 + 1`, so the smallest conflict has two sides); it saturates at
/// 4294967295. A subtree that CONFLICTS with a non-tree is emitted as one entry with
/// file_type == Conflict and is not descended into — render it as an opaque conflict, not
/// an empty directory.
table FileEntry {
  path: string;                // repo-relative, jj's internal `/`-separated form
  file_type: FileType;
  executable: bool;
  conflict_side_count: uint;
}

/// The entries of a revision's tree, in jj-lib's own `entries_matching` (tree) order.
table FileList {
  entries: [FileEntry];
}

/// One file's content as `jj file show` would print it (Story 9.4).
///
/// `content` is `[ubyte]`, not `string`: a tracked file is not guaranteed UTF-8. For a
/// conflicted path it is the MATERIALIZED merge, with markers in the style the repo's
/// EFFECTIVE `ui.conflict-marker-style` selects (re-read per call, never cached).
table ShownFile {
  path: string;
  content: [ubyte];
  conflict: bool;
}

/// The result of `zanshin_file_show` (Story 9.4): the files that could be rendered, plus
/// the paths that could not — a symlink, a Git submodule, an unreadable blob, and the two
/// cases the CLI `panic!`s on rather than reports (an absent value, a bare directory). A
/// skipped path does NOT fail the call — the CLI prints a warning per entry and keeps
/// going. Every reason string is listed on SkippedPath.
table FileContents {
  files: [ShownFile];
  skipped: [SkippedPath];
}

/// One annotated line of a file (Story 9.4) — `jj file annotate`'s per-line row.
///
/// `original_line_number` is 1-BASED: jj-lib reports it 0-based and the CLI adds 1. There is
/// deliberately no `line_number` field — a line's own number is its 1-based index in
/// `FileAnnotation.lines`. `origin_found` is false when the search stopped at the domain
/// boundary and `commit_id` is only where it stopped; the CLI collapses that case to the
/// root commit for display, this payload keeps the distinction.
table AnnotationLine {
  commit_id: string;           // CommitId hex of the originating commit
  change_id: string;           // that commit's ChangeId, reverse-hex
  original_line_number: uint;  // 1-based, in the ORIGINATING commit's version; saturates at 4294967295
  content: [ubyte];            // the raw line, newline included when the source had one
  origin_found: bool;
}

/// A file's annotation: one entry per line, in file order.
table FileAnnotation {
  lines: [AnnotationLine];
}

/// One matching line of `zanshin_file_search` (Story 9.4).
///
/// `line_number` is 1-based within the searched content. `conflict_side` is meaningful ONLY
/// when has_conflict_side == true (presence pair, same rule as ShowRequest.limit: flatc
/// 25.12.19 rejects optional scalars for Dart); it is the 0-based side of a conflicted
/// path, whose line numbers restart at each side — there is no meaningful unified numbering
/// across sides (the CLI's own reasoning at `search.rs:146-147`).
table SearchMatch {
  path: string;
  line_number: uint;           // saturates at 4294967295, as conflict_side does
  content: [ubyte];            // the raw matching line, newline included
  conflict_side: uint;         // 0 / ignored when has_conflict_side == false
  has_conflict_side: bool;
}

/// The matches of `zanshin_file_search`, in `entries_matching` (tree) order then line order,
/// plus the paths that could not be searched.
///
/// `skipped` carries ONLY unreadable blobs (`AccessDenied`) — the single case
/// `jj file search` warns about. Symlinks, Git submodules and non-file conflicts are skipped
/// SILENTLY there and never appear here, which is the exact OPPOSITE of `jj file show`
/// (whose `FileContents.skipped` reports the symlink/submodule cases and uses different
/// wording). An empty `skipped` with an empty `matches` therefore means "nothing matched",
/// which is now distinguishable from "a blob was unreadable".
table FileSearch {
  matches: [SearchMatch];
  skipped: [SkippedPath];
}

/// How one remote ref changed during `zanshin_git_import` (Story 9.5) — the CLI's own
/// derivation from `(old_remote_ref.target.is_absent(), new_target.is_absent())`
/// (`cli/src/git_util.rs:418-425` @ v0.44.0).
// Member order IS the wire value (New == 0, the FlatBuffers default) — APPEND only, never
// reorder, exactly as for `FileType` above and `union Payload` below.
enum GitRefUpdateKind : byte { New, Updated, Deleted }

/// One remote bookmark or tag `zanshin_git_import` changed (Story 9.5).
///
/// These are the four facts the CLI renders per line
/// (`"{label}: {symbol} [{import_status}] {tracking_status}"`); the column padding and the
/// colouring are the terminal UX Zanshin replaces. `tracked` is read from the POST-import
/// view, not from the old remote ref — a freshly-imported ref's tracking state is decided
/// during the import itself.
table GitRefUpdate {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to, e.g. "origin"
  kind: GitRefUpdateKind;
  tracked: bool;
}

/// Outcome of a successful `zanshin_git_import` (Story 9.5) — the CLI's `jj git import`.
///
/// `mutation` is NESTED rather than flattened so the op-id / working-copy contract has one
/// definition (the `AbsorbResult` precedent); its `new_change_ids` /
/// `abandoned_change_ids` are always empty here — an import's own abandonments are
/// `abandoned_change_ids` on THIS table, a different fact from the caller-supplied id list
/// `MutationResult.abandoned_change_ids` echoes for `zanshin_abandon`.
///
/// If nothing needed importing NO operation was written, and `mutation.new_op_id` is the
/// PRE-CALL op-log head. `failed_ref_names` is still reported in that case: a run where
/// every pending ref failed changes nothing yet must say so, and nothing in the repository
/// state lets a caller re-derive the list afterwards. A failed ref is NEVER an error — the
/// CLI warns and exits 0. Names are lossy-UTF-8 (a git ref name is not guaranteed UTF-8);
/// one under `refs/remotes/git/` is the reserved-namespace case.
///
/// `num_rewritten` is a plain COUNT because a count is all the CLI reports
/// ("Updated {n} rewritten commits."); it saturates at 4294967295, as `AbsorbResult`'s own
/// count does.
table GitImportResult {
  mutation: MutationResult;
  changed_bookmarks: [GitRefUpdate];
  changed_tags: [GitRefUpdate];
  abandoned_change_ids: [string];   // ChangeIds, reverse-hex, of commits unreachable in git
  num_rewritten: uint;
  failed_ref_names: [string];
}

/// One remote ref `zanshin_git_export` could not write to git (Story 9.5).
///
/// `reason` is jj-lib's own reason rendered as the FLATTENED `source()` chain joined by
/// `": "`, exactly as the CLI prints it: the two interesting variants
/// (`FailedToDelete`/`FailedToSet`) hide the real cause behind `#[source]`, so the
/// top-level message alone would say only "Failed to set".
table GitExportFailure {
  name: string;      // bookmark/tag name, UTF-8
  remote: string;    // the remote it belongs to; "git" for the local git repo's own refs
  reason: string;
}

/// Outcome of a successful `zanshin_git_export` (Story 9.5) — the CLI's `jj git export`.
///
/// `mutation` is NESTED for the same reason as in `GitImportResult`; export never moves `@`
/// and never mints or abandons a change, so its two id vectors are always empty. If git
/// already matched, NO operation was written and `mutation.new_op_id` is the PRE-CALL
/// op-log head.
///
/// Failed refs ride in the RESULT, never as an error envelope: the CLI warns and exits 0,
/// and an export whose only outcome is a failure list must still be readable. The classic
/// case is two bookmarks named `foo` and `foo/bar`, which git cannot both hold.
/// `failed_tags` only ever contains `@git` tags — git has no remote tags.
table GitExportResult {
  mutation: MutationResult;
  failed_bookmarks: [GitExportFailure];
  failed_tags: [GitExportFailure];
}

/// One revision as `zanshin_show` presents it (Story 9.6): its metadata plus what it changed.
///
/// `change` is the SHIPPED `Change` table — byte-identical to what `zanshin_change` returns for
/// the same commit, because both come from one construction site in `zanshin-jj`.
/// `file_changes` is the SHIPPED `FileChange` table: the diff of the commit's MERGED parent tree
/// against its own tree, classified into Added/Modified/Removed/Renamed/Copied exactly as the
/// CLI's `diff_status_inner` does. For a MERGE commit that is only what the merge itself
/// changed; for the ROOT commit it is empty. Copy records are accumulated over EVERY parent
/// (the CLI's `show_patch`), so `Renamed`/`Copied` CAN appear here — unlike in `InterdiffView`.
///
/// There is no textual patch: line/word-level diffing is Epic 5 (`zanshin-diff`), which will
/// EXTEND this payload rather than replace it.
///
/// `parent_tree_ids` (Story 9.50) is the tree `file_changes` diff against — the commit's merged
/// parent tree, what split/squash/commit diff against — as hex tree ids in order (one for a
/// resolved tree, an odd number for a conflicted merge of parents): the `left` a hunk selection
/// (`zanshin_select_tree`) is made against.
table ShowEntry {
  change: Change;
  file_changes: [FileChange];
  parent_tree_ids: [string];
}

/// The result of `zanshin_show`: one entry per commit the revset denotes, in RAW revset order
/// (topological, children before parents). A revset matching nothing is an EMPTY list and a
/// SUCCESS. Entries are per COMMIT, not per change: a revset naming two commits of ONE
/// divergent change yields two entries carrying the same `Change.id`, both with
/// `Change.divergent` set. Reaching that state takes their commit hexes, though — a bare
/// divergent change-id symbol never gets this far, because jj-lib's `SymbolResolver` refuses it
/// first (see ShowRequest).
table ShowView {
  entries: [ShowEntry];
}

/// One step of a change's evolution as `zanshin_evolog` walks it (Story 9.6).
///
/// `change` is the shipped `Change` table for THIS version of the change — with two exceptions
/// that come from reusing the single `Change` construction site: `divergent` reports whether
/// the change has several VISIBLE commits RIGHT NOW (the same answer on every row of one
/// evolution, never a statement about this historical version) and `is_anonymous` reads today's
/// local bookmarks. Everything else (commit_id, parents, description, signatures, timestamps,
/// conflict) is this version's own.
/// Rows carry commit ids
/// in `predecessor_commit_ids` rather than change ids: every predecessor shares the change's own
/// id, and predecessors are HIDDEN by construction, so a change id could not be resolved back.
/// They ARE addressable by `zanshin_interdiff`, as a CommitIdRef (see InterdiffRequest): that is
/// how the two verbs compose into a version-to-version diff.
/// `operation_id` is the operation that created or rewrote this commit and is ABSENT
/// (null-for-absence) for an entry the walk emitted from its flush tail — it reached an
/// operation storing no predecessors and could go no further. That absence is the ONLY signal a
/// caller has that an evolution may be TRUNCATED; the CLI truncates silently. When it is absent
/// `predecessor_commit_ids` is always empty.
table EvologEntry {
  change: Change;
  predecessor_commit_ids: [string];  // CommitIds, hex; empty when operation_id is absent
  operation_id: string;              // op id, plain forward hex; absent for the walk's flush tail
}

/// The result of `zanshin_evolog`: the evolution entries in RAW walk order (newest first). The
/// CLI's `--reversed` and its graph mode's `TopoGroupedGraph` re-ordering are rendering the GUI
/// does itself, and are not applied. `limit = 0` is an EMPTY list and a success.
table EvologView {
  entries: [EvologEntry];
}

/// The result of `zanshin_interdiff` (Story 9.6): what `to` changes that `from` does not, with
/// the parent difference factored out by rebasing `from` onto `to`'s parents in memory.
///
/// Reuses the shipped `FileChange` table. `Renamed`/`Copied` NEVER appear here: the CLI's
/// `show_inter_diff` passes `CopyRecords::default()`, and that asymmetry with `ShowEntry` is
/// reproduced deliberately rather than corrected. Identical trees are an EMPTY list and a
/// success, as is a path filter that matches nothing.
///
/// `base_has_conflicts` reports whether the REBASED `from` tree — the LEFT side of the diff,
/// which exists only in memory — is conflicted. It is a ZANSHIN-SIDE addition: the CLI signals
/// this by rendering conflict markers in the patch TEXT, which is Epic 5's surface here, so a
/// caller would otherwise see a plausible change list derived from a conflicted rebase with no
/// way to tell. It is true whatever the cause — the 3-way merge left the conflict, OR
/// `rebase_to_dest_parent`'s fast path (same parents) returned `from`'s own already-conflicted
/// tree. `to`'s own conflict state is NOT reported here; that is `Change.conflict`'s job, via
/// `zanshin_show` / `zanshin_change`. The flag describes the TREE, not the filtered result:
/// a `paths` filter matching nothing still leaves it set.
table InterdiffView {
  file_changes: [FileChange];
  base_has_conflicts: bool;
}

/// One row of `zanshin_workspace_list` (Story 9.7) — the CLI's `jj workspace list`.
///
/// `name` and `wc_commit_id` are the VIEW half (`View::wc_commit_ids()`), the same pair
/// `zanshin_jj::WorkingCopy` carries; `root` is the half that lives in the WorkspaceStore.
/// `root` is the RECORDED path, reported even when the directory moved or was deleted, as the
/// CLI's list template does since jj 0.46 (`cli/src/commit_templater.rs:1896-1906` @ v0.46.0).
/// It is ABSENT (null-for-absence) only when no path can be reported — the workspace predates
/// jj 0.38.0 and has no recorded path, or the store is unreadable. That absence NEVER fails the
/// listing. When present it is an ABSOLUTE path, not canonicalized; CWD-relative shortening is
/// the GUI's job.
table WorkspaceEntry {
  name: string;             // workspace name, UTF-8; "default" in a single-workspace repo
  wc_commit_id: string;     // CommitId hex of that workspace's working-copy commit
  root: string;             // absolute recorded workspace root; ABSENT when none can be reported
}

/// The result of `zanshin_workspace_list`: one row per workspace, in jj-lib's own BTreeMap
/// order (lexicographic by workspace name), which is preserved rather than re-sorted.
table WorkspaceList {
  entries: [WorkspaceEntry];
}

/// The result of `zanshin_workspace_root` (Story 9.7): one absolute workspace root directory.
///
/// Always present on a successful call — unlike `WorkspaceEntry.root`, which is optional. That
/// asymmetry is the CLI's own: `jj workspace list` degrades to no root while
/// `jj workspace root --name` refuses when there is no path to report, and it is reproduced here
/// rather than unified. A recorded directory that does not exist is reported anyway, with a
/// `jj.workspace_path_inaccessible` warning on the envelope.
table WorkspaceRoot {
  root: string;
}

/// `UntrackedReason` arm: the file is larger than the effective `snapshot.max-new-file-size`
/// (Story 9.22). Both sizes are in bytes.
table FileTooLarge {
  size: ulong;
  max_size: ulong;
}

/// `UntrackedReason` arm: the file does not match the snapshot's start-tracking fileset —
/// `snapshot.auto-track`, or the paths a `zanshin_file_track` named (Story 9.22). No fields:
/// the arm IS the fact.
table FileNotAutoTracked {}

/// Why a new file stayed untracked after a snapshot (Story 9.22) — jj-lib's `UntrackedReason`.
/// Member order IS the wire discriminant (no explicit numbers) — APPEND only.
union UntrackedReason {
  FileTooLarge,
  FileNotAutoTracked
}

/// One new file a snapshot left untracked, and why (Story 9.22).
table UntrackedPath {
  path: string;                 // repo-relative, jj's internal `/`-separated form
  reason: UntrackedReason;      // two vtable slots: reason_type + reason
}

/// What a working-copy snapshot could NOT record (Story 9.22) — the facts the CLI's snapshot
/// warnings print. ONE definition shared by TrackResult, UntrackResult and Precondition (Story 9.26).
/// `invalid_utf8_paths` are files skipped because their NAME is not valid UTF-8, rendered as
/// `"<dir>/<name>"` (the bare name at the root) with the name lossily decoded.
table SnapshotStats {
  untracked: [UntrackedPath];   // jj-lib's (path) order
  invalid_utf8_paths: [string];
}

/// Outcome of a successful `zanshin_file_track` (Story 9.22) — the CLI's `jj file track`.
///
/// An operation (`track paths`) is ALWAYS written, even when nothing matched: the CLI commits
/// unconditionally. `mutation.working_copy_change_id` is the PRE-call `@`: like the CLI, the
/// verb records the tracked paths only in the working-copy STATE, and the NEXT snapshot moves
/// them into `@` and rebases its children (jj's GH #8298) — which is also why `num_rebased` is
/// 0 today. It saturates at 4294967295, as `AbsorbResult`'s does.
table TrackResult {
  mutation: MutationResult;
  num_rebased: uint;
  snapshot_stats: SnapshotStats;
}

/// Outcome of a successful `zanshin_file_untrack` (Story 9.22) — the CLI's `jj file untrack`.
///
/// An operation (`untrack paths`) is ALWAYS written; `@` is rewritten without the matched
/// entries (same change id) and `num_rebased` counts its rebased descendants (saturating).
/// `unmatched_paths` are the requested paths with no entry in the pre-call `@` — the CLI's
/// "No matching entries for paths" warning — in request order. `snapshot_stats` is the
/// post-reset snapshot's. `failed_bookmarks` / `failed_tags` are the colocated git export's
/// per-ref failures (never an error envelope); both are empty outside a colocated workspace.
table UntrackResult {
  mutation: MutationResult;
  num_rebased: uint;
  unmatched_paths: [string];
  snapshot_stats: SnapshotStats;
  failed_bookmarks: [GitExportFailure];
  failed_tags: [GitExportFailure];
}

/// What a working-copy checkout did to the files on disk (Story 9.23) — jj-lib's
/// `CheckoutStats`, the counts behind the CLI's "Added N files, modified N files, removed N
/// files". `skipped` is the data behind the call's `jj.checkout_files_skipped` warning.
table CheckoutStats {
  added: uint;
  updated: uint;
  removed: uint;
  skipped: uint;
}

/// Which arm of the stale-working-copy recovery ran (Story 9.23). Member order IS the wire
/// value — APPEND only.
enum StaleRecoveryOutcome : ubyte {
  NotStale,
  Updated,
  Recovered
}

/// What leaving a stale working copy did (Story 9.23) — `zanshin_workspace_update_stale`'s
/// payload, and `Precondition.stale_recovery` when `snapshot.auto-update-stale = true` recovered
/// in front of a verb.
///
/// `commit_id` (full hex): the fresh `@` (`Updated`) or the recovery commit (`Recovered`);
/// ABSENT when `NotStale`. `checkout`: PRESENT only for `Updated`. `git_head_reset_op_id`: the
/// `reset git head` operation a colocated workspace wrote before the checkout; ABSENT otherwise.
/// `snapshot_stats`: what the recovery's snapshots could not record, merged. `op_id`: the head
/// operation after the recovery.
table StaleRecovery {
  outcome: StaleRecoveryOutcome;
  commit_id: string;
  checkout: CheckoutStats;
  git_head_reset_op_id: string;
  snapshot_stats: SnapshotStats;
  op_id: string;
}

/// Outcome of a successful `zanshin_workspace_add` (Story 9.23). `mutation` is the call's LAST
/// operation, `create initial working-copy commit in workspace <name>`; its
/// `working_copy_change_id` is the NEW workspace's `@`. `workspace_root` is absolute and
/// canonical. `git_worktree_created`: a Git worktree was created for it.
table WorkspaceAddResult {
  mutation: MutationResult;
  workspace_name: string;
  workspace_root: string;
  git_worktree_created: bool;
  checkout: CheckoutStats;
}

/// What the implicit pre-verb snapshot did (Story 9.26) — the snapshot + colocated Git import
/// every CLI command whose helper is `workspace_helper` runs first, as facts. It rides
/// `Envelope.precondition`, never the `Payload` union.
///
/// `was_snapshot_taken`: the head operation changed during the precondition (`jj util
/// snapshot`'s own flag). `snapshot_stats`: what the snapshot could not record.
/// `git_head_imported`: an `import git head` operation was written; `git_head_reset`: the CLI's
/// "Reset the working copy parent to the new Git HEAD." (a previous HEAD existed).
/// `git_refs`: the `import git refs` step, in `zanshin_git_import`'s shape — PRESENT exactly when
/// the step ran (colocated workspaces), even when it changed nothing. `finish`: the ref exports
/// inside the precondition, merged; ABSENT when both lists are empty. The three rebased counts
/// saturate at 4294967295. The precondition's WARNINGS (an immutable `@`, `.jjconflict` files,
/// refused files, …) ride `Envelope.warnings` (Story 9.32).
///
/// `stale_recovery` (Story 9.23): PRESENT when `snapshot.auto-update-stale = true` recovered a
/// stale working copy before the verb ran; the verb then ran on the recovered state.
///
/// On an error envelope it is PARTIAL: every fact up to the failing step.
table Precondition {
  was_snapshot_taken: bool;
  snapshot_stats: SnapshotStats;
  git_head_imported: bool;
  git_head_reset: bool;
  git_head_rebased: uint;
  snapshot_rebased: uint;
  git_refs: GitImportResult;
  git_refs_rebased: uint;
  finish: FinishFacts;
  stale_recovery: StaleRecovery;
}

// ── Config surface payloads (Story 9.28) ─────────────────────────────────────

/// Which layer a listed value comes from — jj-lib's `ConfigSource` (Zanshin has no
/// command-line layer). Member order IS the wire value — APPEND only.
enum ConfigValueSource : byte { Default, System, EnvBase, User, Repo, Workspace, EnvOverrides }

/// One row of `zanshin_config_list` — the CLI's `AnnotatedValue`. `name` is dotted, `value` TOML
/// text (strings stay quoted), `path` ABSENT for the default and environment layers,
/// `overridden` true when a higher layer shadows it.
table ConfigEntry {
  name: string;
  value: string;
  source: ConfigValueSource;
  path: string;
  overridden: bool;
}

/// `zanshin_config_list`'s answer, lowest layer first; empty is a result, not an error.
table ConfigListResult {
  entries: [ConfigEntry];
}

/// `zanshin_config_get`'s answer: a string unquoted, anything else TOML text.
table ConfigGetResult {
  value: string;
}

/// `zanshin_config_path`'s answer: user → every candidate in the CLI's order, existing or not;
/// repo / workspace → the one secure file (its directory now exists).
table ConfigPathResult {
  paths: [string];
}

/// `@`'s author (both CURRENT fields) when a `user.name` / `user.email` write differs from it —
/// the CLI's "only impacts future commits … use `jj metaedit --update-author`" warning.
table WorkingCopyAuthor {
  name: string;
  email: string;
}

/// `zanshin_config_set`'s answer: the file written, and — ABSENT unless it differs —
/// the working-copy author fact.
table ConfigSetResult {
  path: string;
  working_copy_author: WorkingCopyAuthor;
}

/// `zanshin_config_unset`'s answer: the file written.
table ConfigUnsetResult {
  path: string;
}

/// `zanshin_config_file_read`'s answer: the file and its exact text.
table ConfigFileText {
  path: string;
  text: string;
}

/// A repo config directory whose recorded repo no longer exists.
table MissingRepoConfig {
  config_dir: string;
  repo_path: string;
}

/// `zanshin_config_gc_list`'s answer, sorted by directory.
table ConfigGcList {
  missing: [MissingRepoConfig];
}

/// A requested directory `zanshin_config_gc_delete` did not delete, and why.
table ConfigGcFailure {
  config_dir: string;
  reason: string;
}

/// `zanshin_config_gc_delete`'s answer: `deleted` in the sorted missing order; every other
/// requested directory (not a missing repo config, or its removal failed) in `failed`.
table ConfigGcResult {
  deleted: [string];
  failed: [ConfigGcFailure];
}

/// The object half of one `jj log` row (Story 4.10, zanshin_jj::CommitContent), read at the
/// operation `zanshin_commit_contents` was pinned to. Commit-intrinsic, so a caller may cache it
/// by `commit_id`. Every string is always present (an empty author or description is `""`).
table CommitContent {
  commit_id: string;                 // full hex, lowercase
  author_name: string;               // may be empty (jj allows it)
  author_email: string;              // may be empty (jj allows it)
  committer_timestamp_millis: long;  // committer timestamp, millis since the Unix epoch
  committer_tz_offset_minutes: int;  // timezone offset, minutes east of UTC
  description: string;               // the FULL description; "" when empty
  conflict: bool;
  empty: bool;
}

/// `zanshin_commit_contents`' answer: one entry per requested id, in REQUEST order.
table CommitContents {
  contents: [CommitContent];
}

/// `zanshin_select_tree`'s answer (Story 9.50): the written tree's ids (hex, in order — one for a
/// resolved tree, an odd number for a conflicted one) and its conflict labels (empty = unlabeled,
/// else one per id). Pass both, with the request's `left`, as a verb's `TreeSelection`.
table SelectedTree {
  tree_ids: [string];
  labels: [string];
}

union Payload {
  RepoHandle,
  Diagnostics,
  Status,
  Change,
  OpLog,
  Bookmarks,
  Remotes,
  RepoDetect,
  WatcherEvent,
  Progress,
  GraphTopology,
  // Member order IS the wire discriminant — APPEND only, never reorder.
  LogDefaults,
  MutationResult,
  AbsorbResult,
  FileList,
  FileContents,
  FileAnnotation,
  FileSearch,
  GitImportResult,
  GitExportResult,
  ShowView,
  EvologView,
  InterdiffView,
  WorkspaceList,
  WorkspaceRoot,
  TrackResult,
  UntrackResult,
  ConfigListResult,
  ConfigGetResult,
  ConfigPathResult,
  ConfigSetResult,
  ConfigUnsetResult,
  ConfigFileText,
  ConfigGcList,
  ConfigGcResult,
  CommitContents,
  WorkspaceAddResult,
  StaleRecovery,
  SquashPlan,
  SplitResult,
  GitPushResult,
  GitPushRemotes,
  RemoteChanges,
  GitFetchResult,
  GitFetchRemotes,
  DropActions,
  ChangeActions,
  FixResult,
  SelectedTree,
  OpShow,
  OpDiffResult,
  OpAbandonResult,
  OpIntegrateResult,
}

// ── Envelope ──────────────────────────────────────────────────────────────────

/// One warning the call produced (Story 9.32) — the jj CLI's `ui.warning_*` output as a coded
/// fact. `code` is a registered `jj.*` warning code (`docs/rust-error-codes.md`, "Warning
/// Codes"), the thing a UI switches on. `message` is the CLI's text block for it (the warning
/// line(s) plus their detail lines, `\n`-joined, without heading or hints) — for logs and
/// tooltips only; nothing parses it.
table Warning {
  code: string;
  message: string;
}

/// Root FlatBuffers type for every fallible FFI call that returns composite data.
///
/// ok == true  → data is set to the concrete Payload variant; error is absent.
/// ok == false → error is set (code + context); data is absent (Payload::NONE).
///
/// Dart reads the buffer via the generated typed accessors. It is released by
/// reclaiming the exact Rust allocation through one of two equivalent paths:
/// zanshin_buffer_free(ptr, len) for synchronous call sites, or the
/// NativeFinalizer-backed token path (zanshin_buffer_free_token) used by the
/// FfiBuffer wrapper as a belt-and-suspenders backstop
/// (see app/lib/src/ffi/ffi_buffer.dart).
///
/// `precondition` (Story 9.26) is PRESENT whenever the verb's pre-verb snapshot RAN — on the ok
/// envelope and on an error envelope alike (then PARTIAL). It is ABSENT when the call was refused
/// before the verb ran (a null pointer, an invalid handle, a request buffer that fails
/// validation) and on every symbol that runs no pre-verb snapshot (open/init/clone/detect/close,
/// `zanshin_workspace_root`, `zanshin_log_defaults`, `zanshin_commit_contents`, `zanshin_op_abandon`,
/// events, and every
/// `zanshin_config_*` symbol except `zanshin_config_set`). `zanshin_config_set` carries it iff its `user.name`/`user.email`
/// working-copy check ran the snapshot (Story 9.28). `zanshin_repo_convert` carries the
/// conversion's snapshot report (`jj git init`'s `maybe_snapshot`, Story 9.33) iff that snapshot
/// started — on its ok envelope and on its error envelope (the state it describes stays on disk:
/// a conversion is never rolled back, Story 9.57). `zanshin_snapshot`'s success is `ok` with NO `data` and the precondition set.
/// `zanshin_workspace_update_stale` runs no pre-verb snapshot — it IS the recovery — and carries
/// the recovery's TRAILING snapshot report (Story 9.23), on its ok and its error envelope.
///
/// `warnings` (Story 9.32) are the call's warnings in the jj CLI's print order, on the ok
/// envelope AND on an error envelope (then everything warned before the failure). ABSENT when
/// the call had nothing to warn about — every reader treats absent as an empty list — and
/// therefore on every symbol that cannot warn, and on the pre-serialised `internal.panic`
/// fallback. Success without caveat is `ok` with no warnings; there is no severity field.
table Envelope {
  ok: bool;
  error: FfiError;
  data: Payload;
  precondition: Precondition;
  warnings: [Warning];
}

root_type Envelope;
