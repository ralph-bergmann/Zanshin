// SPDX-License-Identifier: MIT
//
// Core FFI envelope schema — the carrier for every fallible composite FFI call.
//
// Transport rule (ADR-0001):
//   fixed scalar              → plain C value
//   lone string               → *mut c_char (CString, freed by zanshin_string_free)
//   composite (table/list/…)  → FlatBuffers buffer (freed by zanshin_buffer_free)
//
// Every fallible extern "C" function that returns composite data returns an
// Envelope.  Infallible hot-path functions (zanshin_ffi_version,
// zanshin_string_free, zanshin_buffer_free) return plain types — no envelope.
//
// WIP: no in-wire schema_version field.  Breaking changes are in-place edits;
// callers update in the same PR.  Versioning discipline lands at 1.0.

namespace zanshin.ffi;

// ── Error ─────────────────────────────────────────────────────────────────────

/// Error detail carried when Envelope.ok == false.
/// error.code follows the AR-P-4 dotted-lowercase taxonomy:
///   <domain>.<reason>  (e.g. "jj.repo_not_found", "internal.panic")
/// Registry: docs/rust-error-codes.md.
/// Never put user data (paths, IDs) in code — those go in context.
table FfiError {
  code: string;
  context: string;
}

// ── Payload union ─────────────────────────────────────────────────────────────
// Closed registry of composite FFI return types.
// Extend this union — and regenerate both sides — as each noun lands:
//   Story 3-4a : RepoHandle  ✓
//   Story 3-8  : Diagnostics ✓
//   Story 3-4b : status ✓, change ✓, op_log ✓, bookmarks ✓, remotes ✓
//   Story 3-6  : WatcherEvent ✓, Progress ✓
//   Story 4-2  : GraphSlice ✓ (FFI wrapper 4-6)
//   Story 5-8  : Diff
//   Story 6-5  : mutation results

/// Opaque handle to an open repo session.
/// `handle` is the Rust `*mut RepoSession` reinterpreted as an unsigned integer;
/// Dart passes it back verbatim to zanshin_repo_close.
/// `session_id` is a process-unique, never-reused id allocated when the session
/// is armed; async events (WatcherEvent/Progress) carry it as their correlation
/// id. Unlike `handle` (an allocation address that a close→reopen can reuse —
/// the rawToId ABA race, resolved 2026-07-04), a session id can never be
/// misattributed to a later session.
table RepoHandle {
  handle: ulong;
  session_id: ulong;
}

/// Diagnostics payload returned by zanshin_diagnostics().
/// All three fields are compile-time or infallibly-resolved values.
table Diagnostics {
  app_version: string;
  git_sha: string;
  log_path: string;
}

/// How a working-copy file changed between @- and @.
enum ChangeKind : byte { Added, Modified, Removed, Renamed, Copied }

/// One changed file. `from_path` is set ONLY for Renamed/Copied (the source
/// path); it is absent for Added/Modified/Removed.
table FileChange {
  path: string;
  kind: ChangeKind;
  from_path: string;
}

/// Working-copy status: files changed between @ and @-, plus both change ids
/// in jj's reverse-hex display form.
table Status {
  files: [FileChange];
  working_copy_change_id: string;
  parent_change_id: string;
}

/// A commit signature: who authored/committed and when (raw jj timestamp).
table Signature {
  name: string;
  email: string;
  timestamp_millis: long;     // millis since the Unix epoch
  tz_offset_minutes: int;     // timezone offset, minutes east of UTC
}

/// Whether a change is conflict-free. `conflicted_paths` is populated only when Conflicted.
enum ConflictState : byte { Clean, Conflicted }

/// Full metadata for one change (FR-JJ-6). Authored/committed times live on the
/// author/committer signatures (authored_at == author.timestamp_millis, etc.).
table Change {
  id: string;                  // ChangeId reverse-hex (stable across rebases)
  commit_id: string;           // CommitId hex (Git SHA; changes on rebase)
  parents: [string];           // parent ChangeIds reverse-hex; empty for the root change
  description: string;         // always present, may be empty
  author: Signature;
  committer: Signature;
  is_signed: bool;             // cryptographic signature present (presence-only; 2.6 D3)
  conflict: ConflictState;
  conflicted_paths: [string];  // populated only when conflict == Conflicted
  is_anonymous: bool;
  divergent: bool;             // change id resolved to >1 visible commit (2.6 D4)
}

/// One entry in jj's operation log (FR-JJ-7).
table Operation {
  id: string;                  // op id, plain forward hex (NOT reverse-hex)
  parent_ids: [string];        // parent op ids; empty for the root op; >1 for a DAG fork
  timestamp_millis: long;      // op end-time, millis since the Unix epoch
  tz_offset_minutes: int;      // timezone offset, minutes east of UTC
  user: string;                // metadata.username; may be empty
  host: string;                // metadata.hostname; may be empty
  description: string;         // jj's user-friendly summary; always present, may be empty
  root_op: bool;               // true iff the op-store root operation
  is_snapshot: bool;           // pure working-copy-snapshot op (2.7 D6)
}

/// The operation log: reverse-chronological (head op first, root op last).
table OpLog {
  operations: [Operation];
}

/// Whether a bookmark is local-only or a tracked remote bookmark.
/// `remote_name` is populated ONLY when kind == Remote (empty for Local).
enum BookmarkKind : byte { Local, Remote }

/// One jj bookmark (FR-JJ-8). A bookmark that is both local and remote-tracked
/// appears as TWO entries: one Local, one Remote.
table Bookmark {
  name: string;          // bookmark name (UTF-8)
  target: string;        // target ChangeId, reverse-hex (stable across rebases)
  kind: BookmarkKind;
  remote_name: string;   // populated only when kind == Remote; empty for Local
}

/// The bookmark list: local + tracked-remote entries, sorted by name then kind.
table Bookmarks {
  bookmarks: [Bookmark];
}

/// One configured git remote (FR-JJ-9). `url` is the fetch URL, verbatim —
/// credentials are NOT scrubbed and SSH is NOT rewritten to HTTPS.
table Remote {
  name: string;   // remote name, e.g. "origin" (UTF-8)
  url: string;    // fetch URL, verbatim
}

/// The remote list: configured git remotes, sorted by name.
table Remotes {
  remotes: [Remote];
}

/// Classification of a path from detect_repo (FR-JJ-17).
/// Mirrors zanshin_jj::RepoKind — order must stay identical.
enum RepoKind : byte { Jj, Git, Neither, PathNotFound }

/// Result of zanshin_repo_detect.
///
/// `kind` is always set.
/// `suggested_root` and `suggested_kind` are ONLY meaningful when
/// `suggested_root` is non-null (presence == the suggestion flag, D4).
/// When kind == Neither or PathNotFound and a parent jj/git repo exists,
/// `suggested_root` is its path and `suggested_kind` its classification,
/// so the UI can offer "this folder is inside a {jj|Git} repo at <root>".
/// The backend never auto-opens; the user decides.
table RepoDetect {
  kind: RepoKind;
  suggested_root: string;
  suggested_kind: RepoKind;
}

/// Kind of async watcher event dispatched over the process-global event sink
/// (FR-FFI-4, FR-RX-1). `WatchError` is a degraded-watch signal, not a failed
/// call — the event Envelope's `ok` is always true (R5, single-emission-point:
/// the `watcher.io_error` code string is reserved for the arming-failure error
/// envelope at open/init/clone/convert).
enum WatcherEventKind : byte { OpHeadsChanged, WorkingCopyHeartbeat, WatchError }

/// One filesystem-watch event for the repo identified by `session_id`
/// (ADR-0002:57 correlation id, refined 2026-07-04: the process-unique
/// session id from `RepoHandle.session_id` — NOT the raw handle, whose
/// allocation address a close→reopen can reuse).
/// `paths` is absent for `WatchError`; `message` is set only for `WatchError`
/// (null-for-absence).
table WatcherEvent {
  session_id: uint64;
  kind: WatcherEventKind;
  paths: [string];
  message: string;
}

/// Progress notification for a long-running operation (FR-FFI-8), e.g. `git
/// fetch` (producer lands in Story 6-4a). Dispatched over the same
/// process-global event sink as `WatcherEvent`, correlated by `session_id`
/// (same never-reused id as WatcherEvent — see RepoHandle.session_id).
table Progress {
  session_id: uint64;
  operation: string;
  progress: float;
  message: string;
}

/// How a graph edge's target was classified by the revset-graph stream.
/// Mirrors zanshin_graph::EdgeKind — order must stay identical.
/// `Direct`/`Indirect` targets are in the revset (Indirect = the direct parent
/// was elided; renderers may draw it dashed); `Missing` leads outside the
/// revset and never reserves a lane.
enum GraphEdgeKind : byte { Direct, Indirect, Missing }

/// One routed parent edge of a GraphRow (Story 4.2).
/// `target_lane` is meaningful ONLY when kind != Missing (presence == the
/// kind flag, same pattern as RepoDetect.suggested_kind / Bookmark.remote_name):
/// a Missing edge never lands in a lane, so Rust writes 0 and Dart models it
/// as null. flatc 25.12.19 rejects optional scalars (`= null`) for Dart.
table GraphRowEdge {
  target: string;          // parent commit id, hex
  target_lane: uint;       // lane the edge is routed to; 0 / ignored when kind == Missing
  kind: GraphEdgeKind;
}

/// One bookmark or tag entry on a GraphRow (Story 4.8, zanshin_jj::CommitRef).
/// Mirrors the CLI's per-commit ref rendering: `name`, then `@remote` for a
/// remote entry, then `??` when conflicted or `*` when a local entry is not
/// synced. `remote` is ABSENT (Dart null) for the local entry — null-for-absence.
/// Tracked-and-synced remote entries are not emitted at all (the CLI's
/// `collect_distinct_refs` rule: `is_local() || !synced`).
table GraphCommitRef {
  name: string;            // bookmark/tag name, UTF-8
  remote: string;          // absent for the local entry
  synced: bool;
  conflicted: bool;
}

/// One lane passing vertically THROUGH a GraphRow (Story 4.8,
/// zanshin_graph::ActiveLane) — it neither starts nor ends at that row's node.
/// `kind` is the kind of the edge that opened the segment, so a renderer can
/// style it without reading any neighbouring row; the color is lane % PALETTE_SIZE.
table GraphActiveLane {
  lane: uint;
  kind: GraphEdgeKind;
}

/// `jj log`-parity display metadata for one commit row (Story 4.8,
/// zanshin_jj::CommitMeta), extracted from the SAME head-resolved snapshot as the
/// lane assignment. Ids are full; the `*_prefix_len` fields are the
/// shortest-unique-prefix lengths the UI highlights.
///
/// `change_offset` is meaningful ONLY when has_change_offset == true (presence
/// pair, same pattern as GraphRowEdge.target_lane: flatc 25.12.19 rejects
/// optional scalars for Dart). The CLI renders `/<offset>` only for
/// hidden/divergent commits — that is a UI decision, reproducible from the flags.
table GraphRowMeta {
  change_id: string;                 // ChangeId reverse-hex display form
  change_id_prefix_len: uint;
  commit_id_prefix_len: uint;
  change_offset: uint;               // 0 / ignored when has_change_offset == false
  has_change_offset: bool;
  author_name: string;               // may be empty (jj allows it)
  author_email: string;              // may be empty (jj allows it)
  committer_timestamp_millis: long;  // committer timestamp, millis since the Unix epoch
  committer_tz_offset_minutes: int;  // timezone offset, minutes east of UTC
  bookmarks: [GraphCommitRef];
  tags: [GraphCommitRef];
  working_copies: [string];          // EVERY workspace whose wc commit this is (incl. the current one); empty in a single-workspace repo (the CLI's guard)
  working_copy: bool;                // this workspace's @
  immutable: bool;                   // in ::(immutable_heads() | root())
  conflict: bool;
  empty: bool;
  hidden: bool;
  divergent: bool;
  root: bool;
  description_first_line: string;    // "" when the description is empty
}

/// One lane-assigned commit row (zanshin_graph::Row). Rows carry a COMMIT id,
/// never a change id (change ids are ambiguous for divergent changes).
///
/// `synthetic_elided` marks the synthetic "(elided revisions)" row the CLI
/// splices for an elided ancestor (`ui.log-synthetic-elided-nodes`): its
/// `commit_id` is the ELIDED TARGET's id, its lane fields are real, and `meta`
/// is ABSENT (Dart null — a nested table is the only shape flatc 25.12.19 lets
/// Dart see as null). On a commit row `meta` is always present.
///
/// Consequence: with synthetic elided rows ON (the default) `commit_id` is NOT
/// unique across rows — the synthetic row and the real commit it stands for
/// share it, and a child's GraphRowEdge.target names that id with no synthetic
/// marker. A synthetic row always sits IMMEDIATELY after the child that elided
/// to it, and `lane` / `target_lane` are the linkage. Do not use `commit_id`
/// alone as a row key.
table GraphRow {
  commit_id: string;               // commit id, hex
  lane: uint;                      // lane this commit was placed on
  color_idx: uint;                 // deterministic palette index, lane % PALETTE_SIZE
  edges: [GraphRowEdge];           // one per input parent edge, same order
  active_lanes: [GraphActiveLane]; // pass-through lanes, ascending; always present
  synthetic_elided: bool;
  meta: GraphRowMeta;              // absent iff synthetic_elided
}

/// A slice of the lane-assigned commit graph, in stream (`jj log`) order.
/// Return-all semantics (Story 4.4): total_rows == rows.length. Windowing is
/// deferred past WIP; if it lands later it may set total_rows > rows.length.
table GraphSlice {
  rows: [GraphRow];        // one per Row, stream order; always present (empty for an empty slice)
  total_rows: uint;        // == rows.length in WIP (see table doc)
}

union Payload {
  RepoHandle,
  Diagnostics,
  Status,
  Change,
  OpLog,
  Bookmarks,
  Remotes,
  RepoDetect,
  WatcherEvent,
  Progress,
  GraphSlice,
}

// ── Envelope ──────────────────────────────────────────────────────────────────

/// Root FlatBuffers type for every fallible FFI call that returns composite data.
///
/// ok == true  → data is set to the concrete Payload variant; error is absent.
/// ok == false → error is set (code + context); data is absent (Payload::NONE).
///
/// Dart reads the buffer via the generated typed accessors. It is released by
/// reclaiming the exact Rust allocation through one of two equivalent paths:
/// zanshin_buffer_free(ptr, len) for synchronous call sites, or the
/// NativeFinalizer-backed token path (zanshin_buffer_free_token) used by the
/// FfiBuffer wrapper as a belt-and-suspenders backstop
/// (see app/lib/src/ffi/ffi_buffer.dart).
table Envelope {
  ok: bool;
  error: FfiError;
  data: Payload;
}

root_type Envelope;
