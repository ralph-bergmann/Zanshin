# AI
_bmad/
# .claude/: track the shared parts (agents, hooks, skills, launch configs,
# project settings); settings.local.json, worktrees and runtime locks stay local.
.claude/*
!.claude/agents/
!.claude/hooks/
!.claude/skills/
!.claude/launch.json
!.claude/settings.json
.serena/

# Dart
.dart_tool/
build/

# IDE
*.iml
.idea/
.flutter-plugins
.flutter-plugins-dependencies
.mcp.json

# Rust
target/

# Swift (SwiftPM / SourceKit index builds, at any depth)
.build/

# Coverage: the instrumentation marker is transient (created/removed by
# `cargo make coverage`); never commit it. The committed ratchet baseline is
# coverage-baseline.txt (tracked on purpose).
coverage.on
