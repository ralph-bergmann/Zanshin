# BMad installed modules (regenerated by BMad installer)
_bmad/core/
_bmad/scripts/
_bmad/bmm/
_bmad/tea/

# BMad auto-generated manifests
_bmad/_config/

# BMad installer-managed config (regenerated on every install)
_bmad/config.toml

# Personal config (not for team sharing)
_bmad/config.user.toml
_bmad/custom/*.user.toml

# Claude Code BMad skills (installed by BMad, not project code)
.claude/skills/bmad-*/
.claude

# Rust
target/

# Dart / Flutter (app/ lands in Story 1.2)
app/build/
app/.dart_tool/
app/.flutter-plugins*
.dart_tool/

# Editor / OS
*.swp
.DS_Store
._*
