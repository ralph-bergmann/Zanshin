      {
        "selector": "JSXOpeningElement[name.name='BookmarkChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:synced|ahead|behind|local|remote|diverged)$/]",
        "message": "<BookmarkChip> state must be one of 'synced' | 'ahead' | 'behind' | 'local' | 'remote' | 'diverged'."
      },
      {
