{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/content/**",
              "components/forms/**",
              "components/graph/**",
              "components/menus/**",
              "components/overlays/**",
              "components/search/**",
              "components/settings/**",
              "components/surfaces/**",
              "components/window/**",
              "ui_kits/desktop/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Shippori Mincho))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Shippori Mincho."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<AtBadge> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<AtBadge> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|label|key|ref|className|style|children)$/]",
        "message": "<AtPill> doesn't accept that prop. Declared props: direction, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='AtPill'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:down|up|left|right)$/]",
        "message": "<AtPill> direction must be one of 'down' | 'up' | 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BookmarkChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|more|state|ahead|variant|title|key|ref|className|style|children)$/]",
        "message": "<BookmarkChip> doesn't accept that prop. Declared props: name, more, state, ahead, variant, title."
